{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Nuxt dev server (debug)",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "console": "integratedTerminal",
      "autoAttachChildProcesses": true
    }
  ]
}
