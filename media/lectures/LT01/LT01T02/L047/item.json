      "context": "/be̯aw/",
      "example": "beau"
    },
    "de": {
      "name": "eau in beau (ich trinke / sie trinken)",
      "description": "Dieses Element veranschaulicht den rumänischen Diphthong eau, wie er in der Verbform beau vorkommt.",
