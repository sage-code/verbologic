  "locales": {
    "en": {
      "name": "The Silent Depths of the Nautilus",
      "description": "Professor Aronnax and his companions survive a shipwreck and find themselves prisoners aboard Captain Nemo's mysterious, advanced submarine."
    },
    "ro": {
      "name": "Adâncurile tăcute ale Nautilusului",
      "description": "Profesorul Aronnax și însoțitorii săi supraviețuiesc unui naufragiu și devin prizonieri pe submarinul misterios al Căpitanului Nemo."
    },
    "de": {
      "name": "Die stillen Tiefen der Nautilus",
      "description": "Professor Aronnax und seine Gefährten überleben ein Schiffsunglück und werden Gefangene an Bord von Kapitän Nemos geheimnisvollem U-Boot."
    },
    "ru": {
      "name": "Безмолвные глубины «Наутилуса»",
      "description": "Профессор Ароннакс и его спутники выживают после кораблекрушения и оказываются пленниками на борту таинственной подводной лодки капитана Немо."
    },
    "it": {
      "name": "Le profondità silenziose del Nautilus",
      "description": "Il professor Aronnax e i suoi compagni sopravvivono a un naufragio e diventano prigionieri a bordo del misterioso sottomarino del Capitano Nemo."
    },
    "es": {
      "name": "Las profundidades silenciosas del Nautilus",
      "description": "El profesor Aronnax y sus compañeros sobreviven a un naufragio y se convierten en prisioneros a bordo del misterioso submarino del Capitán Nemo."
    },
    "fr": {
      "name": "Les profondeurs silencieuses du Nautilus",
      "description": "Le professeur Aronnax et ses compagnons survivent à un naufrage et deviennent prisonniers à bord du mystérieux sous-marin du Capitaine Nemo."
    },
    "hu": {
      "name": "A Nautilus néma mélységei",
      "description": "Aronnax professzor és társai túlélik a hajótörést, és Nemo kapitány titokzatos tengeralattjárójának foglyai lesznek."
    },
    "pt": {
      "name": "As profundezas silenciosas do Nautilus",
      "description": "O professor Aronnax e os seus companheiros sobrevivem a um naufrágio e tornam-se prisioneiros a bordo do misterioso submarino do Capitão Nemo."
    }
  },
