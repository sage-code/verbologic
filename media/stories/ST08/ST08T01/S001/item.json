  "locales": {
    "en": {
      "name": "The Long Road Home",
      "description": "Odysseus travels across the treacherous seas to return to his faithful wife Penelope after the long Trojan War."
    },
    "ro": {
      "name": "Drumul lung spre casă",
      "description": "Odiseu traversează mări periculoase pentru a se întoarce la soția sa credincioasă, Penelopa, după lungul război troian."
    },
    "de": {
      "name": "Der lange Weg nach Hause",
      "description": "Odysseus reist über tückische Meere, um nach dem langen Trojanischen Krieg zu seiner treuen Frau Penelope zurückzukehren."
    },
    "ru": {
      "name": "Долгий путь домой",
      "description": "Одиссей путешествует по опасным морям, чтобы вернуться к своей верной жене Пенелопе после долгой Троянской войны."
    },
    "it": {
      "name": "Il lungo viaggio verso casa",
      "description": "Odisseo attraversa mari insidiosi per tornare dalla sua fedele moglie Penelope dopo la lunga guerra di Troia."
    },
    "es": {
      "name": "El largo camino a casa",
      "description": "Odiseo viaja a través de mares traicioneros para regresar con su fiel esposa Penélope tras la larga guerra de Troya."
    },
    "fr": {
      "name": "Le long chemin du retour",
      "description": "Ulysse traverse des mers périlleuses pour retrouver sa fidèle épouse Pénélope après la longue guerre de Troie."
    },
    "hu": {
      "name": "A hosszú út hazafelé",
      "description": "Odüsszeusz veszélyes tengereken át utazik, hogy a hosszú trójai háború után visszatérjen hűséges feleségéhez, Pénelopéhoz."
    },
    "pt": {
      "name": "O longo caminho para casa",
      "description": "Odisseu viaja através de mares traiçoeiros para regressar à sua fiel esposa Penélope após a longa guerra de Troia."
    }
  },
