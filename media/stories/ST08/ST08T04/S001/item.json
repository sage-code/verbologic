  "locales": {
    "en": {
      "name": "The Iron Shield of Amara",
      "description": "Amara, a skilled tank driver, must protect her village's harvest from a sudden wildfire using her vehicle's capabilities."
    },
    "ro": {
      "name": "Scutul de fier al Amarei",
      "description": "Amara, o pricepută conducătoare de tanc, trebuie să salveze recolta satului ei de un incendiu devastator folosind vehiculul său."
    },
    "de": {
      "name": "Amaras eiserner Schild",
      "description": "Amara, eine geschickte Panzerfahrerin, muss die Ernte ihres Dorfes mit ihrem Fahrzeug vor einem plötzlichen Waldbrand schützen."
    },
    "ru": {
      "name": "Железный щит Амары",
      "description": "Амара, опытный водитель танка, должна защитить урожай своей деревни от внезапного лесного пожара, используя возможности своей машины."
    },
    "it": {
      "name": "Lo scudo di ferro di Amara",
      "description": "Amara, un'esperta pilota di carri armati, deve proteggere il raccolto del suo villaggio da un improvviso incendio boschivo usando il suo veicolo."
    },
    "es": {
      "name": "El escudo de hierro de Amara",
      "description": "Amara, una experta conductora de tanques, debe proteger la cosecha de su pueblo de un incendio forestal repentino usando las capacidades de su vehículo."
    },
    "fr": {
      "name": "Le bouclier de fer d'Amara",
      "description": "Amara, une conductrice de char expérimentée, doit protéger la récolte de son village d'un incendie soudain en utilisant les capacités de son véhicule."
    },
    "hu": {
      "name": "Amara vaspajzsa",
      "description": "Amara, egy ügyes harckocsivezető, a járműve képességeit felhasználva védi meg faluja termését egy hirtelen jött bozóttűztől."
    },
    "pt": {
      "name": "O escudo de ferro de Amara",
      "description": "Amara, uma experiente condutora de tanques, deve proteger a colheita da sua aldeia de um incêndio repentino usando as capacidades do seu veículo."
    }
  },
