  "locales": {
    "en": {
      "name": "Bruno Shares His Berries",
      "description": "Bruno the kind bear shares sweet berries with a hungry rabbit by the river."
    },
    "ro": {
      "name": "Bruno își împarte fructele de pădure",
      "description": "Bruno, ursul cel bun, împarte fructe dulci de pădure cu un iepuraș flămând lângă râu."
    },
    "de": {
      "name": "Bruno teilt seine Beeren",
      "description": "Bruno, der freundliche Bär, teilt süße Beeren mit einem hungrigen Kaninchen am Fluss."
    },
    "ru": {
      "name": "Бруно делится ягодами",
      "description": "Добрый медведь Бруно делится сладкими ягодами с голодным кроликом у реки."
    },
    "it": {
      "name": "Bruno condivide i suoi frutti di bosco",
      "description": "Bruno, l'orso gentile, condivide dolci frutti di bosco con un coniglio affamato vicino al fiume."
    },
    "es": {
      "name": "Bruno comparte sus bayas",
      "description": "Bruno, el oso amable, comparte bayas dulces con un conejo hambriento junto al río."
    },
    "fr": {
      "name": "Bruno partage ses baies",
      "description": "Bruno le gentil ours partage des baies sucrées avec un lapin affamé près de la rivière."
    },
    "hu": {
      "name": "Bruno megosztja a bogyóit",
      "description": "Bruno, a kedves medve, édes bogyókat oszt meg egy éhes nyuszival a folyó mellett."
    },
    "pt": {
      "name": "Bruno partilha as suas bagas",
      "description": "Bruno, o urso bondoso, partilha bagas doces com um coelho faminto perto do rio."
    }
  },
