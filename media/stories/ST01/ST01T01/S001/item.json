  "locales": {
    "en": {
      "name": "The Bear and the Mouse",
      "description": "A big bear helps a small trapped mouse, and they share sweet berries together in the forest."
    },
    "ro": {
      "name": "Ursul și șoarecele",
      "description": "Un urs mare ajută un mic șoarece blocat, iar ei împart fructe dulci împreună în pădure."
    },
    "de": {
      "name": "Der Bär und die Maus",
      "description": "Ein großer Bär hilft einer kleinen gefangenen Maus, und sie teilen süße Beeren zusammen im Wald."
    },
    "ru": {
      "name": "Медведь и мышонок",
      "description": "Большой медведь помогает маленькому мышонку в беде, и они вместе делят сладкие ягоды в лесу."
    },
    "it": {
      "name": "L'orso e il topo",
      "description": "Un grande orso aiuta un piccolo topo intrappolato e insieme condividono dolci bacche nel bosco."
    },
    "es": {
      "name": "El oso y el ratón",
      "description": "Un gran oso ayuda a un pequeño ratón atrapado, y juntos comparten bayas dulces en el bosque."
    },
    "fr": {
      "name": "L'ours et la souris",
      "description": "Un grand ours aide une petite souris coincée, et ils partagent des baies sucrées ensemble dans la forêt."
    },
    "hu": {
      "name": "A medve és az egér",
      "description": "Egy nagy medve segít egy kis csapdába esett egérnek, és édes bogyókat osztanak meg egymással az erdőben."
    },
    "pt": {
      "name": "O Urso e o Rato",
      "description": "Um urso grande ajuda um pequeno rato preso, e eles dividem frutas doces juntos na floresta."
    }
  },
