  "locales": {
    "en": {
      "name": "Jago and the Thorn",
      "description": "Jago the tiger has a thorn in his paw and learns to accept help from a small bird."
    },
    "ro": {
      "name": "Jago și ghimpele",
      "description": "Jago, un tigru mare, are un ghimpe în lăbuță și învață să accepte ajutorul unei păsărele."
    },
    "de": {
      "name": "Jago und der Dorn",
      "description": "Der Tiger Jago hat einen Dorn in der Pfote und lernt, Hilfe von einem kleinen Vogel anzunehmen."
    },
    "ru": {
      "name": "Яго и колючка",
      "description": "Тигр Яго поранил лапу колючкой и учится принимать помощь от маленькой птички."
    },
    "it": {
      "name": "Jago e la spina",
      "description": "Jago la tigre ha una spina nella zampa e impara ad accettare l'aiuto di un piccolo uccellino."
    },
    "es": {
      "name": "Jago y la espina",
      "description": "Jago el tigre tiene una espina en la pata y aprende a aceptar la ayuda de un pajarito."
    },
    "fr": {
      "name": "Jago et l'épine",
      "description": "Jago le tigre a une épine dans la patte et apprend à accepter l'aide d'un petit oiseau."
    },
    "hu": {
      "name": "Jago és a tüske",
      "description": "Jago, a tigris, tüskét kapott a mancsába, és megtanulja elfogadni egy kis madár segítségét."
    },
    "pt": {
      "name": "Jago e o espinho",
      "description": "Jago o tigre tem um espinho na pata e aprende a aceitar a ajuda de um pequeno pássaro."
    }
  },
