  "locales": {
    "en": {
      "name": "The Mouse and the Seed",
      "description": "Pip the little mouse finds a heavy seed and works with a friendly bird to bring it home."
    },
    "ro": {
      "name": "Șoarecele și sămânța",
      "description": "Pip, micul șoarece, găsește o sămânță grea și o aduce acasă cu o pasăre prietenoasă."
    },
    "de": {
      "name": "Die Maus und das Samenkorn",
      "description": "Pip die kleine Maus findet ein schweres Samenkorn und bringt es mit einem freundlichen Vogel nach Hause."
    },
    "ru": {
      "name": "Мышонок и семечко",
      "description": "Маленький мышонок Пип находит тяжёлое семечко и вместе с дружелюбной птичкой несёт его домой."
    },
    "it": {
      "name": "Il topo e il seme",
      "description": "Pip il topolino trova un seme pesante e lavora con un uccellino gentile per portarlo a casa."
    },
    "es": {
      "name": "El ratón y la semilla",
      "description": "Pip el pequeño ratón encuentra una semilla pesada y trabaja con un pájaro amigable para llevarla a casa."
    },
    "fr": {
      "name": "La souris et la graine",
      "description": "Pip la petite souris trouve une graine lourde et s'associe avec un gentil oiseau pour la rapporter chez elle."
    },
    "hu": {
      "name": "Az egér és a mag",
      "description": "Pip, a kis egér talál egy nehéz magot, és egy barátságos madárral együtt hazaviszi."
    },
    "pt": {
      "name": "O rato e a semente",
      "description": "Pip, o pequeno rato, encontra uma semente pesada e trabalha com um pássaro amigo para levá-la para casa."
    }
  },
