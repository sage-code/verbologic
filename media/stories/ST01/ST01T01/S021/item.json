  "locales": {
    "en": {
      "name": "Sammy and the Heavy Nut",
      "description": "Sammy the squirrel finds a heavy nut, and his friend Ben the rabbit helps him move it home."
    },
    "ro": {
      "name": "Sammy și nuca grea",
      "description": "Veverița Sammy găsește o nucă grea, iar prietenul său, iepurele Ben, îl ajută să o ducă acasă."
    },
    "de": {
      "name": "Sammy und die schwere Nuss",
      "description": "Das Eichhörnchen Sammy findet eine schwere Nuss, und sein Freund, das Kaninchen Ben, hilft ihm, sie nach Hause zu bringen."
    },
    "ru": {
      "name": "Сэмми и тяжёлый орех",
      "description": "Белка Сэмми находит тяжёлый орех, и его друг кролик Бен помогает ему донести его домой."
    },
    "it": {
      "name": "Sammy e la noce pesante",
      "description": "Lo scoiattolo Sammy trova una noce pesante e il suo amico, il coniglio Ben, lo aiuta a portarla a casa."
    },
    "es": {
      "name": "Sammy y la nuez pesada",
      "description": "La ardilla Sammy encuentra una nuez pesada y su amigo, el conejo Ben, le ayuda a llevarla a casa."
    },
    "fr": {
      "name": "Sammy et la noix lourde",
      "description": "L'écureuil Sammy trouve une noix lourde, et son ami le lapin Ben l'aide à la ramener chez lui."
    },
    "hu": {
      "name": "Sammy és a nehéz dió",
      "description": "Sammy, a mókus talál egy nehéz diót, és barátja, Ben, a nyúl segít neki hazavinni."
    },
    "pt": {
      "name": "Sammy e a noz pesada",
      "description": "O esquilo Sammy encontra uma noz pesada, e o seu amigo Ben, o coelho, ajuda-o a levá-la para casa."
    }
  },
