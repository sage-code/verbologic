  "locales": {
    "en": {
      "name": "Kibo and the Yellow Flower",
      "description": "Kibo the elephant helps his small friend Pip, a little grey mongoose, get a flower from the river."
    },
    "ro": {
      "name": "Kibo și floarea galbenă",
      "description": "Elefantul Kibo își ajută micul prieten Pip, o mică mangustă gri, să ia o floare din râu."
    },
    "de": {
      "name": "Kibo und die gelbe Blume",
      "description": "Kibo der Elefant hilft seinem kleinen Freund Pip, einem kleinen grauen Mungo, eine Blume aus dem Fluss zu holen."
    },
    "ru": {
      "name": "Кибо и жёлтый цветок",
      "description": "Слон Кибо помогает своему маленькому другу Пипу, серому мангусту, достать цветок из реки."
    },
    "it": {
      "name": "Kibo e il fiore giallo",
      "description": "L'elefante Kibo aiuta il suo piccolo amico Pip, una piccola mangusta grigia, a prendere un fiore dal fiume."
    },
    "es": {
      "name": "Kibo y la flor amarilla",
      "description": "Kibo el elefante ayuda a su pequeño amigo Pip, una pequeña mangosta gris, a sacar una flor del río."
    },
    "fr": {
      "name": "Kibo et la fleur jaune",
      "description": "Kibo l'éléphant aide son petit ami Pip, une petite mangouste grise, à attraper une fleur dans la rivière."
    },
    "hu": {
      "name": "Kibo és a sárga virág",
      "description": "Kibo, az elefánt segít kis barátjának, Pipnek, a kis szürke mongúznak, kivenni egy virágot a folyóból."
    },
    "pt": {
      "name": "Kibo e a Flor Amarela",
      "description": "O elefante Kibo ajuda seu pequeno amigo Pip, um pequeno mangusto cinzento, a pegar uma flor no rio."
    }
  },
