  "locales": {
    "en": {
      "name": "The Apple and the Box",
      "description": "Pip the rabbit wants a high apple, and his friend Max the hedgehog helps him reach it."
    },
    "ro": {
      "name": "Mărul și cutia",
      "description": "Iepurele Pip vrea un măr de sus, iar prietenul lui, ariciul Max, îl ajută să ajungă la el."
    },
    "de": {
      "name": "Der Apfel und die Kiste",
      "description": "Pip das Kaninchen möchte einen hohen Apfel, und sein Freund Max der Igel hilft ihm, ihn zu erreichen."
    },
    "ru": {
      "name": "Яблоко и ящик",
      "description": "Кролик Пип хочет достать яблоко, которое висит высоко, а его друг ёжик Макс помогает ему."
    },
    "it": {
      "name": "La mela e la scatola",
      "description": "Il coniglio Pip vuole una mela in alto e il suo amico Max il riccio lo aiuta a prenderla."
    },
    "es": {
      "name": "La manzana y la caja",
      "description": "El conejo Pip quiere una manzana que está alta y su amigo el erizo Max le ayuda a alcanzarla."
    },
    "fr": {
      "name": "La pomme et la boîte",
      "description": "Pip le lapin veut une pomme placée haut, et son ami Max le hérisson l'aide à l'attraper."
    },
    "hu": {
      "name": "Az alma és a doboz",
      "description": "Pip, a nyuszi szeretne egy magasan lévő almát, és a barátja, Max, a süni segít elérni azt."
    },
    "pt": {
      "name": "A maçã e a caixa",
      "description": "O coelho Pip quer uma maçã que está no alto, e o seu amigo Max, o ouriço, ajuda-o a alcançá-la."
    }
  },
