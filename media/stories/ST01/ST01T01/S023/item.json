  "locales": {
    "en": {
      "name": "Paco the Parrot",
      "description": "Paco the parrot copies everyone until his mimicry warns the other jungle animals of a coming danger."
    },
    "ro": {
      "name": "Paco papagalul",
      "description": "Paco papagalul repetă tot ce aude, până când vocea lui salvează animalele din junglă de un pericol."
    },
    "de": {
      "name": "Paco der Papagei",
      "description": "Paco der Papagei plappert alles nach, bis er mit seiner Stimme die Tiere im Dschungel vor einer Gefahr warnt."
    },
    "ru": {
      "name": "Попугай Пако",
      "description": "Попугай Пако повторяет всё за другими, пока его голос не спасает зверей в джунглях от опасности."
    },
    "it": {
      "name": "Paco il pappagallo",
      "description": "Paco il pappagallo imita tutti, finché la sua voce non avverte gli animali della giungla di un pericolo."
    },
    "es": {
      "name": "Paco el loro",
      "description": "Paco el loro imita a todos, hasta que su voz advierte a los animales de la selva de un peligro."
    },
    "fr": {
      "name": "Paco le perroquet",
      "description": "Paco le perroquet répète tout ce qu'il entend, jusqu'à ce que sa voix sauve les animaux de la jungle d'un danger."
    },
    "hu": {
      "name": "Paco a papagáj",
      "description": "Paco a papagáj mindenkit utánoz, míg a hangja meg nem menti a dzsungel állatait egy veszélytől."
    },
    "pt": {
      "name": "Paco o papagaio",
      "description": "Paco o papagaio imita todos, até que a sua voz avisa os animais da selva de um perigo."
    }
  },
