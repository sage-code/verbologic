  "locales": {
    "en": {
      "name": "Toby and the Warm Leaves",
      "description": "Toby the hedgehog finds soft leaves and helps a cold little mouse make a warm bed."
    },
    "ro": {
      "name": "Toby și frunzele calde",
      "description": "Ariciul Toby găsește frunze moi și ajută o șoricioaică înghețată să facă un pat cald."
    },
    "de": {
      "name": "Toby und die warmen Blätter",
      "description": "Toby der Igel findet weiche Blätter und hilft einer frierenden kleinen Maus, ein warmes Bett zu bauen."
    },
    "ru": {
      "name": "Тоби и тёплые листья",
      "description": "Ёжик Тоби находит мягкие листья и помогает замёрзшей маленькой мышке сделать тёплую постель."
    },
    "it": {
      "name": "Toby e le foglie calde",
      "description": "Toby il riccio trova foglie morbide e aiuta una topolina infreddolita a fare un letto caldo."
    },
    "es": {
      "name": "Toby y las hojas cálidas",
      "description": "Toby el erizo encuentra hojas suaves y ayuda a una ratoncita con frío a hacer una cama cálida."
    },
    "fr": {
      "name": "Toby et les feuilles chaudes",
      "description": "Toby le hérisson trouve des feuilles douces et aide une petite souris qui a froid à faire un lit chaud."
    },
    "hu": {
      "name": "Toby és a meleg levelek",
      "description": "Toby, a sün, puha leveleket talál, és segít egy fázó kisegérnek meleg ágyat készíteni."
    },
    "pt": {
      "name": "Toby e as folhas quentes",
      "description": "Toby, o ouriço, encontra folhas macias e ajuda uma ratinha com frio a fazer uma cama quente."
    }
  },
