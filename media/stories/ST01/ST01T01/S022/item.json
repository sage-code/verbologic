  "locales": {
    "en": {
      "name": "Toby and the Warm Leaves",
      "description": "Toby the hedgehog finds soft leaves and helps a cold little mouse make a warm bed."
    },
    "ro": {
      "name": "Toby și frunzele calde",
      "description": "Ariciul Toby găsește frunze moi și ajută un șoricel înghețat să își facă un pat cald."
    },
    "de": {
      "name": "Toby und die warmen Blätter",
      "description": "Der Igel Toby findet weiche Blätter und hilft einer frierenden kleinen Maus, ein warmes Bett zu bauen."
    },
    "ru": {
      "name": "Тоби и тёплые листья",
      "description": "Ёжик Тоби находит мягкие листья и помогает замёрзшей маленькой мышке сделать тёплую постель."
    },
    "it": {
      "name": "Toby e le foglie calde",
      "description": "Il riccio Toby trova foglie morbide e aiuta una topolina infreddolita a preparare un letto caldo."
    },
    "es": {
      "name": "Toby y las hojas cálidas",
      "description": "El erizo Toby encuentra hojas suaves y ayuda a una pequeña ratoncita con frío a hacer una cama cálida."
    },
    "fr": {
      "name": "Toby et les feuilles chaudes",
      "description": "Le hérisson Toby trouve des feuilles douces et aide une petite souris frileuse à faire un lit chaud."
    },
    "hu": {
      "name": "Toby és a meleg levelek",
      "description": "Toby, a sün puha leveleket talál, és segít egy fázó kisegérnek meleg ágyat készíteni."
    },
    "pt": {
      "name": "Toby e as folhas quentes",
      "description": "O ouriço Toby encontra folhas macias e ajuda uma ratinha com frio a fazer uma cama quentinha."
    }
  },
