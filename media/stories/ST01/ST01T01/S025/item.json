  "locales": {
    "en": {
      "name": "The Donkey and the Trick",
      "description": "A grey donkey learns that cheating does not help when his load becomes heavy again."
    },
    "ro": {
      "name": "Măgărușul și șiretlicul",
      "description": "Un măgăruș gri învață că păcăleala nu ajută când povara devine din nou grea."
    },
    "de": {
      "name": "Der Esel und der Trick",
      "description": "Ein grauer Esel lernt, dass Betrug nicht hilft, wenn die Last wieder schwer wird."
    },
    "ru": {
      "name": "Ослик и хитрость",
      "description": "Серый ослик понимает, что обман не помогает, когда груз снова становится тяжелым."
    },
    "it": {
      "name": "L'asino e l'inganno",
      "description": "Un asino grigio impara che imbrogliare non serve quando il carico torna pesante."
    },
    "es": {
      "name": "El burro y el truco",
      "description": "Un burro gris aprende que hacer trampas no ayuda cuando la carga vuelve a ser pesada."
    },
    "fr": {
      "name": "L'âne et l'astuce",
      "description": "Un âne gris apprend que tricher ne sert à rien quand la charge redevient lourde."
    },
    "hu": {
      "name": "A szamár és a trükk",
      "description": "Egy szürke szamár megtanulja, hogy a csalás nem segít, ha a teher újra nehéz lesz."
    },
    "pt": {
      "name": "O burro e o truque",
      "description": "Um burro cinzento aprende que enganar não ajuda quando a carga volta a ficar pesada."
    }
  },
