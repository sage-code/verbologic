  "locales": {
    "en": {
      "name": "The Apple Tree",
      "description": "A tall deer cannot reach a red apple high in a tree, so a small squirrel climbs up and helps him."
    },
    "ro": {
      "name": "Mărul din copac",
      "description": "Un cerb înalt nu ajunge la un măr roșu, așa că o veveriță mică îl ajută."
    },
    "de": {
      "name": "Der Apfelbaum",
      "description": "Ein großer Hirsch erreicht einen roten Apfel nicht, deshalb hilft ihm ein kleines Eichhörnchen."
    },
    "ru": {
      "name": "Яблоня",
      "description": "Высокий олень не может достать красное яблоко, поэтому маленькая белка помогает ему."
    },
    "it": {
      "name": "Il melo",
      "description": "Un cervo alto non arriva a una mela rossa, così uno scoiattolo piccolo lo aiuta."
    },
    "es": {
      "name": "El manzano",
      "description": "Un ciervo alto no alcanza una manzana roja, así que una ardilla pequeña lo ayuda."
    },
    "fr": {
      "name": "Le pommier",
      "description": "Un grand cerf ne peut pas atteindre une pomme rouge, alors un petit écureuil l'aide."
    },
    "hu": {
      "name": "Az almafa",
      "description": "Egy magas szarvas nem éri el a piros almát, ezért egy kis mókus segít neki."
    },
    "pt": {
      "name": "A macieira",
      "description": "Um cervo alto não alcança uma maçã vermelha, então um esquilo pequeno o ajuda."
    }
  },
