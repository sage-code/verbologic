  "locales": {
    "en": {
      "name": "A Song for Mira",
      "description": "Mira the otter learns a song to help her friend fall asleep under the bright moon."
    },
    "ro": {
      "name": "Un cântec pentru Mira",
      "description": "Mira, vidra, învață un cântec pentru a-și ajuta prietena să adoarmă sub luna strălucitoare."
    },
    "de": {
      "name": "Ein Lied für Mira",
      "description": "Mira der Fischotter lernt ein Lied, um ihrer Freundin beim Einschlafen unter dem hellen Mond zu helfen."
    },
    "ru": {
      "name": "Песня для Миры",
      "description": "Мира, выдра, учит песню, чтобы помочь подруге уснуть под яркой луной."
    },
    "it": {
      "name": "Una canzone per Mira",
      "description": "Mira la lontra impara una canzone per aiutare la sua amica ad addormentarsi sotto la luna luminosa."
    },
    "es": {
      "name": "Una canción para Mira",
      "description": "Mira la nutria aprende una canción para ayudar a su amiga a dormir bajo la luna brillante."
    },
    "fr": {
      "name": "Une chanson pour Mira",
      "description": "Mira la loutre apprend une chanson pour aider son amie à s'endormir sous la lune brillante."
    },
    "hu": {
      "name": "Egy dal Mirának",
      "description": "Mira, a vidra, megtanul egy dalt, hogy segítsen barátjának elaludni a fényes hold alatt."
    },
    "pt": {
      "name": "Uma canção para Mira",
      "description": "Mira a lontra aprende uma canção para ajudar a sua amiga a adormecer sob a lua brilhante."
    }
