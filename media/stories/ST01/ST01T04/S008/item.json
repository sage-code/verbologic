  "locales": {
    "en": {
      "name": "Sweet Dreams, Bao",
      "description": "Bao the panda finds soft grass in the quiet forest and sleeps under the bright moon."
    },
    "ro": {
      "name": "Vise plăcute, Bao",
      "description": "Ursul panda Bao găsește iarbă moale în pădurea liniștită și doarme sub luna strălucitoare."
    },
    "de": {
      "name": "Süße Träume, Bao",
      "description": "Bao der Panda findet weiches Gras im ruhigen Wald und schläft unter dem hellen Mond."
    },
    "ru": {
      "name": "Сладких снов, Бао",
      "description": "Панда Бао находит мягкую траву в тихом лесу и спит под яркой луной."
    },
    "it": {
      "name": "Sogni d'oro, Bao",
      "description": "Il panda Bao trova l'erba morbida nella foresta silenziosa e dorme sotto la luna luminosa."
    },
    "es": {
      "name": "Dulces sueños, Bao",
      "description": "El panda Bao encuentra hierba suave en el bosque tranquilo y duerme bajo la luna brillante."
    },
    "fr": {
      "name": "Fais de beaux rêves, Bao",
      "description": "Le panda Bao trouve de l'herbe douce dans la forêt calme et dort sous la lune brillante."
    },
    "hu": {
      "name": "Szép álmokat, Bao!",
      "description": "Bao, a panda puha füvet talál a csendes erdőben, és a fényes hold alatt alszik."
    },
    "pt": {
      "name": "Bons Sonhos, Bao",
      "description": "O panda Bao encontra grama macia na floresta silenciosa e dorme sob a lua brilhante."
    }
  },
