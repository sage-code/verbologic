  "locales": {
    "en": {
      "name": "The Big Jump",
      "description": "Small ducklings hatch in a dark tree hole and learn to jump to their mother in the water."
    },
    "ro": {
      "name": "Marele salt",
      "description": "Patru boboci de rață ies din ou într-un copac și învață să sară la mama lor în lac."
    },
    "de": {
      "name": "Der große Sprung",
      "description": "Kleine Enten schlüpfen in einem Baumloch und lernen, zu ihrer Mutter ins Wasser zu springen."
    },
    "ru": {
      "name": "Большой прыжок",
      "description": "Маленькие утята вылупляются в дупле дерева и учатся прыгать к маме в воду."
    },
    "it": {
      "name": "Il grande salto",
      "description": "Dei piccoli anatroccoli nascono in un albero e imparano a saltare verso la mamma nel lago."
    },
    "es": {
      "name": "El gran salto",
      "description": "Unos patitos nacen en un árbol y aprenden a saltar hacia su madre en el agua."
    },
    "fr": {
      "name": "Le grand saut",
      "description": "Des petits canetons éclosent dans un arbre et apprennent à sauter vers leur maman dans l'eau."
    },
    "hu": {
      "name": "A nagy ugrás",
      "description": "Kiskacsák kelnek ki egy fa odvában, és megtanulják, hogyan ugorjanak az anyjukhoz a vízbe."
    },
    "pt": {
      "name": "O grande salto",
      "description": "Patinhos nascem numa árvore e aprendem a saltar para a mãe na água."
    }
  },
