  "locales": {
    "en": {
      "name": "Sleep Well, Milo",
      "description": "Milo the little penguin feels cold on the ice, but Mother Penguin has a warm place for him to sleep."
    },
    "ro": {
      "name": "Noapte bună, Milo",
      "description": "Micului pinguin Milo îi este frig pe gheață, dar Mama Pinguin are un loc cald unde el să doarmă."
    },
    "de": {
      "name": "Schlaf gut, Milo",
      "description": "Milo, der kleine Pinguin, friert auf dem Eis, aber Mama Pinguin hat einen warmen Platz zum Schlafen für ihn."
    },
    "ru": {
      "name": "Спокойной ночи, Мило",
      "description": "Маленькому пингвину Мило холодно на льду, но у Мамы Пингвина есть тёплое место для сна."
    },
    "it": {
      "name": "Dormi bene, Milo",
      "description": "Il piccolo pinguino Milo ha freddo sul ghiaccio, ma Mamma Pinguino ha un posto caldo per farlo dormire."
    },
    "es": {
      "name": "Duerme bien, Milo",
      "description": "El pequeño pingüino Milo tiene frío en el hielo, pero Mamá Pingüino tiene un lugar cálido para que duerma."
    },
    "fr": {
      "name": "Dors bien, Milo",
      "description": "Milo le petit manchot a froid sur la glace, mais Maman Manchot a un endroit chaud pour le faire dormir."
    },
    "hu": {
      "name": "Aludj jól, Milo",
      "description": "Milo, a kis pingvin fázik a jégen, de Pingvin mama meleg helyet készít neki az alváshoz."
    },
    "pt": {
      "name": "Durma bem, Milo",
      "description": "O pequeno pinguim Milo sente frio no gelo, mas a Mamãe Pinguim tem um lugar quentinho para ele dormir."
    }
  },
