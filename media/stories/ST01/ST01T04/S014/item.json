  "locales": {
    "en": {
      "name": "Flynn and the Star",
      "description": "Flynn the eagle learns to rest in his high nest as the stars begin to shine."
    },
    "ro": {
      "name": "Flynn și steaua",
      "description": "Vulturul Flynn învață să se odihnească în cuibul său înalt când stelele încep să strălucească."
    },
    "de": {
      "name": "Flynn und der Stern",
      "description": "Der Adler Flynn lernt, in seinem hohen Nest zu ruhen, während die Sterne leuchten."
    },
    "ru": {
      "name": "Флинн и звезда",
      "description": "Орёл Флинн учится отдыхать в своём высоком гнезде, когда начинают сиять звёзды."
    },
    "it": {
      "name": "Flynn e la stella",
      "description": "L'aquila Flynn impara a riposare nel suo nido alto mentre le stelle iniziano a brillare."
    },
    "es": {
      "name": "Flynn y la estrella",
      "description": "El águila Flynn aprende a descansar en su nido alto mientras las estrellas comienzan a brillar."
    },
    "fr": {
      "name": "Flynn et l'étoile",
      "description": "L'aigle Flynn apprend à se reposer dans son nid haut perché alors que les étoiles brillent."
    },
    "hu": {
      "name": "Flynn és a csillag",
      "description": "Flynn, a sas megtanul pihenni a magas fészkében, miközben a csillagok ragyogni kezdenek."
    },
    "pt": {
      "name": "Flynn e a estrela",
      "description": "A águia Flynn aprende a descansar no seu ninho alto enquanto as estrelas começam a brilhar."
    }
  },
