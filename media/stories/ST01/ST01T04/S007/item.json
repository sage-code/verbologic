  "locales": {
    "en": {
      "name": "Goodnight, Little Benny",
      "description": "Benny the koala feels cold at night, but Mother Koala gives him a warm hug so he can sleep."
    },
    "ro": {
      "name": "Noapte bună, micuțule Benny",
      "description": "Lui Benny, ursulețul koala, îi este frig noaptea, dar Mama Koala îi oferă o îmbrățișare caldă ca să poată dormi."
    },
    "de": {
      "name": "Gute Nacht, kleiner Benny",
      "description": "Dem Koala Benny ist nachts kalt, aber Mama Koala gibt ihm eine warme Umarmung, damit er schlafen kann."
    },
    "ru": {
      "name": "Спокойной ночи, маленький Бенни",
      "description": "Коале Бенни холодно ночью, но мама коала тепло обнимает его, чтобы он мог уснуть."
    },
    "it": {
      "name": "Buonanotte, piccolo Benny",
      "description": "Il koala Benny ha freddo di notte, ma Mamma Koala gli dà un caldo abbraccio per farlo dormire."
    },
    "es": {
      "name": "Buenas noches, pequeño Benny",
      "description": "El koala Benny tiene frío por la noche, pero Mamá Koala le da un abrazo cálido para que pueda dormir."
    },
    "fr": {
      "name": "Bonne nuit, petit Benny",
      "description": "Benny le koala a froid la nuit, mais Maman Koala lui fait un câlin chaud pour qu'il puisse dormir."
    },
    "hu": {
      "name": "Jó éjszakát, kis Benny",
      "description": "Benny, a koala fázik éjszaka, de Koala mama melegen megöleli, hogy tudjon aludni."
    },
    "pt": {
      "name": "Boa noite, pequeno Benny",
      "description": "O coala Benny sente frio à noite, mas a Mamãe Coala lhe dá um abraço quentinho para ele dormir."
    }
  },
