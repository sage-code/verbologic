  "locales": {
    "en": {
      "name": "Time to Sleep, Pip",
      "description": "Pip the zebra wants to sleep, but the bright moon shines until he rests his head on the soft ground."
    },
    "ro": {
      "name": "Timpul de culcare, Pip",
      "description": "Pip zebra vrea să doarmă, dar luna strălucitoare luminează până când el își așază capul pe pământul moale."
    },
    "de": {
      "name": "Zeit zum Schlafen, Pip",
      "description": "Pip das Zebra möchte schlafen, aber der helle Mond scheint, bis er seinen Kopf auf den weichen Boden legt."
    },
    "ru": {
      "name": "Пора спать, Пип",
      "description": "Зебра Пип хочет спать, но яркая луна светит, пока он не опустит голову на мягкую землю."
    },
    "it": {
      "name": "È ora di dormire, Pip",
      "description": "Pip la zebra vuole dormire, ma la luna luminosa brilla finché lui non posa la testa sulla terra morbida."
    },
    "es": {
      "name": "Hora de dormir, Pip",
      "description": "Pip la cebra quiere dormir, pero la luna brillante brilla hasta que apoya la cabeza en el suelo suave."
    },
    "fr": {
      "name": "L'heure de dormir, Pip",
      "description": "Pip le zèbre veut dormir, mais la lune brillante brille jusqu'à ce qu'il pose sa tête sur le sol doux."
    },
    "hu": {
      "name": "Itt az alvás ideje, Pip",
      "description": "Pip, a zebra aludni szeretne, de a fényes hold addig világít, amíg le nem hajtja a fejét a puha földre."
    },
    "pt": {
      "name": "Hora de Dormir, Pip",
      "description": "Pip, a zebra, quer dormir, mas a lua brilhante brilha até ele descansar a cabeça no chão macio."
    }
  },
