  "locales": {
    "en": {
      "name": "Bee's Busy Morning",
      "description": "A sleepy bee named Jas wakes up in a flower and rushes back to her hive to share her honey with her friends."
    },
    "ro": {
      "name": "Dimineața ocupată a albinuței Jas",
      "description": "O albinuță somnoroasă pe nume Jas se trezește într-o floare și zboară repede spre stup pentru a împărți mierea cu prietenii ei."
    },
    "de": {
      "name": "Jas' geschäftiger Morgen",
      "description": "Eine schläfrige Biene namens Jas wacht in einer Blume auf und eilt zu ihrem Bienenstock, um ihren Honig mit ihren Freunden zu teilen."
    },
    "ru": {
      "name": "Утро пчелки Джас",
      "description": "Сонная пчелка по имени Джас просыпается в цветке и спешит в улей, чтобы поделиться медом с друзьями."
    },
    "it": {
      "name": "La mattinata impegnata di Jas",
      "description": "Un'ape assonnata di nome Jas si sveglia in un fiore e corre al suo alveare per condividere il miele con i suoi amici."
    },
    "es": {
      "name": "La mañana ocupada de Jas",
      "description": "Una abeja somnolienta llamada Jas se despierta en una flor y vuela rápido a su colmena para compartir su miel con sus amigos."
    },
    "fr": {
      "name": "La matinée occupée de Jas",
      "description": "Une abeille endormie nommée Jas se réveille dans une fleur et se dépêche de rentrer à la ruche pour partager son miel avec ses amis."
    },
    "hu": {
      "name": "Jas mozgalmas reggele",
      "description": "Egy álmos méhecske, Jas, felébred egy virágban, és siet vissza a kaptárba, hogy megossza a mézét a barátaival."
    },
    "pt": {
      "name": "A manhã ocupada da Jas",
      "description": "Uma abelha sonolenta chamada Jas acorda numa flor e corre para a sua colmeia para partilhar o seu mel com os amigos."
    }
  },
