  "locales": {
    "en": {
      "name": "Ajax Finds Food",
      "description": "Ajax the eagle flies from his cliff nest to find food for his hungry chicks."
    },
    "ro": {
      "name": "Ajax caută mâncare",
      "description": "Vulturul Ajax zboară de la cuibul său de pe stâncă pentru a găsi mâncare pentru puii săi flămânzi."
    },
    "de": {
      "name": "Ajax sucht Futter",
      "description": "Der Adler Ajax fliegt von seinem Nest auf dem Felsen, um Futter für seine hungrigen Küken zu finden."
    },
    "ru": {
      "name": "Аякс ищет еду",
      "description": "Орел Аякс летит из своего гнезда на скале, чтобы найти еду для своих голодных птенцов."
    },
    "it": {
      "name": "Ajax cerca cibo",
      "description": "L'aquila Ajax vola dal suo nido sulla roccia per trovare cibo per i suoi piccoli affamati."
    },
    "es": {
      "name": "Ajax busca comida",
      "description": "El águila Ajax vuela desde su nido en el acantilado para buscar comida para sus polluelos hambrientos."
    },
    "fr": {
      "name": "Ajax cherche à manger",
      "description": "L'aigle Ajax vole depuis son nid sur la falaise pour trouver de la nourriture pour ses oisillons affamés."
    },
    "hu": {
      "name": "Ajax ételt keres",
      "description": "Ajax, a sas, elrepül a sziklán lévő fészkéből, hogy ételt találjon éhes fiókáinak."
    },
    "pt": {
      "name": "Ajax procura comida",
      "description": "A águia Ajax voa do seu ninho no penhasco para encontrar comida para os seus filhotes famintos."
    }
