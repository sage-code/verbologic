  "locales": {
    "en": {
      "name": "Tiny Wings in the Sun",
      "description": "A small ladybug named Lita wakes up on a leaf and flies into the bright blue sky."
    },
    "ro": {
      "name": "Aripi mici sub soare",
      "description": "O mică buburuză pe nume Lita se trezește pe o frunză și zboară spre cerul albastru."
    },
    "de": {
      "name": "Kleine Flügel in der Sonne",
      "description": "Ein kleiner Marienkäfer namens Lita wacht auf einem Blatt auf und fliegt in den hellblauen Himmel."
    },
    "ru": {
      "name": "Маленькие крылья на солнце",
      "description": "Маленькая божья коровка Лита просыпается на листе и летит в ярко-синее небо."
    },
    "it": {
      "name": "Ali piccole sotto il sole",
      "description": "Una piccola coccinella di nome Lita si sveglia su una foglia e vola nel cielo azzurro."
    },
    "es": {
      "name": "Alas pequeñas bajo el sol",
      "description": "Una pequeña mariquita llamada Lita se despierta en una hoja y vuela hacia el cielo azul."
    },
    "fr": {
      "name": "Petites ailes sous le soleil",
      "description": "Une petite coccinelle nommée Lita se réveille sur une feuille et s'envole dans le ciel bleu."
    },
    "hu": {
      "name": "Apró szárnyak a napon",
      "description": "Egy Lita nevű katicabogár felébred egy levélen, és elrepül a kék égbe."
    },
    "pt": {
      "name": "Pequenas asas ao sol",
      "description": "Uma pequena joaninha chamada Lita acorda numa folha e voa para o céu azul."
    }
  },
