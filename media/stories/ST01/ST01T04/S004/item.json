  "locales": {
    "en": {
      "name": "Kiki Jumps to Sleep",
      "description": "Little Kiki the kangaroo cannot stop jumping, but Mother kangaroo helps her rest under the stars."
    },
    "ro": {
      "name": "Kiki sare spre somn",
      "description": "Micuțul cangur Kiki nu se poate opri din sărit, dar mama cangur o ajută să se odihnească sub stele."
    },
    "de": {
      "name": "Kiki springt in den Schlaf",
      "description": "Das kleine Känguru Kiki kann nicht aufhören zu springen, aber Mama Känguru hilft ihr, unter den Sternen zu schlafen."
    },
    "ru": {
      "name": "Кики прыгает ко сну",
      "description": "Маленький кенгуру Кики не может перестать прыгать, но мама-кенгуру помогает ей уснуть под звёздами."
    },
    "it": {
      "name": "Kiki salta verso il sonno",
      "description": "La piccola canguro Kiki non riesce a smettere di saltare, ma mamma canguro la aiuta a riposare sotto le stelle."
    },
    "es": {
      "name": "Kiki salta para dormir",
      "description": "La pequeña canguro Kiki no puede parar de saltar, pero mamá canguro la ayuda a descansar bajo las estrellas."
    },
    "fr": {
      "name": "Kiki saute vers le sommeil",
      "description": "Le petit kangourou Kiki ne peut pas s'arrêter de sauter, mais maman kangourou l'aide à se reposer sous les étoiles."
    },
    "hu": {
      "name": "Kiki álomba ugrik",
      "description": "A kis kenguru, Kiki, nem bírja abbahagyni az ugrálást, de Kengurumama segít neki megpihenni a csillagok alatt."
    },
    "pt": {
      "name": "Kiki pula para dormir",
      "description": "A pequena canguru Kiki não consegue parar de pular, mas a mamãe canguru a ajuda a descansar sob as estrelas."
    }
  },
