  "locales": {
    "en": {
      "name": "Sleep for Nalu",
      "description": "Nalu the little blue whale listens to a soft song to help him sleep in the deep ocean."
    },
    "ro": {
      "name": "Somnul lui Nalu",
      "description": "Nalu, micuța balenă albastră, ascultă un cântec liniștit pentru a adormi în oceanul adânc."
    },
    "de": {
      "name": "Schlaf für Nalu",
      "description": "Nalu, der kleine Blauwal, hört ein sanftes Lied, um im tiefen Ozean einzuschlafen."
    },
    "ru": {
      "name": "Сон для Налу",
      "description": "Маленький синий кит Налу слушает тихую песню, чтобы уснуть в глубоком океане."
    },
    "it": {
      "name": "Il sonno di Nalu",
      "description": "Nalu, la piccola balena blu, ascolta una dolce canzone per dormire nell'oceano profondo."
    },
    "es": {
      "name": "Sueño para Nalu",
      "description": "Nalu, la pequeña ballena azul, escucha una canción suave para dormir en el océano profundo."
    },
    "fr": {
      "name": "Le sommeil de Nalu",
      "description": "Nalu, la petite baleine bleue, écoute une chanson douce pour dormir dans l'océan profond."
    },
    "hu": {
      "name": "Álom Nalu számára",
      "description": "Nalu, a kis kék bálna egy halk dalt hallgat, hogy elaludjon a mély óceánban."
    },
    "pt": {
      "name": "Sono para Nalu",
      "description": "Nalu, a pequena baleia azul, ouve uma canção suave para dormir no oceano profundo."
    }
  },
