    "en": {
      "name": "Kiki and the Sweet Berry",
      "description": "A kind parrot named Kiki finds a sweet berry and shares it with a hungry mouse in the garden."
    },
    "ro": {
      "name": "Kiki și bobița dulce",
      "description": "Un papagal bun numit Kiki găsește o boabă dulce și o împarte cu un șoricel flămând în grădină."
    },
    "de": {
      "name": "Kiki und die süße Beere",
      "description": "Ein lieber Papagei namens Kiki findet eine süße Beere und teilt sie mit einer hungrigen Maus im Garten."
    },
    "ru": {
      "name": "Кики и сладкая ягода",
      "description": "Добрый попугай по имени Кики находит сладкую ягоду и делится ею с голодной мышкой в саду."
    },
    "it": {
      "name": "Kiki e la bacca dolce",
      "description": "Un pappagallo gentile di nome Kiki trova una bacca dolce e la condivide con un topo affamato nel giardino."
    },
    "es": {
      "name": "Kiki y la baya dulce",
      "description": "Un loro amable llamado Kiki encuentra una baya dulce y la comparte con un ratón hambriento en el jardín."
    },
    "fr": {
      "name": "Kiki et la baie sucrée",
      "description": "Un gentil perroquet nommé Kiki trouve une baie sucrée et la partage avec une souris affamée dans le jardin."
    },
    "hu": {
      "name": "Kiki és az édes bogyó",
      "description": "Egy kedves papagáj, Kiki talál egy édes bogyót, és megosztja egy éhes egérrel a kertben."
    },
    "pt": {
      "name": "Kiki e a baga doce",
      "description": "Um papagaio gentil chamado Kiki encontra uma baga doce e divide com um rato faminto no jardim."
    }
  },
