      "name": "Rusty canta de nuevo",
      "description": "El gallo Rusty pierde la voz, pero la vaca Daisy le ayuda a cantar de nuevo."
    },
    "fr": {
      "name": "Rusty chante à nouveau",
      "description": "Le coq Rusty perd sa voix, mais la vache Daisy l'aide à chanter à nouveau."
    },
    "hu": {
      "name": "Rusty újra énekel",
      "description": "Rusty, a kakas elveszíti a hangját, de Daisy, a tehén segít neki újra énekelni."
    },
    "pt": {
      "name": "Rusty canta de novo",
      "description": "O galo Rusty perde a voz, mas a vaca Daisy ajuda-o a cantar de novo."
    }
