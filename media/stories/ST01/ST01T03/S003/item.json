    "en": {
      "name": "Rusty Sings Again",
      "description": "Rusty the rooster loses his voice, but a kind friend helps him sing again."
    },
    "ro": {
      "name": "Rusty cântă din nou",
      "description": "Cocoșul Rusty își pierde vocea, dar o prietenă bună îl ajută să cânte din nou."
    },
    "de": {
      "name": "Rusty singt wieder",
      "description": "Rusty der Hahn verliert seine Stimme, aber eine liebe Freundin hilft ihm, wieder zu singen."
    },
    "ru": {
      "name": "Расти снова поёт",
      "description": "Петух Расти теряет голос, но добрая подруга помогает ему снова запеть."
    },
    "it": {
      "name": "Rusty canta di nuovo",
      "description": "Il gallo Rusty perde la voce, ma una cara amica lo aiuta a cantare di nuovo."
    },
