  "locales": {
    "en": {
      "name": "Rusty Sings Again",
      "description": "Toby brings water for all the farm animals, and Rusty drinks first and then sings much louder."
    },
    "ro": {
      "name": "Rusty cântă din nou",
      "description": "Toby aduce apă pentru animalele de la fermă, iar Rusty bea primul și apoi cântă mult mai tare."
    },
    "de": {
      "name": "Rusty singt wieder",
      "description": "Toby bringt Wasser für alle Tiere auf dem Bauernhof, Rusty trinkt zuerst und singt dann viel lauter."
    },
    "ru": {
      "name": "Расти снова поет",
      "description": "Тоби приносит воду для всех животных на ферме, Расти пьет первым и поет громче."
    },
    "it": {
      "name": "Rusty canta di nuovo",
      "description": "Toby porta l'acqua per tutti gli animali della fattoria, Rusty beve per primo e poi canta molto più forte."
    },
    "es": {
      "name": "Rusty canta de nuevo",
      "description": "Toby trae agua para todos los animales de la granja, Rusty bebe primero y luego canta mucho más fuerte."
    },
    "fr": {
      "name": "Rusty chante encore",
      "description": "Toby apporte de l'eau pour tous les animaux de la ferme, Rusty boit en premier et chante ensuite beaucoup plus fort."
    },
    "hu": {
      "name": "Rusty újra énekel",
      "description": "Toby vizet hoz a farm állatainak, Rusty iszik először, majd sokkal hangosabban énekel."
    },
    "pt": {
      "name": "Rusty canta de novo",
      "description": "Toby traz água para todos os animais da fazenda, Rusty bebe primeiro e depois canta muito mais alto."
    }
  },
