    "en": {
      "name": "Rusty Sings Again",
      "description": "Rusty the rooster loses his voice, but Daisy the cow helps him sing again."
    },
    "ro": {
      "name": "Rusty cântă din nou",
      "description": "Cocoșul Rusty își pierde vocea, dar vaca Daisy îl ajută să cânte din nou."
    },
    "de": {
      "name": "Rusty singt wieder",
      "description": "Der Hahn Rusty verliert seine Stimme, aber die Kuh Daisy hilft ihm, wieder zu singen."
    },
    "ru": {
      "name": "Расти снова поёт",
      "description": "Петух Расти теряет голос, но корова Дейзи помогает ему снова петь."
    },
    "it": {
      "name": "Rusty canta di nuovo",
      "description": "Il gallo Rusty perde la voce, ma la mucca Daisy lo aiuta a cantare di nuovo."
    },
