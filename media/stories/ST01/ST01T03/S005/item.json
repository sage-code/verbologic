  "locales": {
    "en": {
      "name": "Toby and the Yellow Flower",
      "description": "Toby the turtle wants a flower on a tall stone, and his frog friend helps him reach it."
    },
    "ro": {
      "name": "Toby și floarea galbenă",
      "description": "Broasca țestoasă Toby vrea o floare de pe o piatră înaltă, iar prietenul său broasca îl ajută să ajungă la ea."
    },
    "de": {
      "name": "Toby und die gelbe Blume",
      "description": "Toby die Schildkröte möchte eine Blume auf einem hohen Stein, und sein Freund der Frosch hilft ihm dabei."
    },
    "ru": {
      "name": "Тоби и жёлтый цветок",
      "description": "Черепаха Тоби хочет цветок на высоком камне, и его друг лягушонок помогает ему достать его."
    },
    "it": {
      "name": "Toby e il fiore giallo",
      "description": "La tartaruga Toby vuole un fiore su una pietra alta, e il suo amico rana lo aiuta a raggiungerlo."
    },
    "es": {
      "name": "Toby y la flor amarilla",
      "description": "La tortuga Toby quiere una flor sobre una piedra alta, y su amigo la rana le ayuda a alcanzarla."
    },
    "fr": {
      "name": "Toby et la fleur jaune",
      "description": "Toby la tortue veut une fleur sur une haute pierre, et son ami la grenouille l'aide à l'attraper."
    },
    "hu": {
      "name": "Toby és a sárga virág",
      "description": "Toby, a teknős, egy magas kövön lévő virágot szeretne, és a béka barátja segít neki elérni."
    },
    "pt": {
      "name": "Toby e a Flor Amarela",
      "description": "Toby, a tartaruga, quer uma flor em cima de uma pedra alta, e o seu amigo sapo ajuda-o a alcançá-la."
    }
  },
