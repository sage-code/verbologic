  "locales": {
    "en": {
      "name": "Pip and the Flower",
      "description": "Pip the goose drops his yellow flower in the pond, but a kind duck helps him."
    },
    "ro": {
      "name": "Pip și floarea",
      "description": "Pip, gânsacul, scapă floarea lui galbenă în iaz, dar o rață bună îl ajută."
    },
    "de": {
      "name": "Pip und die Blume",
      "description": "Pip die Gans lässt seine gelbe Blume in den Teich fallen, aber eine freundliche Ente hilft ihm."
    },
    "ru": {
      "name": "Пип и цветок",
      "description": "Гусь Пип роняет свой жёлтый цветок в пруд, но добрая утка помогает ему."
    },
    "it": {
      "name": "Pip e il fiore",
      "description": "Pip l'oca fa cadere il suo fiore giallo nello stagno, ma una buona anatra lo aiuta."
    },
    "es": {
      "name": "Pip y la flor",
      "description": "Pip el ganso deja caer su flor amarilla en el estanque, pero un pato amable lo ayuda."
    },
    "fr": {
      "name": "Pip et la fleur",
      "description": "Pip l'oie fait tomber sa fleur jaune dans la mare, mais un canard gentil l'aide."
    },
    "hu": {
      "name": "Pip és a virág",
      "description": "Pip, a lúd beleejti a sárga virágát a tóba, de egy kedves kacsa segít neki."
    },
    "pt": {
      "name": "Pip e a flor",
      "description": "Pip, o ganso, deixa cair sua flor amarela no lago, mas um pato bondoso o ajuda."
    }
  },
