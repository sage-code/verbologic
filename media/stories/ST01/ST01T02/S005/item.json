  "locales": {
    "en": {
      "name": "The Little Dragon",
      "description": "Anna, a young girl, helps a sad little dragon get his golden ball from a pond, and they become good friends."
    },
    "ro": {
      "name": "Micul dragon",
      "description": "Anna, o fetiță, ajută un mic dragon trist să își ia mingea de aur dintr-un iaz și devin buni prieteni."
    },
    "de": {
      "name": "Der kleine Drache",
      "description": "Anna, ein junges Mädchen, hilft einem traurigen kleinen Drachen, seinen goldenen Ball aus einem Teich zu holen, und sie werden gute Freunde."
    },
    "ru": {
      "name": "Маленький дракон",
      "description": "Анна, маленькая девочка, помогает грустному дракончику достать золотой мяч из пруда, и они становятся хорошими друзьями."
    },
    "it": {
      "name": "Il piccolo drago",
      "description": "Anna, una ragazzina, aiuta un piccolo drago triste a prendere la sua palla d'oro da uno stagno, e diventano buoni amici."
    },
    "es": {
      "name": "El pequeño dragón",
      "description": "Anna, una niña pequeña, ayuda a un pequeño dragón triste a sacar su pelota dorada de un estanque, y se hacen buenos amigos."
    },
    "fr": {
      "name": "Le petit dragon",
      "description": "Anna, une jeune fille, aide un petit dragon triste à récupérer sa balle dorée dans un étang, et ils deviennent de bons amis."
    },
    "hu": {
      "name": "A kis sárkány",
      "description": "Anna, egy fiatal lány, segít egy szomorú kis sárkánynak kiszedni az aranygolyóját a tóból, és jó barátok lesznek."
    },
    "pt": {
      "name": "O pequeno dragão",
      "description": "Anna, uma menina jovem, ajuda um pequeno dragão triste a pegar sua bola dourada de um lago, e eles se tornam bons amigos."
    }
  },
