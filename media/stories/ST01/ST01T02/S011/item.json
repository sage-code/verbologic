  "locales": {
    "en": {
      "name": "Penny and the Magic Seed",
      "description": "A little hen finds a magic seed, grows sweet bread, and shares it with her lazy friend."
    },
    "ro": {
      "name": "Penny și sămânța magică",
      "description": "O găină mică găsește o sămânță magică, crește pâine dulce și o împarte cu prietenul ei leneș."
    },
    "de": {
      "name": "Penny und der Zaubersamen",
      "description": "Eine kleine Henne findet einen Zaubersamen, pflanzt süßes Brot an und teilt es mit ihrem faulen Freund."
    },
    "ru": {
      "name": "Пенни и волшебное семечко",
      "description": "Маленькая курочка находит волшебное семечко, выращивает сладкий хлеб и делится им со своим ленивым другом."
    },
    "it": {
      "name": "Penny e il seme magico",
      "description": "Una piccola gallina trova un seme magico, coltiva pane dolce e lo condivide con il suo amico pigro."
    },
    "es": {
      "name": "Penny y la semilla mágica",
      "description": "Una gallina pequeña encuentra una semilla mágica, hace crecer pan dulce y lo comparte con su amigo perezoso."
    },
    "fr": {
      "name": "Penny et la graine magique",
      "description": "Une petite poule trouve une graine magique, fait pousser du pain sucré et le partage avec son ami paresseux."
    },
    "hu": {
      "name": "Penny és a varázsmag",
      "description": "Egy kis tyúk talál egy varázsmagot, édes kenyeret nevel, és megosztja lusta barátjával."
    },
    "pt": {
      "name": "Penny e a Semente Mágica",
      "description": "Uma galinha pequena encontra uma semente mágica, cultiva pão doce e partilha-o com o seu amigo preguiçoso."
    }
  },
