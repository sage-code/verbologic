  "locales": {
    "en": {
      "name": "The Fisherman and the Reed Boat",
      "description": "Enkidu, a Mesopotamian fisher, chooses to share his daily catch with the woman he loves rather than sell it for gold."
    },
    "ro": {
      "name": "Pescarul și barca de papură",
      "description": "Enkidu, un pescar din Mesopotamia, alege să împartă peștele prins cu femeia iubită în loc să-l vândă pentru aur."
    },
    "de": {
      "name": "Der Fischer und das Schilfboot",
      "description": "Enkidu, ein mesopotamischer Fischer, teilt seinen täglichen Fang lieber mit der Frau, die er liebt, als ihn für Gold zu verkaufen."
    },
    "ru": {
      "name": "Рыбак и тростниковая лодка",
      "description": "Энкиду, месопотамский рыбак, решает поделиться своим уловом с любимой женщиной, вместо того чтобы продать его за золото."
    },
    "it": {
      "name": "Il pescatore e la barca di giunchi",
      "description": "Enkidu, un pescatore mesopotamico, sceglie di condividere il suo pescato quotidiano con la donna che ama invece di venderlo per oro."
    },
    "es": {
      "name": "El pescador y la barca de juncos",
      "description": "Enkidu, un pescador mesopotámico, elige compartir su pesca diaria con la mujer que ama en lugar de venderla por oro."
    },
    "fr": {
      "name": "Le pêcheur et le bateau en roseaux",
      "description": "Enkidu, un pêcheur mésopotamien, choisit de partager sa pêche quotidienne avec la femme qu'il aime plutôt que de la vendre pour de l'or."
    },
    "hu": {
      "name": "A halász és a nádi csónak",
      "description": "Enkidu, egy mezopotámiai halász, inkább megosztja napi zsákmányát a szeretett nővel, mintsem eladja azt aranyért."
    },
    "pt": {
      "name": "O pescador e o barco de juncos",
      "description": "Enkidu, um pescador mesopotâmico, escolhe partilhar a sua pesca diária com a mulher que ama em vez de a vender por ouro."
    }
  },
