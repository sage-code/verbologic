  "locales": {
    "en": {
      "name": "The Aviator of the Nile",
      "description": "Nebet, a Bronze Age Nile aviator, uses his glider to help his community during the annual flood."
    },
    "ro": {
      "name": "Aviatorul de pe Nil",
      "description": "Nebet, un aviator din epoca bronzului, își folosește planorul pentru a-și ajuta comunitatea în timpul inundațiilor anuale ale Nilului."
    },
    "de": {
      "name": "Der Flieger vom Nil",
      "description": "Nebet, ein Flieger aus der Bronzezeit, hilft seinem Dorf mit seinem Gleiter während der jährlichen Nilflut."
    },
    "ru": {
      "name": "Авиатор Нила",
      "description": "Небет, авиатор бронзового века, использует свой планер, чтобы помочь своей общине во время ежегодного разлива Нила."
    },
    "it": {
      "name": "L'aviatore del Nilo",
      "description": "Nebet, un aviatore dell'età del bronzo, usa il suo aliante per aiutare la sua comunità durante l'inondazione annuale del Nilo."
    },
    "es": {
      "name": "El aviador del Nilo",
      "description": "Nebet, un aviador de la Edad del Bronce, usa su planeador para ayudar a su comunidad durante la inundación anual del Nilo."
    },
    "fr": {
      "name": "L'aviateur du Nil",
      "description": "Nebet, un aviateur de l'âge du bronze, utilise son planeur pour aider sa communauté pendant l'inondation annuelle du Nil."
    },
    "hu": {
      "name": "A Nílus pilótája",
      "description": "Nebet, a bronzkori pilóta, a vitorlázórepülőjével segít a közösségének a Nílus éves áradása idején."
    },
    "pt": {
      "name": "O Aviador do Nilo",
      "description": "Nebet, um aviador da Idade do Bronze, usa o seu planador para ajudar a sua comunidade durante a inundação anual do Nilo."
    }
  },
