  "locales": {
    "en": {
      "name": "Letters from the Sea",
      "description": "A cargo ship captain writes letters to her daughter about life at sea and her promise to return home."
    },
    "ro": {
      "name": "Scrisori de pe mare",
      "description": "Căpitanul unui cargobot îi scrie fiicei sale despre viața pe mare și îi promite că se va întoarce acasă."
    },
    "de": {
      "name": "Briefe vom Meer",
      "description": "Eine Frachtschiffkapitänin schreibt ihrer Tochter Briefe über das Leben auf See und verspricht, bald nach Hause zurückzukehren."
    },
    "ru": {
      "name": "Письма с моря",
      "description": "Капитан грузового судна пишет письма своей дочери о жизни в море и обещает вернуться домой."
    },
    "it": {
      "name": "Lettere dal mare",
      "description": "Il capitano di una nave mercantile scrive lettere a sua figlia sulla vita in mare e le promette di tornare a casa."
    },
    "es": {
      "name": "Cartas desde el mar",
      "description": "La capitana de un barco de carga escribe cartas a su hija sobre la vida en el mar y le promete volver a casa."
    },
    "fr": {
      "name": "Lettres de la mer",
      "description": "La capitaine d'un cargo écrit des lettres à sa fille sur la vie en mer et lui promet de rentrer à la maison."
    },
    "hu": {
      "name": "Levelek a tengerről",
      "description": "Egy teherhajó kapitánya leveleket ír lányának a tengeri életről, és megígéri, hogy hazatér."
    },
    "pt": {
      "name": "Cartas do mar",
      "description": "A capitã de um navio de carga escreve cartas à sua filha sobre a vida no mar e promete voltar para casa."
    }
  },
