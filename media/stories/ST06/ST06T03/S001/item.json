  "locales": {
    "en": {
      "name": "The Strength of the Stone",
      "description": "A young bricklayer learns that pride in her work requires correcting her mistakes to ensure the wall stands straight and strong."
    },
    "ro": {
      "name": "Puterea pietrei",
      "description": "O tânără zidară învață că mândria în munca ei înseamnă să-și corecteze greșelile pentru a construi un zid trainic."
    },
    "de": {
      "name": "Die Kraft des Steins",
      "description": "Eine junge Maurerin lernt, dass man Fehler korrigieren muss, damit eine Mauer stabil und stark wird."
    },
    "ru": {
      "name": "Сила камня",
      "description": "Молодая каменщица понимает, что гордость за свою работу требует исправления ошибок, чтобы стена была прочной."
    },
    "it": {
      "name": "La forza della pietra",
      "description": "Una giovane muratrice impara che l'orgoglio per il proprio lavoro richiede di correggere gli errori per garantire che il muro sia dritto e forte."
    },
    "es": {
      "name": "La fuerza de la piedra",
      "description": "Una joven albañil aprende que el orgullo por su trabajo requiere corregir sus errores para asegurar que el muro sea recto y fuerte."
    },
    "fr": {
      "name": "La force de la pierre",
      "description": "Une jeune maçonne apprend que la fierté dans son travail exige de corriger ses erreurs pour que le mur soit droit et solide."
    },
    "hu": {
      "name": "A kő ereje",
      "description": "Egy fiatal kőműves lány megtanulja, hogy a munkájára való büszkeség azt jelenti, hogy ki kell javítania a hibáit, hogy a fal egyenes és erős legyen."
    },
    "pt": {
      "name": "A força da pedra",
      "description": "Uma jovem pedreira aprende que o orgulho no seu trabalho exige corrigir os seus erros para garantir que a parede fique reta e forte."
    }
  },
