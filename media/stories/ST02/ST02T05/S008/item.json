    "en": {
      "name": "The Christmas Tree Hunt",
      "description": "Two children and their father go to the forest to find and decorate a perfect Christmas tree."
    },
    "ro": {
      "name": "Căutarea bradului de Crăciun",
      "description": "Doi copii și tatăl lor merg în pădure pentru a găsi și a împodobi un brad de Crăciun perfect."
    },
    "de": {
      "name": "Die Suche nach dem Weihnachtsbaum",
      "description": "Zwei Kinder und ihr Vater gehen in den Wald, um einen perfekten Weihnachtsbaum zu finden und zu schmücken."
    },
    "ru": {
      "name": "Поиск новогодней ёлки",
      "description": "Двое детей и их папа идут в лес, чтобы найти и украсить идеальную новогоднюю ёлку."
    },
    "it": {
      "name": "La caccia all'albero di Natale",
      "description": "Due bambini e il loro papà vanno nel bosco per trovare e decorare un perfetto albero di Natale."
    },
    "es": {
      "name": "La búsqueda del árbol de Navidad",
      "description": "Dos niños y su padre van al bosque para encontrar y decorar un árbol de Navidad perfecto."
    },
    "fr": {
      "name": "La chasse au sapin de Noël",
      "description": "Deux enfants et leur père vont dans la forêt pour trouver et décorer un sapin de Noël parfait."
    },
    "hu": {
      "name": "A karácsonyfa-vadászat",
      "description": "Két gyerek és az apukájuk elmennek az erdőbe, hogy megtalálják és feldíszítsék a tökéletes karácsonyfát."
    },
    "pt": {
      "name": "A caça à árvore de Natal",
      "description": "Duas crianças e o seu pai vão à floresta para encontrar e decorar uma árvore de Natal perfeita."
    }
  },
