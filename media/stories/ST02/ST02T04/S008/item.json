  "locales": {
    "en": {
      "name": "A Day in the Orchard",
      "description": "Tessa and her grandfather collect apples and chestnuts while watching forest animals prepare for the coming winter."
    },
    "ro": {
      "name": "O zi în livadă",
      "description": "Tessa și bunicul ei adună mere și castane în timp ce privesc animalele pădurii pregătindu-se pentru iarnă."
    },
    "de": {
      "name": "Ein Tag im Obstgarten",
      "description": "Tessa und ihr Großvater sammeln Äpfel und Kastanien und beobachten die Waldtiere bei der Vorbereitung auf den Winter."
    },
    "ru": {
      "name": "День в саду",
      "description": "Тесса и её дедушка собирают яблоки и каштаны, наблюдая, как лесные животные готовятся к зиме."
    },
    "it": {
      "name": "Una giornata nel frutteto",
      "description": "Tessa e il nonno raccolgono mele e castagne mentre osservano gli animali del bosco prepararsi per l'inverno."
    },
    "es": {
      "name": "Un día en el huerto",
      "description": "Tessa y su abuelo recogen manzanas y castañas mientras observan a los animales del bosque prepararse para el invierno."
    },
    "fr": {
      "name": "Une journée au verger",
      "description": "Tessa et son grand-père ramassent des pommes et des châtaignes en regardant les animaux de la forêt se préparer pour l'hiver."
    },
    "hu": {
      "name": "Egy nap a gyümölcsösben",
      "description": "Tessa és a nagyapja almát és gesztenyét gyűjtenek, miközben figyelik, ahogy az erdei állatok felkészülnek a télre."
    },
    "pt": {
      "name": "Um dia no pomar",
      "description": "Tessa e o seu avô colhem maçãs e castanhas enquanto observam os animais da floresta a prepararem-se para o inverno."
    }
  },
