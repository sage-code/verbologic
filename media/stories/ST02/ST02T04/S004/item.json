    "en": {
      "name": "Ilya and the Hot Summer Sun",
      "description": "Ilya the turtle finds a way to stay cool during a very hot summer day."
    },
    "ro": {
      "name": "Ilya și soarele fierbinte de vară",
      "description": "Ilya țestoasa găsește o cale să se răcorească într-o zi de vară foarte caldă."
    },
    "de": {
      "name": "Ilya und die heiße Sommersonne",
      "description": "Die Schildkröte Ilya findet einen Weg, um an einem sehr heißen Sommertag kühl zu bleiben."
    },
    "ru": {
      "name": "Илья и жаркое летнее солнце",
      "description": "Черепаха Илья находит способ охладиться в очень жаркий летний день."
    },
    "it": {
      "name": "Ilya e il caldo sole estivo",
      "description": "La tartaruga Ilya trova un modo per stare al fresco in una giornata estiva molto calda."
    },
    "es": {
      "name": "Ilya y el sol caliente del verano",
      "description": "La tortuga Ilya encuentra una forma de refrescarse durante un día de verano muy caluroso."
    },
    "fr": {
      "name": "Ilya et le chaud soleil d'été",
      "description": "La tortue Ilya trouve un moyen de rester au frais pendant une journée d'été très chaude."
    },
    "hu": {
      "name": "Ilya és a forró nyári nap",
