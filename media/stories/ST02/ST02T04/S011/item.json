  "locales": {
    "en": {
      "name": "Hope the Dove and Spring",
      "description": "Hope the white dove brings a green branch to a cold village, showing the children that spring is almost here."
    },
    "ro": {
      "name": "Speranța, porumbelul și primăvara",
      "description": "Speranța, un porumbel alb, aduce o ramură verde într-un sat înghețat, vestind copiilor venirea primăverii."
    },
    "de": {
      "name": "Hoffnung die Taube und der Frühling",
      "description": "Die weiße Taube Hoffnung bringt einen grünen Zweig in ein kaltes Dorf und zeigt den Kindern, dass der Frühling bald kommt."
    },
    "ru": {
      "name": "Голубка Надежда и весна",
      "description": "Белая голубка Надежда приносит зеленую веточку в холодную деревню, показывая детям, что весна уже близко."
    },
    "it": {
      "name": "Speranza la colomba e la primavera",
      "description": "La colomba bianca Speranza porta un ramo verde in un villaggio freddo, mostrando ai bambini che la primavera è quasi arrivata."
    },
    "es": {
      "name": "Esperanza la paloma y la primavera",
      "description": "La paloma blanca Esperanza trae una rama verde a un pueblo frío, mostrando a los niños que la primavera está cerca."
    },
    "fr": {
      "name": "Espérance la colombe et le printemps",
      "description": "La colombe blanche Espérance apporte une branche verte dans un village froid, montrant aux enfants que le printemps arrive bientôt."
    },
    "hu": {
      "name": "Remény a galamb és a tavasz",
      "description": "Remény, a fehér galamb egy zöld ágat hoz a hideg faluba, megmutatva a gyerekeknek, hogy közel a tavasz."
    },
    "pt": {
      "name": "Esperança a pomba e a primavera",
      "description": "A pomba branca Esperança traz um ramo verde para uma aldeia fria, mostrando às crianças que a primavera está quase a chegar."
    }
  },
