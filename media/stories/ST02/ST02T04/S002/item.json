  "locales": {
    "en": {
      "name": "Luna and the First Summer Rain",
      "description": "Luna the silver fox enjoys the first warm rain of summer with her friend Sam the squirrel."
    },
    "ro": {
      "name": "Luna și prima ploaie de vară",
      "description": "Luna, vulpea argintie, se bucură de prima ploaie caldă de vară alături de prietenul ei, veverița Sam."
    },
    "de": {
      "name": "Luna und der erste Sommerregen",
      "description": "Luna der Silberfuchs genießt den ersten warmen Sommerregen mit ihrem Freund Sam dem Eichhörnchen."
    },
    "ru": {
      "name": "Луна и первый летний дождь",
      "description": "Серебристая лисичка Луна радуется первому теплому летнему дождю вместе со своим другом, белкой Сэмом."
    },
    "it": {
      "name": "Luna e la prima pioggia d'estate",
      "description": "Luna la volpe argentata si gode la prima pioggia calda d'estate con il suo amico Sam lo scoiattolo."
    },
    "es": {
      "name": "Luna y la primera lluvia de verano",
      "description": "Luna la zorra plateada disfruta de la primera lluvia cálida del verano con su amigo Sam la ardilla."
    },
    "fr": {
      "name": "Luna et la première pluie d'été",
      "description": "Luna le renard argenté profite de la première pluie chaude de l'été avec son ami Sam l'écureuil."
    },
    "hu": {
      "name": "Luna és az első nyári eső",
      "description": "Luna, az ezüst róka élvezi az első meleg nyári esőt barátjával, Sam mókussal."
    },
    "pt": {
      "name": "Luna e a primeira chuva de verão",
      "description": "Luna a raposa prateada aproveita a primeira chuva quente de verão com seu amigo Sam o esquilo."
    }
  },
