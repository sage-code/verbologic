  "locales": {
    "en": {
      "name": "A Kind Gift in the Snow",
      "description": "Beni shares his bread with a hungry stray dog on Christmas Eve, and Santa rewards his kindness with a gift."
    },
    "ro": {
      "name": "Un dar bun în zăpadă",
      "description": "Beni împarte pâinea lui cu un câine flămând în Ajunul Crăciunului, iar Moș Crăciun îl răsplătește cu un cadou."
    },
    "de": {
      "name": "Ein liebes Geschenk im Schnee",
      "description": "Beni teilt sein Brot an Heiligabend mit einem hungrigen Hund, und der Weihnachtsmann bringt ihm ein Geschenk."
    },
    "ru": {
      "name": "Добрый подарок в снегу",
      "description": "Бени делится хлебом с голодной собакой в сочельник, и Дед Мороз дарит ему подарок за доброту."
    },
    "it": {
      "name": "Un dono gentile nella neve",
      "description": "Beni condivide il suo pane con un cane affamato la vigilia di Natale e Babbo Natale lo premia con un regalo."
    },
    "es": {
      "name": "Un regalo amable en la nieve",
      "description": "Beni comparte su pan con un perro hambriento en Nochebuena y Santa Claus lo premia con un regalo."
    },
    "fr": {
      "name": "Un cadeau gentil dans la neige",
      "description": "Beni partage son pain avec un chien affamé la veille de Noël et le Père Noël le récompense avec un cadeau."
    },
    "hu": {
      "name": "Egy kedves ajándék a hóban",
      "description": "Beni megosztja a kenyerét egy éhes kutyával szenteste, a Mikulás pedig ajándékkal jutalmazza a kedvességét."
    },
    "pt": {
      "name": "Um presente gentil na neve",
      "description": "Beni divide o seu pão com um cão faminto na véspera de Natal e o Pai Natal recompensa-o com um presente."
    }
  },
