  "locales": {
    "en": {
      "name": "The Big Night Flight",
      "description": "A kind man prepares his sleigh for a long night of delivering gifts to children around the world."
    },
    "ro": {
      "name": "Marea călătorie de noapte",
      "description": "Un om bun își pregătește sania pentru o noapte lungă în care împarte cadouri copiilor din toată lumea."
    },
    "de": {
      "name": "Der große Nachtflug",
      "description": "Ein freundlicher Mann bereitet seinen Schlitten für eine lange Nacht vor, um Kindern auf der ganzen Welt Geschenke zu bringen."
    },
    "ru": {
      "name": "Большой ночной полёт",
      "description": "Добрый человек готовит свои сани к долгой ночи, чтобы раздать подарки детям по всему миру."
    },
    "it": {
      "name": "Il grande volo notturno",
      "description": "Un uomo gentile prepara la sua slitta per una lunga notte di consegna regali ai bambini di tutto il mondo."
    },
    "es": {
      "name": "El gran vuelo nocturno",
      "description": "Un hombre amable prepara su trineo para una larga noche repartiendo regalos a los niños de todo el mundo."
    },
    "fr": {
      "name": "Le grand vol de nuit",
      "description": "Un homme gentil prépare son traîneau pour une longue nuit afin de distribuer des cadeaux aux enfants du monde entier."
    },
    "hu": {
      "name": "A nagy éjszakai repülés",
      "description": "Egy kedves ember előkészíti a szánját egy hosszú éjszakára, hogy ajándékokat vigyen a gyerekeknek a világ minden táján."
    },
    "pt": {
      "name": "O grande voo noturno",
      "description": "Um homem gentil prepara o seu trenó para uma longa noite de entrega de presentes às crianças de todo o mundo."
    }
  },
