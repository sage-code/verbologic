  "locales": {
    "en": {
      "name": "Nico Finds a Seat",
      "description": "Nico the small striped chipmunk worries about sitting in class until a friend helps him find a place."
    },
    "ro": {
      "name": "Nico își caută un loc",
      "description": "Nico, un veverițoi mic, se teme că nu are unde să stea la școală, dar un prieten îl ajută."
    },
    "de": {
      "name": "Nico sucht einen Platz",
      "description": "Nico das kleine Streifenhörnchen hat Angst, keinen Platz in der Schule zu finden, bis ein Freund ihm hilft."
    },
    "ru": {
      "name": "Нико ищет место",
      "description": "Маленький бурундук Нико боится, что ему не хватит места в классе, но друг помогает ему."
    },
    "it": {
      "name": "Nico cerca un posto",
      "description": "Nico lo scoiattolo striato teme di non avere un posto in classe, finché un amico lo aiuta."
    },
    "es": {
      "name": "Nico busca un asiento",
      "description": "Nico la pequeña ardilla rayada se preocupa por no tener sitio en clase hasta que un amigo le ayuda."
    },
    "fr": {
      "name": "Nico cherche une place",
      "description": "Nico le petit tamia rayé s'inquiète de ne pas avoir de place en classe jusqu'à ce qu'un ami l'aide."
    },
    "hu": {
      "name": "Nico helyet keres",
      "description": "Nico, a kis csíkos mókus aggódik, hogy nem jut neki hely az iskolában, de egy barát segít neki."
    },
    "pt": {
      "name": "Nico procura um lugar",
      "description": "Nico o pequeno esquilo listrado preocupa-se por não ter lugar na aula até que um amigo o ajuda."
    }
  },
