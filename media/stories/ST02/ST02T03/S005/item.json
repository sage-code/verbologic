  "locales": {
    "en": {
      "name": "A Soft Friend at School",
      "description": "Koda the koala meets Mika the hamster at school and learns to share his soft leaves."
    },
    "ro": {
      "name": "Un prieten moale la școală",
      "description": "Koda koala o întâlnește pe Mika hamsterul la școală și învață să împartă frunzele lui moi."
    },
    "de": {
      "name": "Ein weicher Freund in der Schule",
      "description": "Koda der Koala trifft Mika den Hamster in der Schule und lernt, seine weichen Blätter zu teilen."
    },
    "ru": {
      "name": "Мягкий друг в школе",
      "description": "Коала Кода встречает хомячка Мику в школе и учится делиться своими мягкими листьями."
    },
    "it": {
      "name": "Un amico morbido a scuola",
      "description": "Koda il koala incontra Mika il criceto a scuola e impara a condividere le sue foglie morbide."
    },
    "es": {
      "name": "Un amigo suave en la escuela",
      "description": "Koda el koala conoce a Mika el hámster en la escuela y aprende a compartir sus hojas suaves."
    },
    "fr": {
      "name": "Un ami doux à l'école",
      "description": "Koda le koala rencontre Mika le hamster à l'école et apprend à partager ses feuilles douces."
    },
    "hu": {
      "name": "Egy puha barát az iskolában",
      "description": "Koda, a koala találkozik Mika hörcsöggel az iskolában, és megtanulja megosztani a puha leveleit."
    },
    "pt": {
      "name": "Um amigo macio na escola",
      "description": "Koda o coala conhece Mika o hamster na escola e aprende a partilhar as suas folhas macias."
    }
  },
