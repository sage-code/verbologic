  "locales": {
    "en": {
      "name": "The Yellow Sun",
      "description": "Leo needs yellow paint for his picture, and his new classmate Sam shares hers to make a friend."
    },
    "ro": {
      "name": "Soarele galben",
      "description": "Leo are nevoie de vopsea galbenă pentru desenul lui, iar noua lui colegă Sam împarte cu el ca să se împrietenească."
    },
    "de": {
      "name": "Die gelbe Sonne",
      "description": "Leo braucht gelbe Farbe für sein Bild, und seine neue Mitschülerin Sam teilt ihre Farbe, um Freundschaft zu schließen."
    },
    "ru": {
      "name": "Жёлтое солнце",
      "description": "Лео нужна жёлтая краска для рисунка, и его новая одноклассница Сэм делится своей, чтобы подружиться."
    },
    "it": {
      "name": "Il sole giallo",
      "description": "Leo ha bisogno di pittura gialla per il suo disegno, e la sua nuova compagna di classe Sam condivide la sua per fare amicizia."
    },
    "es": {
      "name": "El sol amarillo",
      "description": "Leo necesita pintura amarilla para su dibujo, y su nueva compañera Sam comparte la suya para hacer un amigo."
    },
    "fr": {
      "name": "Le soleil jaune",
      "description": "Leo a besoin de peinture jaune pour son dessin, et sa nouvelle camarade de classe Sam partage la sienne pour devenir son amie."
    },
    "hu": {
      "name": "A sárga nap",
      "description": "Leónak sárga festékre van szüksége a képéhez, és az új osztálytársa, Sam megosztja vele a sajátját, hogy barátok legyenek."
    },
    "pt": {
      "name": "O sol amarelo",
      "description": "Leo precisa de tinta amarela para o seu desenho, e a sua nova colega Sam partilha a dela para fazerem amizade."
    }
  },
