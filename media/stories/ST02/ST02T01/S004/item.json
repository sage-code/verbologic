  "locales": {
    "en": {
      "name": "Mika the Brave",
      "description": "Mika the tiny hamster discovers a large shiny stone in the forest and brings it home to brighten her nest."
    },
    "ro": {
      "name": "Mika cea curajoasă",
      "description": "Mika, un hamster mic, găsește o piatră strălucitoare în pădure și o duce acasă pentru a-și lumina cuibul."
    },
    "de": {
      "name": "Mika die Mutige",
      "description": "Der kleine Hamster Mika findet einen großen, glänzenden Stein im Wald und bringt ihn nach Hause, um ihr Nest zu erhellen."
    },
    "ru": {
      "name": "Храбрая Мика",
      "description": "Маленький хомячок Мика находит в лесу большой блестящий камень и приносит его домой, чтобы осветить свое гнездо."
    },
    "it": {
      "name": "Mika la coraggiosa",
      "description": "Il piccolo criceto Mika trova una grande pietra lucente nel bosco e la porta a casa per illuminare il suo nido."
    },
    "es": {
      "name": "Mika la valiente",
      "description": "La pequeña hámster Mika encuentra una gran piedra brillante en el bosque y la lleva a casa para iluminar su nido."
    },
    "fr": {
      "name": "Mika la courageuse",
      "description": "Le petit hamster Mika trouve une grosse pierre brillante dans la forêt et l'apporte chez elle pour éclairer son nid."
    },
    "hu": {
      "name": "Bátor Mika",
      "description": "Mika, a kis hörcsög, egy nagy fényes követ talál az erdőben, és hazaviszi, hogy kivilágítsa a fészkét."
    },
    "pt": {
      "name": "Mika a corajosa",
      "description": "A pequena hamster Mika encontra uma grande pedra brilhante na floresta e leva-a para casa para iluminar o seu ninho."
    }
  },
