    },
    "it": {
      "name": "Tico trova una casa",
      "description": "Il colorato tucano Tico cerca un posto sicuro dove riposare durante una notte di tempesta nella foresta."
    },
    "es": {
      "name": "Tico encuentra un hogar",
      "description": "El colorido tucán Tico busca un lugar seguro donde descansar durante una noche de tormenta en la selva."
    },
