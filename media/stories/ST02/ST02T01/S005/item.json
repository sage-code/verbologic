  "locales": {
    "en": {
      "name": "Gaia Finds a Home",
      "description": "Gaia the armadillo searches for a dry place to live after a flood and stays safe from a jaguar."
    },
    "ro": {
      "name": "Gaia își găsește o casă",
      "description": "Gaia, un armadillo mic, caută un loc uscat după ploaie și scapă de un jaguar."
    },
    "de": {
      "name": "Gaia findet ein Zuhause",
      "description": "Gaia das Gürteltier sucht nach dem Regen ein trockenes Heim und versteckt sich vor einem Jaguar."
    },
    "ru": {
      "name": "Гайя находит дом",
      "description": "Броненосец Гайя ищет сухое место после дождя и прячется от ягуара."
    },
    "it": {
      "name": "Gaia trova una casa",
      "description": "Gaia l'armadillo cerca un posto asciutto dopo la pioggia e si salva da un giaguaro."
    },
    "es": {
      "name": "Gaia encuentra un hogar",
      "description": "Gaia el armadillo busca un lugar seco tras la lluvia y se protege de un jaguar."
    },
    "fr": {
      "name": "Gaia trouve une maison",
      "description": "Gaia le tatou cherche un endroit sec après la pluie et échappe à un jaguar."
    },
    "hu": {
      "name": "Gaia otthonra talál",
      "description": "Gaia, az övesállat száraz helyet keres az eső után, és elbújik egy jaguár elől."
    },
    "pt": {
      "name": "Gaia encontra um lar",
      "description": "Gaia o tatu procura um lugar seco depois da chuva e se protege de um jaguar."
    }
  },
