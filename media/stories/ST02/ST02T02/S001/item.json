  "locales": {
    "en": {
      "name": "Leo and the Big Red Hat",
      "description": "Leo the dog finds a large hat and tries to wear it, but it covers his whole face."
    },
    "ro": {
      "name": "Leo și pălăria roșie",
      "description": "Leo, un cățeluș, găsește o pălărie mare și încearcă să o poarte, dar îi acoperă toată fața."
    },
    "de": {
      "name": "Leo und der große rote Hut",
      "description": "Der Hund Leo findet einen großen Hut und setzt ihn auf, aber er ist viel zu groß für ihn."
    },
    "ru": {
      "name": "Лео и большая красная шляпа",
      "description": "Собака Лео находит большую шляпу и надевает её, но она закрывает ему всё лицо."
    },
    "it": {
      "name": "Leo e il grande cappello rosso",
      "description": "Il cane Leo trova un cappello grande e prova a indossarlo, ma gli copre tutta la faccia."
    },
    "es": {
      "name": "Leo y el gran sombrero rojo",
      "description": "El perro Leo encuentra un sombrero grande e intenta ponérselo, pero le cubre toda la cara."
    },
    "fr": {
      "name": "Leo et le grand chapeau rouge",
      "description": "Le chien Leo trouve un grand chapeau et essaie de le porter, mais il lui cache tout le visage."
    },
    "hu": {
      "name": "Leo és a nagy piros kalap",
      "description": "Leo, a kutya talál egy nagy kalapot és megpróbálja felvenni, de az eltakarja az egész arcát."
    },
    "pt": {
      "name": "Leo e o grande chapéu vermelho",
      "description": "O cão Leo encontra um chapéu grande e tenta usá-lo, mas ele cobre todo o seu rosto."
    }
  },
