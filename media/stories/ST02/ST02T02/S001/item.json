  "locales": {
    "en": {
      "name": "Rufus and the Big Red Hat",
      "description": "Rufus the dog finds a large hat and tries to wear it, but it covers his whole face."
    },
    "ro": {
      "name": "Rufus și pălăria roșie",
      "description": "Cățelușul Rufus găsește o pălărie mare și încearcă să o poarte, dar îi acoperă toată fața."
    },
    "de": {
      "name": "Rufus und der große rote Hut",
      "description": "Der Hund Rufus findet einen großen Hut und setzt ihn auf, aber er sieht nichts mehr."
    },
    "ru": {
      "name": "Руфус и большая красная шляпа",
      "description": "Собака Руфус находит большую шляпу и пытается её надеть, но она закрывает ему всё лицо."
    },
    "it": {
      "name": "Rufus e il grande cappello rosso",
      "description": "Il cane Rufus trova un cappello grande e prova a indossarlo, ma gli copre tutta la faccia."
    },
    "es": {
      "name": "Rufus y el gran sombrero rojo",
      "description": "El perro Rufus encuentra un sombrero grande e intenta ponérselo, pero le cubre toda la cara."
    },
    "fr": {
      "name": "Rufus et le grand chapeau rouge",
      "description": "Le chien Rufus trouve un grand chapeau et essaie de le porter, mais il lui cache tout le visage."
    },
    "hu": {
      "name": "Rufus és a nagy piros kalap",
      "description": "Rufus kutya talál egy nagy kalapot és megpróbálja felvenni, de az eltakarja az egész arcát."
    },
    "pt": {
      "name": "Rufus e o grande chapéu vermelho",
      "description": "O cão Rufus encontra um chapéu grande e tenta usá-lo, mas ele cobre todo o seu rosto."
    }
  },
