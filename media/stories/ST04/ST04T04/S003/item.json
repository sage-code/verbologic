  "locales": {
    "en": {
      "name": "The Gold of Great Zimbabwe",
      "description": "A young girl travels to ancient stone ruins and learns to respect the history of her ancestors."
    },
    "ro": {
      "name": "Aurul din Marele Zimbabwe",
      "description": "O fată vizitează ruine antice și învață să respecte istoria strămoșilor săi."
    },
    "de": {
      "name": "Das Gold von Groß-Simbabwe",
      "description": "Ein junges Mädchen besucht alte Steinruinen und lernt, die Geschichte ihrer Vorfahren zu achten."
    },
    "ru": {
      "name": "Золото Великого Зимбабве",
      "description": "Девочка путешествует к древним руинам и учится уважать историю своих предков."
    },
    "it": {
      "name": "L'oro del Grande Zimbabwe",
      "description": "Una ragazza viaggia verso antiche rovine di pietra e impara a rispettare la storia dei suoi antenati."
    },
    "es": {
      "name": "El oro del Gran Zimbabue",
      "description": "Una niña viaja a antiguas ruinas de piedra y aprende a respetar la historia de sus antepasados."
    },
    "fr": {
      "name": "L'or du Grand Zimbabwe",
      "description": "Une jeune fille voyage vers d'anciennes ruines en pierre et apprend à respecter l'histoire de ses ancêtres."
    },
    "hu": {
      "name": "Nagy-Zimbabwe aranya",
      "description": "Egy fiatal lány ősi kőromokhoz utazik, és megtanulja tisztelni ősei történelmét."
    },
    "pt": {
      "name": "O ouro do Grande Zimbábue",
      "description": "Uma jovem viaja para antigas ruínas de pedra e aprende a respeitar a história dos seus antepassados."
    }
  },
