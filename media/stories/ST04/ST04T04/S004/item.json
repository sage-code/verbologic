  "locales": {
    "en": {
      "name": "The Way of the Waves",
      "description": "Kato navigates his canoe across the Pacific Ocean to find a new home for his people by following the stars and the birds."
    },
    "ro": {
      "name": "Drumul valurilor",
      "description": "Kato navighează cu canoea sa pe Oceanul Pacific pentru a găsi o nouă casă pentru poporul său, urmând stelele și păsările."
    },
    "de": {
      "name": "Der Weg der Wellen",
      "description": "Kato steuert sein Kanu über den Pazifik, um eine neue Heimat für sein Volk zu finden, indem er den Sternen und Vögeln folgt."
    },
    "ru": {
      "name": "Путь волн",
      "description": "Като плывет на своем каноэ по Тихому океану, чтобы найти новый дом для своего народа, следуя за звездами и птицами."
    },
    "it": {
      "name": "La via delle onde",
      "description": "Kato naviga con la sua canoa nell'Oceano Pacifico per trovare una nuova casa per il suo popolo, seguendo le stelle e gli uccelli."
    },
    "es": {
      "name": "El camino de las olas",
      "description": "Kato navega en su canoa por el Océano Pacífico para encontrar un nuevo hogar para su gente, siguiendo las estrellas y los pájaros."
    },
    "fr": {
      "name": "Le chemin des vagues",
      "description": "Kato navigue avec sa pirogue sur l'océan Pacifique pour trouver un nouveau foyer pour son peuple en suivant les étoiles et les oiseaux."
    },
    "hu": {
      "name": "A hullámok útja",
      "description": "Kato a kenujával a Csendes-óceánon hajózik, hogy új otthont találjon népének a csillagokat és a madarakat követve."
    },
    "pt": {
      "name": "O caminho das ondas",
      "description": "Kato navega na sua canoa pelo Oceano Pacífico para encontrar um novo lar para o seu povo, seguindo as estrelas e os pássaros."
    }
  },
