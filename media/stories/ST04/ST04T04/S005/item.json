    "en": {
      "name": "The Jewel of Golconda",
      "description": "A girl named Vera finds a lost diamond and travels through a busy market to return it to a merchant."
    },
    "ro": {
      "name": "Diamantul din Golconda",
      "description": "O fată pe nume Vera găsește un diamant pierdut și merge printr-o piață aglomerată pentru a-l înapoia unui negustor."
    },
    "de": {
      "name": "Der Diamant von Golkonda",
      "description": "Ein Mädchen namens Vera findet einen verlorenen Diamanten und geht durch einen belebten Markt, um ihn einem Händler zurückzugeben."
    },
    "ru": {
      "name": "Алмаз Голконды",
      "description": "Девочка по имени Вера находит потерянный алмаз и идет через шумный рынок, чтобы вернуть его торговцу."
    },
    "it": {
      "name": "Il diamante di Golconda",
      "description": "Una ragazza di nome Vera trova un diamante perduto e attraversa un mercato affollato per restituirlo a un mercante."
    },
    "es": {
      "name": "El diamante de Golconda",
      "description": "Una niña llamada Vera encuentra un diamante perdido y viaja a través de un mercado concurrido para devolvérselo a un comerciante."
    },
    "fr": {
      "name": "Le diamant de Golconde",
      "description": "Une fille nommée Vera trouve un diamant perdu et traverse un marché animé pour le rendre à un marchand."
    },
    "hu": {
      "name": "Golconda gyémántja",
      "description": "Egy Vera nevű lány talál egy elveszett gyémántot, és átmegy egy forgalmas piacon, hogy visszaadja egy kereskedőnek."
    },
    "pt": {
      "name": "O diamante de Golconda",
      "description": "Uma menina chamada Vera encontra um diamante perdido e atravessa um mercado movimentado para devolvê-lo a um comerciante."
    }
  },
