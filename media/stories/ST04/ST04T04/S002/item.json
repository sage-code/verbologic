  "locales": {
    "en": {
      "name": "The Star Map of Vito",
      "description": "Vito the boy and his friend the giant turtle search for a hidden treasure using an old map of the stars."
    },
    "ro": {
      "name": "Harta stelară a lui Vito",
      "description": "Vito și prietenul său, o țestoasă uriașă, caută o comoară ascunsă folosind o hartă veche a stelelor."
    },
    "de": {
      "name": "Vitos Sternenkarte",
      "description": "Der Junge Vito und sein Freund, eine Riesenschildkröte, suchen mit einer alten Sternenkarte nach einem Schatz."
    },
    "ru": {
      "name": "Звездная карта Вито",
      "description": "Мальчик Вито и его друг, гигантская черепаха, ищут спрятанное сокровище, используя старую карту звезд."
    },
    "it": {
      "name": "La mappa stellare di Vito",
      "description": "Il ragazzo Vito e il suo amico, una tartaruga gigante, cercano un tesoro nascosto usando una vecchia mappa delle stelle."
    },
    "es": {
      "name": "El mapa estelar de Vito",
      "description": "El niño Vito y su amigo, una tortuga gigante, buscan un tesoro escondido usando un viejo mapa de las estrellas."
    },
    "fr": {
      "name": "La carte des étoiles de Vito",
      "description": "Le garçon Vito et son ami, une tortue géante, cherchent un trésor caché en utilisant une vieille carte des étoiles."
    },
    "hu": {
      "name": "Vito csillagtérképe",
      "description": "Vito, a fiú és barátja, az óriásteknős egy régi csillagtérkép segítségével keresnek egy elrejtett kincset."
    },
    "pt": {
      "name": "O mapa estelar de Vito",
      "description": "O menino Vito e seu amigo, uma tartaruga gigante, procuram um tesouro escondido usando um mapa antigo das estrelas."
    }
  },
