  "locales": {
    "en": {
      "name": "The Bottle and the Pirate's Island",
      "description": "Nadia and her brother Teo find a map in a bottle, sail to a far island, find a treasure and the journal of an old pirate."
    },
    "ro": {
      "name": "Sticla și insula piratului",
      "description": "Nadia și fratele ei, Teo, găsesc o hartă într-o sticlă, navighează spre o insulă îndepărtată, găsesc o comoară și jurnalul unui pirat bătrân."
    },
    "de": {
      "name": "Die Flasche und die Pirateninsel",
      "description": "Nadia und ihr Bruder Teo finden eine Karte in einer Flasche, segeln zu einer fernen Insel, finden einen Schatz und das Tagebuch eines alten Piraten."
    },
    "ru": {
      "name": "Бутылка и остров пирата",
      "description": "Надя и её брат Тео находят карту в бутылке, плывут на далёкий остров, находят сокровища и дневник старого пирата."
    },
    "it": {
      "name": "La bottiglia e l'isola del pirata",
      "description": "Nadia e suo fratello Teo trovano una mappa in una bottiglia, navigano verso un'isola lontana, trovano un tesoro e il diario di un vecchio pirata."
    },
    "es": {
      "name": "La botella y la isla del pirata",
      "description": "Nadia y su hermano Teo encuentran un mapa en una botella, navegan a una isla lejana, encuentran un tesoro y el diario de un viejo pirata."
    },
    "fr": {
      "name": "La bouteille et l'île du pirate",
      "description": "Nadia et son frère Teo trouvent une carte dans une bouteille, naviguent vers une île lointaine, trouvent un trésor et le journal d'un vieux pirate."
    },
    "hu": {
      "name": "Az üveg és a kalóz szigete",
      "description": "Nadia és testvére, Teo térképet találnak egy üvegben, elhajóznak egy távoli szigetre, kincset és egy öreg kalóz naplóját találják."
    },
    "pt": {
      "name": "A garrafa e a ilha do pirata",
      "description": "Nadia e seu irmão Teo encontram um mapa numa garrafa, navegam para uma ilha distante, encontram um tesouro e o diário de um velho pirata."
    }
  },
