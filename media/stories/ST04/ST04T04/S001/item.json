  "locales": {
    "en": {
      "name": "The Golden Shield of Olek",
      "description": "Olek the brave boy finds a golden shield and learns that helping others is the greatest quest of all."
    },
    "ro": {
      "name": "Scutul de aur al lui Olek",
      "description": "Olek este un băiat curajos care găsește un scut de aur și învață că ajutorul oferit celorlalți este cea mai mare aventură."
    },
    "de": {
      "name": "Der goldene Schild von Olek",
      "description": "Olek ist ein mutiger Junge, der einen goldenen Schild findet und lernt, dass anderen zu helfen das größte Abenteuer ist."
    },
    "ru": {
      "name": "Золотой щит Олека",
      "description": "Олек — храбрый мальчик, который находит золотой щит и понимает, что помогать другим — это самое важное дело."
    },
    "it": {
      "name": "Lo scudo d'oro di Olek",
      "description": "Olek è un ragazzo coraggioso che trova uno scudo d'oro e impara che aiutare gli altri è la missione più importante."
    },
    "es": {
      "name": "El escudo de oro de Olek",
      "description": "Olek es un niño valiente que encuentra un escudo de oro y aprende que ayudar a los demás es la mayor aventura."
    },
    "fr": {
      "name": "Le bouclier d'or d'Olek",
      "description": "Olek est un garçon courageux qui trouve un bouclier d'or et apprend qu'aider les autres est la plus grande des aventures."
    },
    "hu": {
      "name": "Olek aranypajzsa",
      "description": "Olek egy bátor fiú, aki talál egy aranypajzsot, és megtanulja, hogy másokon segíteni a legnagyobb kaland."
    },
    "pt": {
      "name": "O escudo de ouro de Olek",
      "description": "Olek é um menino corajoso que encontra um escudo de ouro e aprende que ajudar os outros é a maior aventura de todas."
    }
  },
