  "locales": {
    "en": {
      "name": "The First Salmon",
      "description": "A girl named Ida helps a hungry raven find food in the Pacific Northwest and receives a gift of salmon."
    },
    "ro": {
      "name": "Primul somon",
      "description": "O fată pe nume Ida ajută un corb flămând să găsească hrană și primește în dar un somon."
    },
    "de": {
      "name": "Der erste Lachs",
      "description": "Ein Mädchen namens Ida hilft einem hungrigen Raben bei der Nahrungssuche und bekommt einen Lachs geschenkt."
    },
    "ru": {
      "name": "Первый лосось",
      "description": "Девочка по имени Ида помогает голодному ворону найти еду и получает в подарок лосося."
    },
    "it": {
      "name": "Il primo salmone",
      "description": "Una ragazza di nome Ida aiuta un corvo affamato a trovare cibo e riceve in dono un salmone."
    },
    "es": {
      "name": "El primer salmón",
      "description": "Una niña llamada Ida ayuda a un cuervo hambriento a encontrar comida y recibe un salmón de regalo."
    },
    "fr": {
      "name": "Le premier saumon",
      "description": "Une fille nommée Ida aide un corbeau affamé à trouver à manger et reçoit un saumon en cadeau."
    },
    "hu": {
      "name": "Az első lazac",
      "description": "Egy Ida nevű lány segít egy éhes hollónak ételt találni, és ajándékba kap egy lazacot."
    },
    "pt": {
      "name": "O primeiro salmão",
      "description": "Uma menina chamada Ida ajuda um corvo faminto a encontrar comida e recebe um salmão de presente."
    }
  },
