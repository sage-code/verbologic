  "locales": {
    "en": {
      "name": "The Spirit of the Deep",
      "description": "An Inuit hunter learns that showing respect to the sea spirit brings a bountiful harvest for his family."
    },
    "ro": {
      "name": "Spiritul Adâncurilor",
      "description": "Un vânător inuit învață că respectul față de spiritul mării aduce hrană pentru familia sa."
    },
    "de": {
      "name": "Der Geist der Tiefe",
      "description": "Ein Inuit-Jäger lernt, dass Respekt vor dem Meeresgeist seiner Familie Glück bringt."
    },
    "ru": {
      "name": "Дух глубин",
      "description": "Охотник-инуит узнает, что уважение к духу моря приносит удачу его семье."
    },
    "it": {
      "name": "Lo Spirito degli Abissi",
      "description": "Un cacciatore inuit impara che rispettare lo spirito del mare porta abbondanza alla sua famiglia."
    },
    "es": {
      "name": "El Espíritu de las Profundidades",
      "description": "Un cazador inuit aprende que respetar al espíritu del mar trae abundancia a su familia."
    },
    "fr": {
      "name": "L'Esprit des Profondeurs",
      "description": "Un chasseur inuit apprend que respecter l'esprit de la mer apporte l'abondance à sa famille."
    },
    "hu": {
      "name": "A Mélység Szelleme",
      "description": "Egy inuit vadász megtanulja, hogy a tenger szellemének tisztelete bőséget hoz a családjának."
    },
    "pt": {
      "name": "O Espírito das Profundezas",
      "description": "Um caçador inuit aprende que respeitar o espírito do mar traz fartura para sua família."
    }
  },
