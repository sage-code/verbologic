    "en": {
      "name": "The Weaver and the Goddess",
      "description": "Arachne is a talented weaver in ancient Greece who learns a difficult lesson after challenging the goddess Athena."
    },
    "ro": {
      "name": "Arahne și zeița",
      "description": "Arahne este o tânără țesătoare din Grecia antică care învață o lecție importantă după ce o provoacă pe zeița Atena."
    },
    "de": {
      "name": "Arachne und die Göttin",
      "description": "Arachne ist eine talentierte Weberin im alten Griechenland, die eine schwere Lektion lernt, nachdem sie die Göttin Athene herausfordert."
    },
    "ru": {
      "name": "Арахна и богиня",
      "description": "Арахна — талантливая ткачиха из Древней Греции, которая получает важный урок после того, как бросает вызов богине Афине."
    },
    "it": {
      "name": "Aracne e la dea",
      "description": "Aracne è una talentuosa tessitrice nell'antica Grecia che impara una lezione difficile dopo aver sfidato la dea Atena."
    },
    "es": {
      "name": "Aracne y la diosa",
      "description": "Aracne es una talentosa tejedora en la antigua Grecia que aprende una lección difícil después de desafiar a la diosa Atenea."
    },
    "fr": {
      "name": "Arachné et la déesse",
      "description": "Arachné est une tisseuse talentueuse dans la Grèce antique qui apprend une leçon difficile après avoir défié la déesse Athéna."
    },
    "hu": {
      "name": "Arachné és az istennő",
      "description": "Arachné egy tehetséges takács az ókori Görögországban, aki nehéz leckét tanul, miután kihívja Athéné istennőt."
    },
    "pt": {
      "name": "Aracne e a deusa",
      "description": "Aracne é uma talentosa tecelã na Grécia antiga que aprende uma lição difícil após desafiar a deusa Atena."
    }
  },
