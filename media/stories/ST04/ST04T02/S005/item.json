    "en": {
      "name": "The Founders of Rome",
      "description": "Twin brothers Romulus and Remus are raised by a wolf and a shepherd before building a great city."
    },
    "ro": {
      "name": "Întemeietorii Romei",
      "description": "Frații gemeni Romulus și Remus sunt crescuți de o lupoaică și un păstor înainte de a construi un oraș măreț."
    },
    "de": {
      "name": "Die Gründer von Rom",
      "description": "Die Zwillingsbrüder Romulus und Remus werden von einer Wölfin und einem Hirten großgezogen, bevor sie eine große Stadt gründen."
    },
    "ru": {
      "name": "Основатели Рима",
      "description": "Братья-близнецы Ромул и Рем воспитываются волчицей и пастухом, прежде чем построить великий город."
    },
    "it": {
      "name": "I fondatori di Roma",
      "description": "I fratelli gemelli Romolo e Remo vengono cresciuti da una lupa e un pastore prima di costruire una grande città."
    },
    "es": {
      "name": "Los fundadores de Roma",
      "description": "Los hermanos gemelos Rómulo y Remo son criados por una loba y un pastor antes de construir una gran ciudad."
    },
    "fr": {
      "name": "Les fondateurs de Rome",
      "description": "Les frères jumeaux Romulus et Rémus sont élevés par une louve et un berger avant de construire une grande ville."
    },
    "hu": {
      "name": "Róma alapítói",
      "description": "A két ikertestvért, Romulust és Remust egy farkas és egy pásztor neveli fel, mielőtt egy nagy várost építenének."
    },
    "pt": {
      "name": "Os fundadores de Roma",
      "description": "Os irmãos gémeos Rómulo e Remo são criados por uma loba e um pastor antes de construírem uma grande cidade."
    }
