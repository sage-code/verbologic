  "locales": {
    "en": {
      "name": "The River of Light",
      "description": "A young boy learns how the ancient crocodile and the rainbow serpent shaped his home near the river."
    },
    "ro": {
      "name": "Râul de Lumină",
      "description": "Un băiat învață cum crocodilul antic și șarpele curcubeu au creat casa lui de lângă râu."
    },
    "de": {
      "name": "Der Fluss des Lichts",
      "description": "Ein kleiner Junge lernt, wie das alte Krokodil und die Regenbogen-Schlange seine Heimat am Fluss erschufen."
    },
    "ru": {
      "name": "Река света",
      "description": "Мальчик узнает, как древний крокодил и радужный змей создали его дом у реки."
    },
    "it": {
      "name": "Il Fiume di Luce",
      "description": "Un ragazzo impara come l'antico coccodrillo e il serpente arcobaleno hanno creato la sua casa vicino al fiume."
    },
    "es": {
      "name": "El Río de Luz",
      "description": "Un niño aprende cómo el cocodrilo antiguo y la serpiente arcoíris formaron su hogar junto al río."
    },
    "fr": {
      "name": "La Rivière de Lumière",
      "description": "Un jeune garçon apprend comment l'ancien crocodile et le serpent arc-en-ciel ont façonné sa maison près de la rivière."
    },
    "hu": {
      "name": "A Fény Folyója",
      "description": "Egy kisfiú megtanulja, hogyan formálta az ősi krokodil és a szivárványkígyó az otthonát a folyó mellett."
    },
    "pt": {
      "name": "O Rio de Luz",
      "description": "Um menino aprende como o crocodilo antigo e a serpente arco-íris formaram sua casa perto do rio."
    }
  },
