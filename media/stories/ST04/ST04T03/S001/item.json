  "locales": {
    "en": {
      "name": "Bram and the Sun Bird",
      "description": "Bram finds a sad bird in the forest and helps it return the light to the sky."
    },
    "ro": {
      "name": "Bram și Pasărea Soarelui",
      "description": "Bram găsește o pasăre tristă în pădure și o ajută să aducă lumina înapoi pe cer."
    },
    "de": {
      "name": "Bram und der Sonnenvogel",
      "description": "Bram findet einen traurigen Vogel im Wald und hilft ihm, das Licht zurück in den Himmel zu bringen."
    },
    "ru": {
      "name": "Брам и Солнечная птица",
      "description": "Брам находит грустную птицу в лесу и помогает ей вернуть свет на небо."
    },
    "it": {
      "name": "Bram e l'Uccello del Sole",
      "description": "Bram trova un uccellino triste nel bosco e lo aiuta a riportare la luce nel cielo."
    },
    "es": {
      "name": "Bram y el Pájaro del Sol",
      "description": "Bram encuentra un pájaro triste en el bosque y le ayuda a traer la luz de vuelta al cielo."
    },
    "fr": {
      "name": "Bram et l'Oiseau du Soleil",
      "description": "Bram trouve un oiseau triste dans la forêt et l'aide à ramener la lumière dans le ciel."
    },
    "hu": {
      "name": "Bram és a Napmadár",
      "description": "Bram egy szomorú madarat talál az erdőben, és segít neki visszahozni a fényt az égre."
    },
    "pt": {
      "name": "Bram e o Pássaro do Sol",
      "description": "Bram encontra um pássaro triste na floresta e ajuda-o a trazer a luz de volta ao céu."
    }
  },
