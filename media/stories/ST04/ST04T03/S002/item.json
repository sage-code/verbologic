  "locales": {
    "en": {
      "name": "The Moon Rabbit and the Cakes",
      "description": "A young girl helps a magical rabbit on the moon make special rice cakes to share with others."
    },
    "ro": {
      "name": "Iepurașul din Lună și prăjiturile",
      "description": "O fetiță ajută un iepuraș magic de pe Lună să facă prăjituri speciale pentru oameni."
    },
    "de": {
      "name": "Der Mondhase und die Kuchen",
      "description": "Ein junges Mädchen hilft einem magischen Hasen auf dem Mond, besondere Reiskuchen für alle zu backen."
    },
    "ru": {
      "name": "Лунный зайчик и пирожные",
      "description": "Девочка помогает волшебному зайчику на Луне готовить особые рисовые пирожные для всех людей."
    },
    "it": {
      "name": "Il coniglio della Luna e i dolci",
      "description": "Una bambina aiuta un coniglio magico sulla Luna a preparare dolci speciali di riso per tutti."
    },
    "es": {
      "name": "El conejo de la Luna y los pasteles",
      "description": "Una niña ayuda a un conejo mágico en la Luna a hacer pasteles de arroz especiales para compartir."
    },
    "fr": {
      "name": "Le lapin de la Lune et les gâteaux",
      "description": "Une jeune fille aide un lapin magique sur la Lune à préparer des gâteaux de riz spéciaux pour tout le monde."
    },
    "hu": {
      "name": "A Hold nyuszija és a sütemények",
      "description": "Egy kislány segít egy varázslatos nyuszinak a Holdon különleges rizssüteményeket készíteni másoknak."
    },
    "pt": {
      "name": "O coelho da Lua e os bolinhos",
      "description": "Uma menina ajuda um coelho mágico na Lua a fazer bolinhos de arroz especiais para partilhar."
    }
  },
