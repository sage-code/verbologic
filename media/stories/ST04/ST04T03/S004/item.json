  "locales": {
    "en": {
      "name": "The Sails at the Shore",
      "description": "A young Aztec boy discovers strange ships arriving on the coast and warns his village of the incoming danger."
    },
    "ro": {
      "name": "Vele pe țărm",
      "description": "Un tânăr aztec vede nave ciudate pe coastă și își avertizează satul de pericolul care vine."
    },
    "de": {
      "name": "Die Segel an der Küste",
      "description": "Ein junger Aztekenjunge entdeckt seltsame Schiffe an der Küste und warnt sein Dorf vor der Gefahr."
    },
    "ru": {
      "name": "Паруса на берегу",
      "description": "Юный ацтекский мальчик замечает странные корабли у берега и предупреждает свою деревню об опасности."
    },
    "it": {
      "name": "Le vele sulla riva",
      "description": "Un giovane ragazzo azteco scopre strane navi che arrivano sulla costa e avverte il suo villaggio del pericolo imminente."
    },
    "es": {
      "name": "Las velas en la orilla",
      "description": "Un joven azteca descubre barcos extraños llegando a la costa y advierte a su pueblo del peligro que se acerca."
    },
    "fr": {
      "name": "Les voiles sur le rivage",
      "description": "Un jeune garçon aztèque découvre d'étranges navires arrivant sur la côte et prévient son village du danger imminent."
    },
    "hu": {
      "name": "Vitorlák a parton",
      "description": "Egy fiatal azték fiú furcsa hajókat fedez fel a parton, és figyelmezteti faluját a közelgő veszélyre."
    },
    "pt": {
      "name": "As velas na costa",
      "description": "Um jovem rapaz asteca descobre navios estranhos chegando à costa e avisa a sua aldeia do perigo que se aproxima."
    }
  },
