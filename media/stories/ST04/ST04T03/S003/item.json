  "locales": {
    "en": {
      "name": "The Bones in the Rice Field",
      "description": "A young farm girl in ancient China discovers giant, ancient bones and learns a lesson about the history of the earth."
    },
    "ro": {
      "name": "Oasele din câmpul de orez",
      "description": "O fată de la țară din China antică găsește oase uriașe și învață despre istoria lumii."
    },
    "de": {
      "name": "Die Knochen im Reisfeld",
      "description": "Ein junges Bauernmädchen im alten China findet riesige Knochen und lernt etwas über die Geschichte der Erde."
    },
    "ru": {
      "name": "Кости на рисовом поле",
      "description": "Девочка-крестьянка в древнем Китае находит гигантские кости и узнает об истории Земли."
    },
    "it": {
      "name": "Le ossa nel campo di riso",
      "description": "Una giovane contadina nell'antica Cina scopre ossa giganti e impara una lezione sulla storia della terra."
    },
    "es": {
      "name": "Los huesos en el campo de arroz",
      "description": "Una joven campesina en la antigua China descubre huesos gigantes y aprende sobre la historia de la tierra."
    },
    "fr": {
      "name": "Les os dans la rizière",
      "description": "Une jeune paysanne dans la Chine ancienne découvre des os géants et apprend une leçon sur l'histoire de la terre."
    },
    "hu": {
      "name": "A csontok a rizsföldön",
      "description": "Egy fiatal lány az ókori Kínában óriási csontokat talál, és tanul a föld történetéről."
    },
    "pt": {
      "name": "Os ossos no campo de arroz",
      "description": "Uma jovem camponesa na China antiga descobre ossos gigantes e aprende sobre a história da terra."
    }
  },
