  "locales": {
    "en": {
      "name": "The First Boomerang",
      "description": "Bindi learns from his uncle how to hunt with a boomerang in the Australian bush while respecting the life of the land."
    },
    "ro": {
      "name": "Primul bumerang",
      "description": "Bindi învață de la unchiul său cum să vâneze cu un bumerang în tufișurile australiene, respectând natura."
    },
    "de": {
      "name": "Der erste Bumerang",
      "description": "Bindi lernt von seinem Onkel, wie man mit einem Bumerang im australischen Busch jagt und dabei die Natur achtet."
    },
    "ru": {
      "name": "Первый бумеранг",
      "description": "Бинди учится у своего дяди охотиться с бумерангом в австралийских зарослях, уважая жизнь природы."
    },
    "it": {
      "name": "Il primo boomerang",
      "description": "Bindi impara da suo zio a cacciare con un boomerang nel bush australiano, rispettando la vita della terra."
    },
    "es": {
      "name": "El primer bumerán",
      "description": "Bindi aprende de su tío a cazar con un bumerán en el monte australiano, respetando la vida de la tierra."
    },
    "fr": {
      "name": "Le premier boomerang",
      "description": "Bindi apprend de son oncle à chasser avec un boomerang dans le bush australien, tout en respectant la vie de la terre."
    },
    "hu": {
      "name": "Az első bumeráng",
      "description": "Bindi megtanulja a nagybátyjától, hogyan vadásszon bumeránggal az ausztrál bozótosban, tisztelve a természet életét."
    },
    "pt": {
      "name": "O primeiro bumerangue",
      "description": "Bindi aprende com seu tio a caçar com um bumerangue no mato australiano, respeitando a vida da terra."
    }
  },
