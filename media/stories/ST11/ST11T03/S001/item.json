  "locales": {
    "en": {
      "name": "The Courier of Enkai",
      "description": "Naitore, a Maasai mail carrier, learns that wisdom lies not in delivering messages, but in knowing when to let them go."
    },
    "ro": {
      "name": "Curierul din Enkai",
      "description": "Naitore, o tânără curieră Maasai, descoperă că adevărata înțelepciune nu constă în livrarea mesajelor, ci în a ști când să le dai uitării."
    },
    "de": {
      "name": "Der Bote von Enkai",
      "description": "Naitore, eine junge Maasai-Botin, lernt, dass wahre Weisheit nicht im Überbringen von Nachrichten liegt, sondern darin, zu wissen, wann man sie loslassen muss."
    },
    "ru": {
      "name": "Курьер из Энкаи",
      "description": "Найторе, молодая курьерша масаи, понимает, что истинная мудрость заключается не в доставке сообщений, а в умении вовремя отпустить их."
    },
    "it": {
      "name": "Il corriere di Enkai",
      "description": "Naitore, una giovane corriere Maasai, impara che la vera saggezza non sta nel consegnare messaggi, ma nel sapere quando lasciarli andare."
    },
    "es": {
      "name": "El mensajero de Enkai",
      "description": "Naitore, una joven mensajera masái, aprende que la verdadera sabiduría no reside en entregar mensajes, sino en saber cuándo dejarlos ir."
    },
    "fr": {
      "name": "Le messager d'Enkai",
      "description": "Naitore, une jeune messagère masaï, apprend que la vraie sagesse ne réside pas dans la livraison des messages, mais dans le fait de savoir quand les laisser partir."
    },
    "hu": {
      "name": "Enkai hírnöke",
      "description": "Naitore, a fiatal maszáj hírnök megtanulja, hogy az igazi bölcsesség nem az üzenetek kézbesítésében rejlik, hanem abban, hogy tudja, mikor kell elengedni őket."
    },
    "pt": {
      "name": "O mensageiro de Enkai",
      "description": "Naitore, uma jovem mensageira masai, aprende que a verdadeira sabedoria não reside em entregar mensagens, mas em saber quando deixá-las ir."
    }
  },
