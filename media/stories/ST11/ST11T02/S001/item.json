  "locales": {
    "en": {
      "name": "The Symmetry of Basalt",
      "description": "Leilani, a skilled Hawaiian stonemason, debates an visiting architect on the merits of structural chaos versus rigid geometric perfection in sacred cliffside masonry."
    },
    "ro": {
      "name": "Simetria bazaltului",
      "description": "Leilani, o pietrară iscusită din Hawaii, dezbate cu un arhitect vizitator despre meritele haosului structural versus perfecțiunea geometrică rigidă în zidăria sacră de pe stânci."
    },
    "de": {
      "name": "Die Symmetrie des Basalts",
      "description": "Leilani, eine erfahrene hawaiianische Steinmetzin, debattiert mit einem Gastarchitekten über die Vorzüge strukturellen Chaos gegenüber starrer geometrischer Perfektion bei heiligem Klippenmauerwerk."
    },
    "ru": {
      "name": "Симметрия базальта",
      "description": "Лейлани, искусная гавайская каменщица, спорит с приезжим архитектором о преимуществах структурного хаоса перед жесткой геометрической правильностью в священной кладке на утесе."
    },
    "it": {
      "name": "La simmetria del basalto",
      "description": "Leilani, un'abile scalpellina hawaiana, discute con un architetto in visita sui meriti del caos strutturale rispetto alla rigida perfezione geometrica nella muratura sacra sulla scogliera."
    },
    "es": {
      "name": "La simetría del basalto",
      "description": "Leilani, una hábil cantera hawaiana, debate con un arquitecto visitante sobre los méritos del caos estructural frente a la rígida perfección geométrica en la mampostería sagrada del acantilado."
    },
    "fr": {
      "name": "La symétrie du basalte",
      "description": "Leilani, une habile tailleuse de pierre hawaïenne, débat avec un architecte en visite sur les mérites du chaos structurel face à la perfection géométrique rigide dans la maçonnerie sacrée de la falaise."
    },
    "hu": {
      "name": "A bazalt szimmetriája",
      "description": "Leilani, egy képzett hawaii kőműves, vitatkozik egy látogató építésszel a strukturális káosz és a merev geometriai tökéletesség érdemeiről a szent sziklafalak kőművesmunkájában."
    },
    "pt": {
      "name": "A simetria do basalto",
      "description": "Leilani, uma habilidosa pedreira havaiana, debate com um arquiteto visitante sobre os méritos do caos estrutural versus a rígida perfeição geométrica na alvenaria sagrada do penhasco."
    }
  },
