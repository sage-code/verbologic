  "locales": {
    "en": {
      "name": "The Ember of Reason",
      "description": "Yara, a Taino firefighter, contemplates the nature of existence while battling a brush fire in the dry coastal hills of her island home."
    },
    "ro": {
      "name": "Jarul Rațiunii",
      "description": "Yara, o pompieră Taino, reflectează asupra naturii existenței în timp ce luptă cu un incendiu de vegetație pe dealurile aride ale insulei sale."
    },
    "de": {
      "name": "Die Glut der Vernunft",
      "description": "Yara, eine Taino-Feuerwehrfrau, sinniert über das Wesen der Existenz, während sie einen Flächenbrand in den trockenen Küstenhügeln ihrer Heimatinsel bekämpft."
    },
    "ru": {
      "name": "Уголек разума",
      "description": "Яра, пожарная из племени Таино, размышляет о природе бытия, борясь с лесным пожаром на сухих прибрежных холмах своего островного дома."
    },
    "it": {
      "name": "La brace della ragione",
      "description": "Yara, una vigile del fuoco Taino, riflette sulla natura dell'esistenza mentre combatte un incendio boschivo sulle aride colline costiere della sua isola."
    },
    "es": {
      "name": "La brasa de la razón",
      "description": "Yara, una bombera taína, contempla la naturaleza de la existencia mientras lucha contra un incendio forestal en las áridas colinas costeras de su isla natal."
    },
    "fr": {
      "name": "La braise de la raison",
      "description": "Yara, une pompière taïno, contemple la nature de l'existence tout en luttant contre un feu de broussailles sur les collines côtières arides de son île."
    },
    "hu": {
      "name": "Az értelem parazsa",
      "description": "Yara, egy tainó tűzoltó, a létezés természetén töpreng, miközben bozóttűzzel küzd szigeti otthona száraz, partmenti dombjain."
    },
    "pt": {
      "name": "A Brasa da Razão",
      "description": "Yara, uma bombeira taína, contempla a natureza da existência enquanto combate um incêndio florestal nas áridas colinas costeiras da sua ilha natal."
    }
  },
