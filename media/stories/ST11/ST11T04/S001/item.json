  "locales": {
    "en": {
      "name": "The Celestial Transit",
      "description": "Major Pema, a Tibetan officer, observes a rare planetary alignment and must determine the geopolitical implications for her high-altitude mountain outpost."
    },
    "ro": {
      "name": "Tranzitul Celest",
      "description": "Maiorul Pema, un ofițer tibetan, observă o aliniere planetară rară și trebuie să determine implicațiile geopolitice pentru avanpostul său montan de mare altitudine."
    },
    "de": {
      "name": "Der himmlische Transit",
      "description": "Major Pema, eine tibetische Offizierin, beobachtet eine seltene Planetenkonstellation und muss die geopolitischen Auswirkungen für ihren hochgelegenen Außenposten bewerten."
    },
    "ru": {
      "name": "Небесный транзит",
      "description": "Майор Пема, тибетский офицер, наблюдает редкое планетарное выравнивание и должна определить геополитические последствия для своего высокогорного аванпоста."
    },
    "it": {
      "name": "Il Transito Celeste",
      "description": "Il Maggiore Pema, un ufficiale tibetano, osserva un raro allineamento planetario e deve determinare le implicazioni geopolitiche per il suo avamposto di alta montagna."
    },
    "es": {
      "name": "El Tránsito Celestial",
      "description": "La Mayor Pema, una oficial tibetana, observa una rara alineación planetaria y debe determinar las implicaciones geopolíticas para su puesto de avanzada en alta montaña."
    },
    "fr": {
      "name": "Le Transit Céleste",
      "description": "Le Major Pema, une officière tibétaine, observe un rare alignement planétaire et doit déterminer les implications géopolitiques pour son avant-poste de haute montagne."
    },
    "hu": {
      "name": "Az Égi Tranzit",
      "description": "Pema őrnagy, egy tibeti tiszt, ritka bolygóegyüttállást figyel meg, és el kell döntenie, milyen geopolitikai következményei lesznek ennek a magashegyi előőrsére nézve."
    },
    "pt": {
      "name": "O Trânsito Celestial",
      "description": "A Major Pema, uma oficial tibetana, observa um raro alinhamento planetário e deve determinar as implicações geopolíticas para o seu posto avançado de alta montanha."
    }
  },
