  "locales": {
    "en": {
      "name": "The Silent Ledger of Carthage",
      "description": "A sharp-witted detective navigates the crowded harbour of Carthage to uncover the truth behind a missing shipment of precious Tyrian purple dye."
    },
    "ro": {
      "name": "Registrul tăcut din Cartagina",
      "description": "O detectivă ageră investighează portul aglomerat al Cartaginei pentru a descoperi adevărul din spatele dispariției unui transport prețios de purpură tiriană."
    },
    "de": {
      "name": "Das stumme Register von Karthago",
      "description": "Eine scharfsinnige Detektivin navigiert durch den geschäftigen Hafen von Karthago, um die Wahrheit über eine verschwundene Ladung kostbaren Purpurs aufzudecken."
    },
    "ru": {
      "name": "Безмолвный реестр Карфагена",
      "description": "Проницательная сыщица исследует оживленный порт Карфагена, чтобы раскрыть правду об исчезновении ценного груза тирского пурпура."
    },
    "it": {
      "name": "Il registro silenzioso di Cartagine",
      "description": "Un'arguta detective esplora il porto affollato di Cartagine per scoprire la verità dietro la scomparsa di un prezioso carico di porpora di Tiro."
    },
    "es": {
      "name": "El registro silencioso de Cartago",
      "description": "Una astuta detective navega por el bullicioso puerto de Cartago para descubrir la verdad tras la desaparición de un valioso cargamento de púrpura de Tiro."
    },
    "fr": {
      "name": "Le registre silencieux de Carthage",
      "description": "Une détective perspicace explore le port animé de Carthage pour découvrir la vérité sur la disparition d'une précieuse cargaison de pourpre de Tyr."
    },
    "hu": {
      "name": "Karthágó néma nyilvántartása",
      "description": "Egy éles eszű nyomozónő Karthágó nyüzsgő kikötőjében keresi az igazságot egy eltűnt, értékes türoszi bíbor szállítmány ügyében."
    },
    "pt": {
      "name": "O Registro Silencioso de Cartago",
      "description": "Uma detetive perspicaz navega pelo movimentado porto de Cartago para descobrir a verdade por trás do desaparecimento de uma preciosa carga de púrpura de Tiro."
    }
  },
