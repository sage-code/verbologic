  "locales": {
    "en": {
      "name": "The Arctic Pulse",
      "description": "Dr. Qilaq must balance her professional ambition with the urgent medical needs of her remote community during a severe winter storm."
    },
    "ro": {
      "name": "Pulsul Arctic",
      "description": "Dr. Qilaq trebuie să echilibreze ambiția profesională cu nevoile medicale urgente ale comunității sale izolate în timpul unei furtuni de iarnă severe."
    },
    "de": {
      "name": "Der arktische Puls",
      "description": "Dr. Qilaq muss ihre beruflichen Ambitionen mit den dringenden medizinischen Bedürfnissen ihrer abgelegenen Gemeinde während eines schweren Wintersturms in Einklang bringen."
    },
    "ru": {
      "name": "Арктический пульс",
      "description": "Доктор Килак должна найти баланс между профессиональными амбициями и неотложными медицинскими нуждами своей отдаленной общины во время сильного зимнего шторма."
    },
    "it": {
      "name": "Il battito dell'Artico",
      "description": "La dottoressa Qilaq deve bilanciare le sue ambizioni professionali con le urgenti necessità mediche della sua remota comunità durante una violenta tempesta invernale."
    },
    "es": {
      "name": "El pulso del Ártico",
      "description": "La Dra. Qilaq debe equilibrar su ambición profesional con las urgentes necesidades médicas de su remota comunidad durante una severa tormenta invernal."
    },
    "fr": {
      "name": "Le pouls de l'Arctique",
      "description": "La Dre Qilaq doit concilier ses ambitions professionnelles avec les besoins médicaux urgents de sa communauté isolée lors d'une violente tempête hivernale."
    },
    "hu": {
      "name": "Az arktikus pulzus",
      "description": "Dr. Qilaq-nak egyensúlyt kell teremtenie szakmai ambíciói és közössége sürgős orvosi szükségletei között egy súlyos téli vihar idején."
    },
    "pt": {
      "name": "O Pulso do Ártico",
      "description": "A Dra. Qilaq deve equilibrar a sua ambição profissional com as necessidades médicas urgentes da sua comunidade remota durante uma severa tempestade de inverno."
    }
  },
