  "locales": {
    "en": {
      "name": "The Captain of the Zambezi",
      "description": "Tebogo, a boat captain, reconciles his duty to transport goods with the dwindling resources of his river community during a severe economic drought."
    },
    "ro": {
      "name": "Căpitanul de pe Zambezi",
      "description": "Tebogo, un căpitan de barcă, încearcă să echilibreze datoria față de comunitatea sa cu resursele tot mai puține în timpul unei crize economice."
    },
    "de": {
      "name": "Der Kapitän des Sambesi",
      "description": "Tebogo, ein Bootskapitän, versucht während einer Wirtschaftskrise seine Pflicht zur Warenbeförderung mit der Not seiner Gemeinschaft in Einklang zu bringen."
    },
    "ru": {
      "name": "Капитан Замбези",
      "description": "Тебого, капитан лодки, пытается примирить свой долг по перевозке товаров с нехваткой ресурсов в своей общине во время экономического кризиса."
    },
    "it": {
      "name": "Il Capitano dello Zambesi",
      "description": "Tebogo, un capitano di barca, cerca di conciliare il suo dovere di trasportare merci con le scarse risorse della sua comunità durante una crisi economica."
    },
    "es": {
      "name": "El Capitán del Zambeze",
      "description": "Tebogo, un capitán de barco, intenta equilibrar su deber de transportar mercancías con la escasez de recursos de su comunidad durante una crisis económica."
    },
    "fr": {
      "name": "Le Capitaine du Zambèze",
      "description": "Tebogo, un capitaine de bateau, tente de concilier son devoir de transporteur avec la pauvreté de sa communauté durant une crise économique."
    },
    "hu": {
      "name": "A Zambézi kapitánya",
      "description": "Tebogo, a hajóskapitány, megpróbálja összeegyeztetni a szállítási kötelességét a közössége szűkös erőforrásaival egy gazdasági válság idején."
    },
    "pt": {
      "name": "O Capitão do Zambeze",
      "description": "Tebogo, um capitão de barco, tenta conciliar o seu dever de transportar mercadorias com a escassez de recursos da sua comunidade durante uma crise económica."
    }
  },
