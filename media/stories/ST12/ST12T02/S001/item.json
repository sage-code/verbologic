  "locales": {
    "en": {
      "name": "The Weaver of Waka",
      "description": "A Maori shipbuilder seeks spiritual guidance to carve a sacred waka, learning that true craftsmanship requires harmony with the forest and ancestral spirit."
    },
    "ro": {
      "name": "Țesătorul de Waka",
      "description": "Un constructor de ambarcațiuni maori caută îndrumare spirituală pentru a sculpta o waka sacră, învățând că adevărata măiestrie necesită armonie cu pădurea și spiritul strămoșilor."
    },
    "de": {
      "name": "Der Weber des Waka",
      "description": "Ein Maori-Schiffsbauer sucht spirituellen Beistand für den Bau eines heiligen Waka und erkennt, dass wahre Handwerkskunst Harmonie mit der Natur und den Ahnen erfordert."
    },
    "ru": {
      "name": "Ткач Вака",
      "description": "Маорийский кораблестроитель ищет духовного руководства для создания священного вака, осознавая, что истинное мастерство требует гармонии с лесом и духами предков."
    },
    "it": {
      "name": "Il Tessitore di Waka",
      "description": "Un costruttore di canoe maori cerca una guida spirituale per intagliare una waka sacra, imparando che la vera maestria richiede armonia con la foresta e lo spirito degli antenati."
    },
    "es": {
      "name": "El Tejedor de Waka",
      "description": "Un constructor de barcos maorí busca guía espiritual para tallar una waka sagrada, aprendiendo que la verdadera artesanía requiere armonía con el bosque y el espíritu de los ancestros."
    },
    "fr": {
      "name": "Le Tisseur de Waka",
      "description": "Un constructeur de navires maori cherche une guidance spirituelle pour sculpter une waka sacrée, apprenant que le véritable artisanat exige l'harmonie avec la forêt et l'esprit des ancêtres."
    },
    "hu": {
      "name": "A Waka Szövője",
      "description": "Egy maori hajóépítő lelki útmutatást keres egy szent waka kifaragásához, felismerve, hogy az igazi mesterségbeli tudás az erdővel és az ősök szellemével való harmóniát igényli."
    },
    "pt": {
      "name": "O Tecelão de Waka",
      "description": "Um construtor de barcos maori busca orientação espiritual para esculpir uma waka sagrada, aprendendo que a verdadeira arte exige harmonia com a floresta e o espírito dos ancestrais."
    }
  },
