  "locales": {
    "en": {
      "name": "The Lieutenant and the Sky Spirits",
      "description": "Major Batbayar must restore a sacred cairn during a blizzard to protect his camp from the wrath of the wind spirits."
    },
    "ro": {
      "name": "Maiorul și spiritele cerului",
      "description": "Maiorul Batbayar trebuie să restaureze un altar sacru în timpul unei viscole pentru a-și proteja tabăra de furia spiritelor vântului."
    },
    "de": {
      "name": "Der Major und die Geister des Himmels",
      "description": "Major Batbayar muss während eines Schneesturms einen heiligen Steinhaufen restaurieren, um sein Lager vor dem Zorn der Windgeister zu schützen."
    },
    "ru": {
      "name": "Майор и духи неба",
      "description": "Майор Батбаяр должен восстановить священную пирамиду из камней во время метели, чтобы защитить свой лагерь от гнева духов ветра."
    },
    "it": {
      "name": "Il tenente e gli spiriti del cielo",
      "description": "Il maggiore Batbayar deve restaurare un tumulo sacro durante una bufera per proteggere il suo accampamento dall'ira degli spiriti del vento."
    },
    "es": {
      "name": "El teniente y los espíritus del cielo",
      "description": "El mayor Batbayar debe restaurar un túmulo sagrado durante una ventisca para proteger su campamento de la ira de los espíritus del viento."
    },
    "fr": {
      "name": "Le lieutenant et les esprits du ciel",
      "description": "Le major Batbayar doit restaurer un cairn sacré pendant un blizzard pour protéger son camp de la colère des esprits du vent."
    },
    "hu": {
      "name": "A hadnagy és az ég szellemei",
      "description": "Batbayar őrnagynak egy hóvihar alatt kell helyreállítania egy szent kőhalmot, hogy megvédje táborát a szél szellemeinek haragjától."
    },
    "pt": {
      "name": "O tenente e os espíritos do céu",
      "description": "O major Batbayar deve restaurar um marco sagrado durante uma nevasca para proteger seu acampamento da ira dos espíritos do vento."
    }
  },
