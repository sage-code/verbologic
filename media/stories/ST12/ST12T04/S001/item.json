  "locales": {
    "en": {
      "name": "The Aviator of Tyre",
      "description": "Tanit navigates a fierce storm to deliver sacred temple offerings, discovering that faith is a steady hand amidst the winds of chaos."
    },
    "ro": {
      "name": "Aviatoarea din Tir",
      "description": "Tanit înfruntă o furtună năprasnică pentru a livra ofrande sacre, descoperind că credința este ancora care ne ține drepți în mijlocul haosului."
    },
    "de": {
      "name": "Die Fliegerin von Tyros",
      "description": "Tanit navigiert durch einen heftigen Sturm, um heilige Opfergaben zu überbringen, und erkennt, dass der Glaube eine ruhige Hand inmitten des Chaos ist."
    },
    "ru": {
      "name": "Авиатор из Тира",
      "description": "Танит преодолевает свирепый шторм, чтобы доставить священные дары, открывая, что вера — это твердая рука посреди ветров хаоса."
    },
    "it": {
      "name": "L'aviatrice di Tiro",
      "description": "Tanit naviga attraverso una tempesta feroce per consegnare offerte sacre, scoprendo che la fede è una mano ferma tra i venti del caos."
    },
    "es": {
      "name": "La aviadora de Tiro",
      "description": "Tanit navega a través de una feroz tormenta para entregar ofrendas sagradas, descubriendo que la fe es una mano firme en medio de los vientos del caos."
    },
    "fr": {
      "name": "L'aviatrice de Tyr",
      "description": "Tanit navigue à travers une tempête féroce pour livrer des offrandes sacrées, découvrant que la foi est une main ferme au milieu des vents du chaos."
    },
    "hu": {
      "name": "Türosz pilótája",
      "description": "Tanit egy heves viharon navigál keresztül, hogy eljuttassa a szent áldozati ajándékokat, felfedezve, hogy a hit egy biztos kéz a káosz szelei közepette."
    },
    "pt": {
      "name": "A Aviadora de Tiro",
      "description": "Tanit navega através de uma tempestade feroz para entregar oferendas sagradas, descobrindo que a fé é uma mão firme em meio aos ventos do caos."
    }
  },
