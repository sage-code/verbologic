  "locales": {
    "en": {
      "name": "The Measured Sanctity of Theron",
      "description": "A surveyor in ancient Greece confronts the tension between precise land measurement and the sacred silence of an unmapped mountain shrine."
    },
    "ro": {
      "name": "Sfințenia măsurată a lui Theron",
      "description": "Un agrimensor din Grecia antică se confruntă cu tensiunea dintre măsurătoarea precisă a pământului și tăcerea sacră a unui sanctuar montan nemarcat."
    },
    "de": {
      "name": "Therons vermessene Heiligkeit",
      "description": "Ein Landvermesser im antiken Griechenland ringt mit dem Spannungsfeld zwischen präziser Vermessung und der heiligen Stille eines unkartierten Bergheiligtums."
    },
    "ru": {
      "name": "Измеренная святость Терона",
      "description": "Землемер в Древней Греции сталкивается с противоречием между точным измерением земли и священной тишиной некартографированного горного святилища."
    },
    "it": {
      "name": "La santità misurata di Theron",
      "description": "Un agrimensore nell'antica Grecia affronta la tensione tra la misurazione precisa del terreno e il silenzio sacro di un santuario montano non mappato."
    },
    "es": {
      "name": "La santidad medida de Theron",
      "description": "Un agrimensor en la antigua Grecia se enfrenta a la tensión entre la medición precisa de la tierra y el silencio sagrado de un santuario montañoso sin cartografiar."
    },
    "fr": {
      "name": "La sainteté mesurée de Theron",
      "description": "Un arpenteur dans la Grèce antique affronte la tension entre la mesure précise des terres et le silence sacré d'un sanctuaire montagnard non cartographié."
    },
    "hu": {
      "name": "Theron mért szentsége",
      "description": "Egy földmérő az ókori Görögországban szembesül a föld pontos kimérése és egy feltérképezetlen hegyi szentély szent csendje közötti feszültséggel."
    },
    "pt": {
      "name": "A santidade medida de Theron",
      "description": "Um agrimensor na Grécia antiga enfrenta a tensão entre a medição precisa da terra e o silêncio sagrado de um santuário montanhoso não mapeado."
    }
  },
