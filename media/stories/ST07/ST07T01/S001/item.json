  "locales": {
    "en": {
      "name": "Red Dust Rescue",
      "description": "A brave pilot battles a fierce Martian dust storm to deliver vital medicine to a remote mining community."
    },
    "ro": {
      "name": "Salvarea în praful roșu",
      "description": "O pilotă curajoasă înfruntă o furtună marțiană violentă pentru a livra medicamente vitale unei comunități miniere izolate."
    },
    "de": {
      "name": "Rettung im roten Staub",
      "description": "Eine mutige Pilotin kämpft gegen einen heftigen Mars-Sturm, um lebenswichtige Medikamente zu einer abgelegenen Bergbausiedlung zu bringen."
    },
    "ru": {
      "name": "Спасение в красной пыли",
      "description": "Отважная пилотесса пробивается сквозь свирепую марсианскую пылевую бурю, чтобы доставить жизненно важные лекарства в отдаленное шахтерское поселение."
    },
    "it": {
      "name": "Salvataggio nella polvere rossa",
      "description": "Un'audace pilota affronta una feroce tempesta di polvere marziana per consegnare medicinali vitali a una remota comunità mineraria."
    },
    "es": {
      "name": "Rescate en el polvo rojo",
      "description": "Una valiente piloto lucha contra una feroz tormenta de polvo marciana para entregar medicamentos vitales a una remota comunidad minera."
    },
    "fr": {
      "name": "Sauvetage dans la poussière rouge",
      "description": "Une pilote courageuse affronte une violente tempête de poussière martienne pour livrer des médicaments vitaux à une communauté minière isolée."
    },
    "hu": {
      "name": "Mentés a vörös porban",
      "description": "Egy bátor pilótanő dacol a heves marsi porviharral, hogy létfontosságú gyógyszereket juttasson el egy távoli bányásztelepülésre."
    },
    "pt": {
      "name": "Resgate na poeira vermelha",
      "description": "Uma piloto corajosa enfrenta uma feroz tempestade de poeira marciana para entregar medicamentos vitais a uma remota comunidade mineira."
    }
  },
