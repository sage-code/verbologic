  "locales": {
    "en": {
      "name": "The Star-Forged Blade",
      "description": "Ilka, a mountain blacksmith, works with a dragon to forge a legendary sword from a fallen star for the young Queen Naomi."
    },
    "ro": {
      "name": "Sabia din stele",
      "description": "Ilka, o fierăriță de munte, lucrează alături de un dragon pentru a făuri o sabie legendară dintr-o stea căzătoare pentru tânăra regină Naomi."
    },
    "de": {
      "name": "Die sternengeschmiedete Klinge",
      "description": "Ilka, eine Schmiedin aus den Bergen, schmiedet gemeinsam mit einem Drachen ein legendäres Schwert aus einem gefallenen Stern für die junge Königin Naomi."
    },
    "ru": {
      "name": "Звездный клинок",
      "description": "Илка, горная кузнечиха, вместе с драконом выковывает легендарный меч из упавшей звезды для юной королевы Наоми."
    },
    "it": {
      "name": "La lama forgiata dalle stelle",
      "description": "Ilka, una fabbra di montagna, lavora con un drago per forgiare una spada leggendaria da una stella caduta per la giovane regina Naomi."
    },
    "es": {
      "name": "La hoja forjada en las estrellas",
      "description": "Ilka, una herrera de montaña, trabaja con un dragón para forjar una espada legendaria a partir de una estrella caída para la joven reina Naomi."
    },
    "fr": {
      "name": "La lame forgée par les étoiles",
      "description": "Ilka, une forgeronne de montagne, travaille avec un dragon pour forger une épée légendaire à partir d'une étoile tombée pour la jeune reine Naomi."
    },
    "hu": {
      "name": "A csillagkovácsolta penge",
      "description": "Ilka, a hegyi kovács, egy sárkánnyal dolgozik együtt, hogy egy lehullott csillagból legendás kardot kovácsoljon Naomi királynő számára."
    },
    "pt": {
      "name": "A lâmina forjada nas estrelas",
      "description": "Ilka, uma ferreira da montanha, trabalha com um dragão para forjar uma espada lendária a partir de uma estrela caída para a jovem rainha Naomi."
    }
  },
