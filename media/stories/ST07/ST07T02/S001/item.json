  "locales": {
    "en": {
      "name": "The Potter of Time",
      "description": "A Korean potter finds an ancient artifact that allows him to repair history by mending his broken pottery."
    },
    "ro": {
      "name": "Olarul Timpului",
      "description": "Un olar coreean găsește un obiect antic care îi permite să repare istoria prin restaurarea propriei sale ceramici."
    },
    "de": {
      "name": "Der Töpfer der Zeit",
      "description": "Ein koreanischer Töpfer findet ein altes Artefakt, das es ihm ermöglicht, die Geschichte durch das Reparieren seiner zerbrochenen Keramik zu heilen."
    },
    "ru": {
      "name": "Гончар времени",
      "description": "Корейский гончар находит древний артефакт, который позволяет ему исправлять историю, чиня свою разбитую керамику."
    },
    "it": {
      "name": "Il vasaio del tempo",
      "description": "Un vasaio coreano trova un antico artefatto che gli permette di riparare la storia riparando le sue ceramiche rotte."
    },
    "es": {
      "name": "El alfarero del tiempo",
      "description": "Un alfarero coreano encuentra un artefacto antiguo que le permite reparar la historia arreglando su cerámica rota."
    },
    "fr": {
      "name": "Le potier du temps",
      "description": "Un potier coréen trouve un artefacte ancien qui lui permet de réparer l'histoire en réparant ses poteries brisées."
    },
    "hu": {
      "name": "Az idő fazekasa",
      "description": "Egy koreai fazekas talál egy ősi tárgyat, amely lehetővé teszi számára, hogy a történelem menetét a törött kerámiái megjavításával korrigálja."
    },
    "pt": {
      "name": "O oleiro do tempo",
      "description": "Um oleiro coreano encontra um artefato antigo que lhe permite reparar a história consertando a sua cerâmica partida."
    }
  },
