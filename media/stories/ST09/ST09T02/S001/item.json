  "locales": {
    "en": {
      "name": "The Carpenter of the Siege",
      "description": "A master carpenter balances his duty to the army with his conscience while constructing siege engines for a medieval castle assault."
    },
    "ro": {
      "name": "Dulgherul Asediului",
      "description": "Un maestru dulgher își echilibrează datoria față de armată cu propria conștiință în timp ce construiește mașinării de asediu pentru cucerirea unui castel medieval."
    },
    "de": {
      "name": "Der Zimmermann der Belagerung",
      "description": "Ein Meisterzimmermann ringt mit seinem Gewissen, während er Belagerungsmaschinen für den Angriff auf eine mittelalterliche Burg baut."
    },
    "ru": {
      "name": "Плотник осады",
      "description": "Мастер-плотник пытается найти баланс между долгом перед армией и своей совестью, создавая осадные машины для штурма средневекового замка."
    },
    "it": {
      "name": "Il carpentiere dell'assedio",
      "description": "Un mastro carpentiere bilancia il suo dovere verso l'esercito con la propria coscienza mentre costruisce macchine d'assedio per l'assalto a un castello medievale."
    },
    "es": {
      "name": "El carpintero del asedio",
      "description": "Un maestro carpintero equilibra su deber hacia el ejército con su conciencia mientras construye máquinas de asedio para el asalto a un castillo medieval."
    },
    "fr": {
      "name": "Le charpentier du siège",
      "description": "Un maître charpentier concilie son devoir envers l'armée et sa conscience tout en construisant des engins de siège pour l'assaut d'un château médiéval."
    },
    "hu": {
      "name": "Az ostrom ácsa",
      "description": "Egy mesterács egyensúlyoz a hadsereg iránti kötelessége és a lelkiismerete között, miközben ostromgépeket épít egy középkori vár bevételéhez."
    },
    "pt": {
      "name": "O carpinteiro do cerco",
      "description": "Um mestre carpinteiro equilibra o seu dever para com o exército com a sua consciência enquanto constrói máquinas de cerco para o assalto a um castelo medieval."
    }
  },
