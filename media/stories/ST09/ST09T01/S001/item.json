  "locales": {
    "en": {
      "name": "The Iron Pulse",
      "description": "In a 1917 British workshop, a dedicated blacksmith repairs crucial tank parts, proving the vital importance of the home front's industrial efforts."
    },
    "ro": {
      "name": "Pulsul de Fier",
      "description": "Într-un atelier britanic din 1917, o fierăriță dedicată repară piese esențiale pentru tancuri, demonstrând importanța vitală a efortului industrial din spatele frontului."
    },
    "de": {
      "name": "Der eiserne Puls",
      "description": "In einer britischen Werkstatt im Jahr 1917 repariert eine engagierte Schmiedin wichtige Panzerteile und beweist damit die entscheidende Bedeutung der industriellen Anstrengungen an der Heimatfront."
    },
    "ru": {
      "name": "Железный пульс",
      "description": "В британской мастерской 1917 года преданная своему делу кузнец ремонтирует важнейшие детали танков, доказывая жизненную важность промышленных усилий тыла."
    },
    "it": {
      "name": "Il battito di ferro",
      "description": "In un'officina britannica del 1917, una fabbra dedicata ripara componenti cruciali per i carri armati, dimostrando l'importanza vitale dello sforzo industriale del fronte interno."
    },
    "es": {
      "name": "El pulso de hierro",
      "description": "En un taller británico de 1917, una dedicada herrera repara piezas cruciales de tanques, demostrando la importancia vital del esfuerzo industrial del frente interno."
    },
    "fr": {
      "name": "Le pouls de fer",
      "description": "Dans un atelier britannique de 1917, une forgeronne dévouée répare des pièces de chars cruciales, prouvant l'importance vitale de l'effort industriel à l'arrière."
    },
    "hu": {
      "name": "A vaslüktetés",
      "description": "Egy 1917-es brit műhelyben egy elhivatott kovácsnő kritikus harckocsi-alkatrészeket javít, bizonyítva a hátország ipari erőfeszítéseinek létfontosságú szerepét."
    },
    "pt": {
      "name": "O pulso de ferro",
      "description": "Numa oficina britânica de 1917, uma ferreira dedicada repara peças cruciais de tanques, provando a importância vital dos esforços industriais da frente interna."
    }
  },
