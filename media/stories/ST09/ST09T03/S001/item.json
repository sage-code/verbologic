  "locales": {
    "en": {
      "name": "The Fighting Girlfriend",
      "description": "Mariya Oktyabrskaya honors her fallen husband by becoming a skilled Soviet tank driver during the Second World War."
    },
    "ro": {
      "name": "Prietena de luptă",
      "description": "Mariya Oktyabrskaya își onorează soțul căzut la datorie devenind un tanchist sovietic iscusit în timpul celui de-al Doilea Război Mondial."
    },
    "de": {
      "name": "Die kämpfende Freundin",
      "description": "Mariya Oktyabrskaya ehrt ihren gefallenen Ehemann, indem sie im Zweiten Weltkrieg eine geschickte sowjetische Panzerfahrerin wird."
    },
    "ru": {
      "name": "Боевая подруга",
      "description": "Мария Октябрьская чтит память погибшего мужа, став искусным советским танкистом во время Второй мировой войны."
    },
    "it": {
      "name": "L'amica combattente",
      "description": "Mariya Oktyabrskaya onora il marito caduto diventando un'abile carrista sovietica durante la Seconda Guerra Mondiale."
    },
    "es": {
      "name": "La amiga combatiente",
      "description": "Mariya Oktyabrskaya honra a su marido caído convirtiéndose en una hábil conductora de tanques soviética durante la Segunda Guerra Mundial."
    },
    "fr": {
      "name": "L'amie combattante",
      "description": "Mariya Oktyabrskaya honore son mari tombé au combat en devenant une habile conductrice de char soviétique durant la Seconde Guerre mondiale."
    },
    "hu": {
      "name": "A harcoló barátnő",
      "description": "Mariya Oktyabrskaya elesett férje emlékét tiszteli azzal, hogy a második világháború alatt képzett szovjet harckocsizóvá válik."
    },
    "pt": {
      "name": "A amiga combatente",
      "description": "Mariya Oktyabrskaya honra o seu marido caído tornando-se uma habilidosa condutora de tanques soviética durante a Segunda Guerra Mundial."
    }
  },
