  "locales": {
    "en": {
      "name": "The Silent Hull",
      "description": "A dedicated ship's carpenter struggles to maintain the Victoria during Magellan's grueling circumnavigation of the globe."
    },
    "ro": {
      "name": "Coca tăcută",
      "description": "Un tâmplar dedicat se luptă să mențină nava Victoria în stare de funcționare în timpul dificilei călătorii în jurul lumii a lui Magellan."
    },
    "de": {
      "name": "Der stille Rumpf",
      "description": "Ein engagierter Schiffszimmermann kämpft darum, die Victoria während Magellans zermürbender Weltumsegelung instand zu halten."
    },
    "ru": {
      "name": "Безмолвный корпус",
      "description": "Преданный своему делу корабельный плотник пытается поддерживать «Викторию» в исправности во время изнурительного кругосветного плавания Магеллана."
    },
    "it": {
      "name": "Lo scafo silenzioso",
      "description": "Un carpentiere navale devoto lotta per mantenere la Victoria durante la logorante circumnavigazione del globo di Magellano."
    },
    "es": {
      "name": "El casco silencioso",
      "description": "Un dedicado carpintero naval lucha por mantener la Victoria durante la agotadora circunnavegación del globo de Magallanes."
    },
    "fr": {
      "name": "La coque silencieuse",
      "description": "Un charpentier de marine dévoué lutte pour maintenir le Victoria en état durant l'épuisant tour du monde de Magellan."
    },
    "hu": {
      "name": "A néma hajótest",
      "description": "Egy elhivatott hajóács küzd a Victoria épségének megőrzéséért Magellán embert próbáló világkörüli útja során."
    },
    "pt": {
      "name": "O casco silencioso",
      "description": "Um dedicado carpinteiro naval luta para manter o Victoria durante a exaustiva circum-navegação do globo de Magalhães."
    }
  },
