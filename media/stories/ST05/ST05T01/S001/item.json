  "locales": {
    "en": {
      "name": "The Stolen Well",
      "description": "Gita, a detective in a desert town, identifies a thief by noticing an unusual detail about a merchant's camel."
    },
    "ro": {
      "name": "Fântâna furată",
      "description": "Gita, o detectivă într-un oraș din deșert, găsește hoțul observând un detaliu neobișnuit la cămila unui negustor."
    },
    "de": {
      "name": "Der gestohlene Brunnen",
      "description": "Gita, eine Detektivin in einer Wüstenstadt, findet den Dieb, indem sie ein ungewöhnliches Detail am Kamel eines Händlers bemerkt."
    },
    "ru": {
      "name": "Украденный колодец",
      "description": "Гита, детектив в пустынном городе, находит вора, заметив необычную деталь у верблюда торговца."
    },
    "it": {
      "name": "Il pozzo rubato",
      "description": "Gita, una detective in una città nel deserto, identifica un ladro notando un dettaglio insolito sul cammello di un mercante."
    },
    "es": {
      "name": "El pozo robado",
      "description": "Gita, una detective en un pueblo del desierto, identifica a un ladrón al notar un detalle inusual en el camello de un comerciante."
    },
    "fr": {
      "name": "Le puits volé",
      "description": "Gita, une détective dans une ville du désert, identifie un voleur en remarquant un détail inhabituel sur le chameau d'un marchand."
    },
    "hu": {
      "name": "Az ellopott kút",
      "description": "Gita, egy nyomozó egy sivatagi városban, egy kereskedő tevéjén észrevett szokatlan részlet alapján azonosítja a tolvajt."
    },
    "pt": {
      "name": "O poço roubado",
      "description": "Gita, uma detetive numa cidade do deserto, identifica um ladrão ao notar um detalhe incomum no camelo de um mercador."
    }
  },
