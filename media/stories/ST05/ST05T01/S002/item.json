    "en": {
      "name": "The Painter's Secret",
      "description": "A taxi driver finds a lost briefcase and uncovers an art fraud by following clues left by a mysterious passenger."
    },
    "ro": {
      "name": "Secretul pictorului",
      "description": "O șoferiță de taxi găsește o servietă uitată și descoperă o fraudă artistică urmărind indiciile lăsate de un pasager misterios."
    },
    "de": {
      "name": "Das Geheimnis des Malers",
      "description": "Eine Taxifahrerin findet einen verlorenen Aktenkoffer und deckt einen Kunstbetrug auf, indem sie Hinweisen eines mysteriösen Fahrgastes folgt."
    },
    "ru": {
      "name": "Секрет художника",
      "description": "Водитель такси находит потерянный портфель и раскрывает арт-мошенничество, следуя подсказкам таинственного пассажира."
    },
    "it": {
      "name": "Il segreto del pittore",
      "description": "Una tassista trova una valigetta smarrita e scopre una frode artistica seguendo gli indizi lasciati da un passeggero misterioso."
    },
    "es": {
      "name": "El secreto del pintor",
      "description": "Una taxista encuentra un maletín perdido y descubre un fraude artístico siguiendo las pistas dejadas por un pasajero misterioso."
    },
    "fr": {
      "name": "Le secret du peintre",
      "description": "Une chauffeuse de taxi trouve une mallette perdue et découvre une fraude artistique en suivant les indices laissés par un passager mystérieux."
    },
    "hu": {
      "name": "A festő titka",
      "description": "Egy taxisnő talál egy elveszett aktatáskát, és leleplez egy művészeti csalást, követve a titokzatos utas által hagyott nyomokat."
    },
    "pt": {
      "name": "O segredo do pintor",
      "description": "Uma motorista de táxi encontra uma pasta perdida e descobre uma fraude artística seguindo pistas deixadas por um passageiro misterioso."
    }
  },
