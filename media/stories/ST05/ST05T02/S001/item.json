  "locales": {
    "en": {
      "name": "The Blacksmith of the Red Rocks",
      "description": "Talisa must solve a riddle about metal and heat to repair the village water gate before the desert sun becomes too hot."
    },
    "ro": {
      "name": "Fierarul de la Stâncile Roșii",
      "description": "Talisa trebuie să rezolve o ghicitoare despre metal și căldură pentru a repara poarta de apă a satului înainte ca soarele deșertului să devină prea fierbinte."
    },
    "de": {
      "name": "Die Schmiedin von den Roten Felsen",
      "description": "Talisa muss ein Rätsel über Metall und Hitze lösen, um das Wassertor des Dorfes zu reparieren, bevor die Wüstensonne zu heiß wird."
    },
    "ru": {
      "name": "Кузнец Красных Скал",
      "description": "Талиса должна решить загадку о металле и жаре, чтобы починить водяные ворота деревни, пока солнце пустыни не стало слишком жарким."
    },
    "it": {
      "name": "Il fabbro delle Rocce Rosse",
      "description": "Talisa deve risolvere un indovinello sul metallo e sul calore per riparare la porta dell'acqua del villaggio prima che il sole del deserto diventi troppo caldo."
    },
    "es": {
      "name": "El herrero de las Rocas Rojas",
      "description": "Talisa debe resolver un acertijo sobre metal y calor para reparar la puerta de agua del pueblo antes de que el sol del desierto sea demasiado fuerte."
    },
    "fr": {
      "name": "Le forgeron des Roches Rouges",
      "description": "Talisa doit résoudre une énigme sur le métal et la chaleur pour réparer la porte d'eau du village avant que le soleil du désert ne devienne trop brûlant."
    },
    "hu": {
      "name": "A Vörös Sziklák Kovácsa",
      "description": "Talisának meg kell oldania egy rejtvényt a fémről és a hőről, hogy megjavítsa a falu vízszabályozó kapuját, mielőtt a sivatagi nap túl forróvá válna."
    },
    "pt": {
      "name": "O Ferreiro das Rochas Vermelhas",
      "description": "Talisa deve resolver um enigma sobre metal e calor para reparar o portão de água da aldeia antes que o sol do deserto fique muito quente."
    }
  },
