  "locales": {
    "en": {
      "name": "The Scribe of Thebes",
      "description": "Nefertari, a teacher in ancient Thebes, helps a restless spirit find peace by correcting a mistake in a stone temple inscription."
    },
    "ro": {
      "name": "Scribul din Teba",
      "description": "Nefertari, o învățătoare din Teba antică, ajută un spirit neliniștit să-și găsească pacea corectând o greșeală într-o inscripție de pe peretele templului."
    },
    "de": {
      "name": "Der Schreiber von Theben",
      "description": "Nefertari, eine Lehrerin im alten Theben, hilft einem unruhigen Geist, Frieden zu finden, indem sie einen Fehler in einer Inschrift korrigiert."
    },
    "ru": {
      "name": "Писец из Фив",
      "description": "Нефертари, учительница в древних Фивах, помогает беспокойному духу обрести покой, исправляя ошибку в надписи на стене храма."
    },
    "it": {
      "name": "Lo scriba di Tebe",
      "description": "Nefertari, un'insegnante nell'antica Tebe, aiuta uno spirito inquieto a trovare pace correggendo un errore in un'iscrizione del tempio."
    },
    "es": {
      "name": "El escriba de Tebas",
      "description": "Nefertari, una maestra en la antigua Tebas, ayuda a un espíritu inquieto a encontrar la paz corrigiendo un error en una inscripción del templo."
    },
    "fr": {
      "name": "Le scribe de Thèbes",
      "description": "Nefertari, une enseignante dans l'ancienne Thèbes, aide un esprit agité à trouver la paix en corrigeant une erreur dans une inscription du temple."
    },
    "hu": {
      "name": "Théba írnoka",
      "description": "Nefertari, az ókori Théba tanítónője, segít egy nyugtalan szellemnek békére lelni azzal, hogy kijavít egy hibát a templom feliratán."
    },
    "pt": {
      "name": "O escriba de Tebas",
      "description": "Nefertari, uma professora na antiga Tebas, ajuda um espírito inquieto a encontrar a paz corrigindo um erro numa inscrição do templo."
    }
  },
