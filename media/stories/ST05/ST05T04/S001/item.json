  "locales": {
    "en": {
      "name": "The Silent Letter",
      "description": "A mountain mail carrier discovers a secret connection between an isolated village woman and her distant son."
    },
    "ro": {
      "name": "Scrisoarea tăcută",
      "description": "Un poștaș de munte descoperă legătura secretă dintre o femeie dintr-un sat izolat și fiul ei aflat departe."
    },
    "de": {
      "name": "Der stille Brief",
      "description": "Ein Bergpostbote entdeckt eine geheime Verbindung zwischen einer Frau in einem abgelegenen Dorf und ihrem fernen Sohn."
    },
    "ru": {
      "name": "Тихое письмо",
      "description": "Горный почтальон открывает тайную связь между женщиной из отдаленной деревни и ее далеким сыном."
    },
    "it": {
      "name": "La lettera silenziosa",
      "description": "Un postino di montagna scopre un legame segreto tra una donna di un villaggio isolato e il suo lontano figlio."
    },
    "es": {
      "name": "La carta silenciosa",
      "description": "Un cartero de montaña descubre una conexión secreta entre una mujer de un pueblo aislado y su hijo lejano."
    },
    "fr": {
      "name": "La lettre silencieuse",
      "description": "Un facteur de montagne découvre un lien secret entre une femme d'un village isolé et son fils lointain."
    },
    "hu": {
      "name": "A néma levél",
      "description": "Egy hegyi postás felfedezi a titkos kapcsolatot egy elszigetelt falusi asszony és a távol élő fia között."
    },
    "pt": {
      "name": "A carta silenciosa",
      "description": "Um carteiro da montanha descobre uma ligação secreta entre uma mulher de uma aldeia isolada e o seu filho distante."
    }
  },
