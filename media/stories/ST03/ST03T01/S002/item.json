    },
    "fr": {
      "name": "La pièce manquante du château",
      "description": "Leo et sa mère Maya font ensemble un puzzle de château, mais ils doivent trouver la dernière pièce avec leur chat Toby."
    },
    "hu": {
      "name": "A hiányzó várdarabka",
      "description": "Leo és az édesanyja, Maya együtt raknak ki egy váras kirakót, de meg kell találniuk az utolsó darabot a macskájukkal, Tobyval."
    },
    "pt": {
      "name": "A peça que falta do castelo",
      "description": "Leo e a sua mãe Maya montam juntos um quebra-cabeça de um castelo, mas precisam encontrar a última peça com o seu gato Toby."
    }
  },
