  "locales": {
    "en": {
      "name": "A Busy Morning for Lenka",
      "description": "Lenka helps her parents clean the house and learns that working together makes chores fun and fast."
    },
    "ro": {
      "name": "O dimineață ocupată pentru Lenka",
      "description": "Lenka își ajută părinții la curățenie și învață că munca în echipă face treaba mai ușoară și mai distractivă."
    },
    "de": {
      "name": "Ein geschäftiger Morgen für Lenka",
      "description": "Lenka hilft ihren Eltern beim Aufräumen und lernt, dass gemeinsame Arbeit Spaß macht und schnell geht."
    },
    "ru": {
      "name": "Утро Ленки",
      "description": "Ленка помогает родителям убираться в доме и понимает, что вместе работать весело и быстро."
    },
    "it": {
      "name": "Una mattinata impegnativa per Lenka",
      "description": "Lenka aiuta i genitori a pulire casa e impara che lavorare insieme rende le faccende divertenti e veloci."
    },
    "es": {
      "name": "Una mañana ocupada para Lenka",
      "description": "Lenka ayuda a sus padres a limpiar la casa y aprende que trabajar en equipo hace que las tareas sean divertidas y rápidas."
    },
    "fr": {
      "name": "Une matinée bien remplie pour Lenka",
      "description": "Lenka aide ses parents à faire le ménage et apprend que travailler ensemble rend les tâches amusantes et rapides."
    },
    "hu": {
      "name": "Lenka mozgalmas reggele",
      "description": "Lenka segít a szüleinek a takarításban, és megtanulja, hogy együtt dolgozni gyors és vidám dolog."
    },
    "pt": {
      "name": "Uma manhã ocupada para Lenka",
      "description": "Lenka ajuda os pais a limpar a casa e aprende que trabalhar em equipa torna as tarefas divertidas e rápidas."
    }
  },
