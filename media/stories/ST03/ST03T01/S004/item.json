  "locales": {
    "en": {
      "name": "A Garden Gift",
      "description": "Elio and his grandmother work together in the garden to grow fresh vegetables for their family dinner."
    },
    "ro": {
      "name": "Un dar din grădină",
      "description": "Elio și bunica lui lucrează împreună în grădină pentru a crește legume proaspete pentru cina familiei."
    },
    "de": {
      "name": "Ein Geschenk aus dem Garten",
      "description": "Elio und seine Großmutter arbeiten zusammen im Garten, um frisches Gemüse für das Abendessen der Familie anzubauen."
    },
    "ru": {
      "name": "Подарок из сада",
      "description": "Элио и его бабушка вместе работают в саду, чтобы вырастить свежие овощи для семейного ужина."
    },
    "it": {
      "name": "Un regalo dall'orto",
      "description": "Elio e la sua nonna lavorano insieme nell'orto per coltivare verdure fresche per la cena di famiglia."
    },
    "es": {
      "name": "Un regalo del jardín",
      "description": "Elio y su abuela trabajan juntos en el jardín para cultivar verduras frescas para la cena familiar."
    },
    "fr": {
      "name": "Un cadeau du jardin",
      "description": "Elio et sa grand-mère travaillent ensemble au jardin pour faire pousser des légumes frais pour le dîner en famille."
    },
    "hu": {
      "name": "Ajándék a kertből",
      "description": "Elio és a nagymamája együtt dolgoznak a kertben, hogy friss zöldségeket termesszenek a családi vacsorához."
    },
    "pt": {
      "name": "Um presente do jardim",
      "description": "Elio e a sua avó trabalham juntos no jardim para cultivar vegetais frescos para o jantar da família."
    }
  },
