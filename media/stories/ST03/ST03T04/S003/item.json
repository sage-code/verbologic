  "locales": {
    "en": {
      "name": "Marina and the Lost Map",
      "description": "Marina travels to a new city, but she loses her map and finds her way with the help of a kind friend."
    },
    "ro": {
      "name": "Marina și harta pierdută",
      "description": "Marina vizitează un oraș nou, dar își pierde harta. Un prieten neașteptat o ajută să găsească drumul."
    },
    "de": {
      "name": "Marina und die verlorene Karte",
      "description": "Marina reist in eine neue Stadt, verliert aber ihre Karte. Ein freundlicher Hund hilft ihr, den Weg zu finden."
    },
    "ru": {
      "name": "Марина и потерянная карта",
      "description": "Марина едет в новый город, но теряет карту. Добрый друг помогает ей найти дорогу."
    },
    "it": {
      "name": "Marina e la mappa perduta",
      "description": "Marina visita una nuova città, ma perde la sua mappa. Un amico gentile la aiuta a ritrovare la strada."
    },
    "es": {
      "name": "Marina y el mapa perdido",
      "description": "Marina viaja a una ciudad nueva, pero pierde su mapa. Un amigo amable le ayuda a encontrar el camino."
    },
    "fr": {
      "name": "Marina et la carte perdue",
      "description": "Marina voyage dans une nouvelle ville, mais elle perd sa carte. Un ami gentil l'aide à trouver son chemin."
    },
    "hu": {
      "name": "Marina és az elveszett térkép",
      "description": "Marina egy új városba utazik, de elveszíti a térképét. Egy kedves barát segít neki megtalálni az utat."
    },
    "pt": {
      "name": "Marina e o mapa perdido",
      "description": "Marina viaja para uma cidade nova, mas perde o seu mapa. Um amigo gentil ajuda-a a encontrar o caminho."
    }
  },
