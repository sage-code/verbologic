  "locales": {
    "en": {
      "name": "Aya and the Lost Map",
      "description": "Aya travels to a new city, but she loses her map and finds her way with the help of a kind friend."
    },
    "ro": {
      "name": "Aya și harta pierdută",
      "description": "Aya vizitează un oraș nou, dar își pierde harta. Un prieten nou o ajută să găsească drumul."
    },
    "de": {
      "name": "Aya und die verlorene Karte",
      "description": "Aya reist in eine neue Stadt, verliert aber ihre Karte. Ein freundlicher Hund hilft ihr, den Weg zu finden."
    },
    "ru": {
      "name": "Ая и потерянная карта",
      "description": "Ая приезжает в новый город, но теряет карту. Добрый друг помогает ей найти дорогу."
    },
    "it": {
      "name": "Aya e la mappa perduta",
      "description": "Aya viaggia in una nuova città, ma perde la sua mappa. Un amico gentile la aiuta a trovare la strada."
    },
    "es": {
      "name": "Aya y el mapa perdido",
      "description": "Aya viaja a una ciudad nueva, pero pierde su mapa. Un amigo amable la ayuda a encontrar el camino."
    },
    "fr": {
      "name": "Aya et la carte perdue",
      "description": "Aya voyage dans une nouvelle ville, mais elle perd sa carte. Un ami gentil l'aide à trouver son chemin."
    },
    "hu": {
      "name": "Aya és az elveszett térkép",
      "description": "Aya egy új városba utazik, de elveszíti a térképét. Egy kedves barát segít neki megtalálni az utat."
    },
    "pt": {
      "name": "Aya e o mapa perdido",
      "description": "Aya viaja para uma cidade nova, mas perde o seu mapa. Um amigo gentil ajuda-a a encontrar o caminho."
    }
  },
