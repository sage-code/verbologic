  "locales": {
    "en": {
      "name": "A Day at the Market",
      "description": "Joni travels to the city market, loses his map, and finds his way home with help from a friend."
    },
    "ro": {
      "name": "O zi la piață",
      "description": "Joni merge la piața din oraș, își pierde harta, dar găsește drumul spre casă cu ajutorul unui prieten."
    },
    "de": {
      "name": "Ein Tag auf dem Markt",
      "description": "Joni besucht den Stadtmarkt, verliert seine Karte, findet aber mit Hilfe eines Freundes den Weg nach Hause."
    },
    "ru": {
      "name": "День на рынке",
      "description": "Йони едет на городской рынок, теряет карту, но находит дорогу домой с помощью друга."
    },
    "it": {
      "name": "Una giornata al mercato",
      "description": "Joni va al mercato della città, perde la sua mappa, ma trova la strada di casa grazie a un amico."
    },
    "es": {
      "name": "Un día en el mercado",
      "description": "Joni viaja al mercado de la ciudad, pierde su mapa, pero encuentra el camino a casa con la ayuda de un amigo."
    },
    "fr": {
      "name": "Une journée au marché",
      "description": "Joni va au marché de la ville, perd sa carte, mais trouve le chemin du retour avec l'aide d'un ami."
    },
    "hu": {
      "name": "Egy nap a piacon",
      "description": "Joni elutazik a városi piacra, elveszíti a térképét, de egy barát segítségével hazatalál."
    },
    "pt": {
      "name": "Um dia no mercado",
      "description": "Joni viaja para o mercado da cidade, perde o seu mapa, mas encontra o caminho de casa com a ajuda de um amigo."
    }
  },
