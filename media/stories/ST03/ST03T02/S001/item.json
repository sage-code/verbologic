  "locales": {
    "en": {
      "name": "A Lost Balloon",
      "description": "A girl named Joy loses her red balloon in the busy town but finds it with the help of a kind baker."
    },
    "ro": {
      "name": "Balonul pierdut",
      "description": "O fetiță pe nume Joy își pierde balonul roșu în oraș, dar un brutar amabil o ajută să îl recupereze."
    },
    "de": {
      "name": "Ein verlorener Luftballon",
      "description": "Ein Mädchen namens Joy verliert ihren roten Luftballon in der Stadt, aber ein netter Bäcker hilft ihr."
    },
    "ru": {
      "name": "Потерянный шарик",
      "description": "Девочка по имени Джой теряет свой красный шарик в городе, но добрый пекарь помогает ей."
    },
    "it": {
      "name": "Un palloncino perduto",
      "description": "Una bambina di nome Joy perde il suo palloncino rosso in città, ma un gentile fornaio la aiuta."
    },
    "es": {
      "name": "Un globo perdido",
      "description": "Una niña llamada Joy pierde su globo rojo en la ciudad, pero un amable panadero la ayuda."
    },
    "fr": {
      "name": "Un ballon perdu",
      "description": "Une fille nommée Joy perd son ballon rouge en ville, mais un gentil boulanger l'aide."
    },
    "hu": {
      "name": "Egy elveszett lufi",
      "description": "Egy Joy nevű kislány elveszíti a piros lufiját a városban, de egy kedves pék segít neki."
    },
    "pt": {
      "name": "Um balão perdido",
      "description": "Uma menina chamada Joy perde o seu balão vermelho na cidade, mas um padeiro gentil ajuda-a."
    }
  },
