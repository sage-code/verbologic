  "locales": {
    "en": {
      "name": "Alba and the Mountain Hawk",
      "description": "Alba helps a wounded hawk in her mountain home so that it can return to the sky."
    },
    "ro": {
      "name": "Alba și șoimul muntelui",
      "description": "Alba ajută un șoim rănit în casa ei de la munte pentru ca acesta să se poată întoarce pe cer."
    },
    "de": {
      "name": "Alba und der Bergfalke",
      "description": "Alba hilft einem verletzten Falken in ihrem Zuhause in den Bergen, damit er wieder in den Himmel fliegen kann."
    },
    "ru": {
      "name": "Альба и горный сокол",
      "description": "Альба помогает раненому соколу в своем горном доме, чтобы он мог вернуться в небо."
    },
    "it": {
      "name": "Alba e il falco di montagna",
      "description": "Alba aiuta un falco ferito nella sua casa di montagna affinché possa tornare a volare nel cielo."
    },
    "es": {
      "name": "Alba y el halcón de la montaña",
      "description": "Alba ayuda a un halcón herido en su casa de la montaña para que pueda volver al cielo."
    },
    "fr": {
      "name": "Alba et le faucon de la montagne",
      "description": "Alba aide un faucon blessé dans sa maison de montagne pour qu'il puisse retourner dans le ciel."
    },
    "hu": {
      "name": "Alba és a hegyi sólyom",
      "description": "Alba segít egy sérült sólyomnak a hegyi otthonában, hogy visszatérhessen az égbe."
    },
    "pt": {
      "name": "Alba e o falcão da montanha",
      "description": "Alba ajuda um falcão ferido na sua casa na montanha para que ele possa voltar ao céu."
    }
  },
