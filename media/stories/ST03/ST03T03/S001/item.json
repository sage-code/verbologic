  "locales": {
    "en": {
      "name": "Kira and the Lost Seed",
      "description": "Kira finds a lonely seed and helps it grow into a beautiful sunflower in her garden."
    },
    "ro": {
      "name": "Kira și sămânța pierdută",
      "description": "Kira găsește o sămânță singuratică și o ajută să crească într-o floarea-soarelui frumoasă în grădina ei."
    },
    "de": {
      "name": "Kira und der verlorene Samen",
      "description": "Kira findet einen einsamen Samen und hilft ihm, in ihrem Garten zu einer schönen Sonnenblume zu wachsen."
    },
    "ru": {
      "name": "Кира и потерянное семечко",
      "description": "Кира находит одинокое семечко и помогает ему вырасти в красивый подсолнух в её саду."
    },
    "it": {
      "name": "Kira e il seme perduto",
      "description": "Kira trova un seme solitario e lo aiuta a diventare un bellissimo girasole nel suo giardino."
    },
    "es": {
      "name": "Kira y la semilla perdida",
      "description": "Kira encuentra una semilla solitaria y la ayuda a convertirse en un hermoso girasol en su jardín."
    },
    "fr": {
      "name": "Kira et la graine perdue",
      "description": "Kira trouve une graine solitaire et l'aide à devenir un beau tournesol dans son jardin."
    },
    "hu": {
      "name": "Kira és az elveszett mag",
      "description": "Kira talál egy magányos magot, és segít neki gyönyörű napraforgóvá nőni a kertjében."
    },
    "pt": {
      "name": "Kira e a semente perdida",
      "description": "Kira encontra uma semente solitária e ajuda-a a crescer num lindo girassol no seu jardim."
    }
  },
