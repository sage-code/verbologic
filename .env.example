# Copy to `.env` and fill in. `.env` is gitignored.
# NOTE: Nuxt reads NUXT_PUBLIC_* (not Next.js-style NEXT_PUBLIC_*).

# Supabase project URL (Dashboard → Project Settings → Data API).
NUXT_PUBLIC_SUPABASE_URL=

# Supabase publishable key (sb_publishable_… — browser-safe; RLS protects data).
# Supabase deprecates the legacy `anon` JWT in favour of this key (end of 2026).
NUXT_PUBLIC_SUPABASE_ANON_KEY=

# Cloudflare R2 media sync (scripts/media-sync.mjs — `run media verify --remote`,
# `run media upload --apply`, `run media prune --apply`). S3-compatible API,
# signed with SigV4 — from the bucket's own API token, NOT a general Cloudflare
# API token (dash.cloudflare.com → R2 → <bucket> → Manage API tokens → Create
# API token, with a bucket-scoped read/write token; the dashboard then shows
# the Access Key ID / Secret Access Key / endpoint below).
CLOUDFLARE_ACCOUNT_ID=
R2_BUCKET=verbologic
R2_S3_ENDPOINT=
R2_S3_ACCESS_KEY_ID=
R2_S3_SECRET_ACCESS_KEY=