# Supabase Edge Function secrets — copy to `supabase/functions/.env` (gitignored).
# Push to the remote project with:  supabase secrets set --env-file supabase/functions/.env
# See planning/paypall_settings.md for how to obtain each value.
#
# NEVER put these in the root `.env` — Nuxt bakes that file into the public bundle.

# PayPal REST app credentials (Developer Dashboard → Apps & Credentials).
# Sandbox and Live apps have separate values.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Which PayPal environment the functions talk to: `sandbox` or `live`.
PAYPAL_ENV=sandbox

# Webhook ID from the app's Webhooks section — used to verify event signatures.
PAYPAL_WEBHOOK_ID=
