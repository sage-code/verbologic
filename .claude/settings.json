{
  "permissions": {
    "allow": ["Bash(git status)",
      "Bash(git status *)",
      "Bash(git diff)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git add *)",
      "Bash(git check-ignore *)",
      "Bash(git rm *)",
      "Bash(ls)",
      "Bash(ls *)",
      "Bash(node -v)",
      "Bash(./run help)",
      "Bash(./run status)",
      "Bash(./run validate)",
      "Bash(./run validate *)",
      "Bash(./run tsc)",
      "Bash(./run tsc *)",
      "Bash(./run missing)",
      "Bash(./run missing *)",
      "Bash(./run build)",
      "Bash(./run build *)",
      "Bash(./run clean)",
      "Bash(./run deploy-dry)",
      "Bash(./run media verify)",
      "Bash(./run media verify *)",
      "Bash(./run media manifest --dry-run)"
     ],
    "ask": [
      "Bash(./run commit *)",
      "Bash(./run push)",
      "Bash(./run clean)"
    ],
    "deny": [
      "Read(./.data/**)",
      "Read(./LICENSE)",
      "Read(./package-lock.json)",
      "Read(./.output/**)",
      "Read(./.nuxt/**)",
      "Read(./archive/**)",
      "Read(./media/**)",
      "Read(./public/data/media/index.json)",
      "Read(./public/data/media/library/**/search.json)",
      "Read(./**/*.sqlite)",
      "Read(./.agents/**/CHANGELOG.md)",
      "Bash(npx nuxi generate*)",
      "Bash(npx nuxt generate*)",
      "Bash(rm -R*)"
    ]
  }
}
