    "en": "The four seasons",
    "es": "Las cuatro estaciones",
    "it": "Le quattro stagioni",
    "fr": "Les quatre saisons",
    "de": "Die vier Jahreszeiten",
    "ru": "Четыре времени года",
    "hu": "A négy évszak",
    "pt": "As quatro estações",
