    "en": "The simple future",
    "es": "El futuro simple",
    "it": "Il futuro semplice",
    "fr": "Le futur simple",
    "de": "Das einfache Futur",
    "ru": "Простое будущее время",
    "hu": "Az egyszerű jövő idő",
