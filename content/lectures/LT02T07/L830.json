  "locales": {
    "en": {
      "title": "Indefinite and negative pronouns",
      "summary": "These pronouns refer to people or things without saying which, or say that there are none.",
      "status": "draft",
      "sections": [
        {
          "title": "What it is",
          "blocks": [
            {
              "type": "paragraphs",
              "paragraphs": [
                "An indefinite pronoun refers to a person or thing without saying which one. A negative pronoun says that there is none."
              ]
            },
            {
              "type": "bullets",
              "items": [
                "**Someone** called.",
                "**Everything** is ready.",
                "**Nobody** came."
              ]
            }
          ]
        },
        {
          "title": "How it works in English",
          "blocks": [
            {
              "type": "paragraphs",
              "paragraphs": [
                "These pronouns combine some, any, every and no with one, body, thing and where. Use some in positive sentences and any in negatives and questions. Standard English does not allow a double negative."
              ]
            },
            {
              "type": "table",
              "html": "<table><thead><tr><th>some-</th><th>any-</th><th>no-</th></tr></thead><tbody><tr><td><strong>someone</strong></td><td><strong>anyone</strong></td><td><strong>no one</strong></td></tr><tr><td><strong>something</strong></td><td><strong>anything</strong></td><td><strong>nothing</strong></td></tr><tr><td><strong>somewhere</strong></td><td><strong>anywhere</strong></td><td><strong>nowhere</strong></td></tr></tbody></table>"
            }
          ]
        }
      ]
    }
  }
}
