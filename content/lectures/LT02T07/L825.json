  "locales": {
    "en": {
      "title": "Reciprocal pronouns",
      "summary": "Each other and one another show an action done both ways.",
      "status": "draft",
      "sections": [
        {
          "title": "What it is",
          "blocks": [
            {
              "type": "paragraphs",
              "paragraphs": [
                "Reciprocal pronouns show that two or more people do the same thing to each other. English has each other and one another."
              ]
            },
            {
              "type": "bullets",
              "items": [
                "They help **each other**.",
                "We often see **one another**.",
                "The twins look at **each other**."
              ]
            }
          ]
        },
        {
          "title": "How it works in English",
          "blocks": [
            {
              "type": "paragraphs",
              "paragraphs": [
                "Each other and one another mean the same in everyday English. Both have a possessive form: each other's."
              ]
            },
            {
              "type": "table",
              "html": "<table><thead><tr><th>Use</th><th>Example</th></tr></thead><tbody><tr><td>two people</td><td><strong>They love each other.</strong></td></tr><tr><td>a group</td><td><strong>We help one another.</strong></td></tr><tr><td>possessive</td><td><strong>They borrow each other's books.</strong></td></tr></tbody></table>"
            }
          ]
        }
      ]
    }
  }
}
