  "locales": {
    "en": {
      "title": "Diminutives and augmentatives",
      "summary": "English has few diminutive endings and prefers adjectives to show size.",
      "status": "draft",
      "sections": [
        {
          "title": "What it is",
          "blocks": [
            {
              "type": "paragraphs",
              "paragraphs": [
                "A diminutive makes a word smaller or more affectionate. An augmentative makes it bigger."
              ]
            },
            {
              "type": "bullets",
              "items": [
                "pig**let**, book**let**",
                "dog**gie**, kitt**y**",
                "a **huge** house"
              ]
            }
          ]
        },
        {
          "title": "How it works in English",
          "blocks": [
            {
              "type": "paragraphs",
              "paragraphs": [
                "English has few diminutive endings, such as -let, -ie and -y. For size it more often uses adjectives, such as little, tiny and huge, than endings. Many diminutives are used for names, or when speaking to children."
              ]
            },
            {
              "type": "table",
              "html": "<table><thead><tr><th>Ending</th><th>Example</th></tr></thead><tbody><tr><td><strong>-let</strong></td><td><strong>piglet, booklet</strong></td></tr><tr><td><strong>-ie, -y</strong></td><td><strong>doggie, Johnny</strong></td></tr><tr><td>adjective</td><td><strong>a tiny cat, a huge cat</strong></td></tr></tbody></table>"
            }
          ]
        }
      ]
    }
  }
}
