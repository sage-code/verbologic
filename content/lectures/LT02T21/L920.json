  "terms": {
    "en": "Suffixes",
    "es": "Los sufijos",
    "it": "I suffissi",
    "fr": "Les suffixes",
    "de": "Suffixe",
    "ru": "Суффиксы",
    "hu": "Az utótagok",
    "pt": "Os sufixos",
    "ro": "Sufixele"
  },
  "locales": {
    "en": {
      "title": "Suffixes",
      "summary": "A suffix is added to the end of a word and often changes its class.",
      "status": "draft",
      "sections": [
        {
          "title": "What it is",
          "blocks": [
            {
              "type": "paragraphs",
              "paragraphs": [
                "A suffix is a group of letters added to the end of a word. A suffix often changes the word class: a verb becomes a noun (teach → teacher), a noun becomes an adjective (hope → hopeful), an adjective becomes an adverb (quick → quickly)."
              ]
            },
            {
              "type": "bullets",
              "items": [
                "teach → teach**er**",
                "hope → hope**ful**",
                "happy → happi**ness**",
                "quick → quick**ly**"
              ]
            }
          ]
        },
        {
          "title": "Noun suffixes",
          "blocks": [
            {
              "type": "table",
              "html": "<table><thead><tr><th>Suffix</th><th>Meaning</th><th>Examples</th></tr></thead><tbody><tr><td><strong>-er / -or</strong></td><td>a person who does</td><td><strong>teacher, actor, driver</strong></td></tr><tr><td><strong>-ist</strong></td><td>a person with a skill or belief</td><td><strong>artist, scientist</strong></td></tr><tr><td><strong>-ness</strong></td><td>a state or quality</td><td><strong>happiness, kindness</strong></td></tr><tr><td><strong>-ion / -tion</strong></td><td>an action or result</td><td><strong>decision, education</strong></td></tr><tr><td><strong>-ment</strong></td><td>an action or result</td><td><strong>movement, agreement</strong></td></tr><tr><td><strong>-ity</strong></td><td>a quality</td><td><strong>ability, equality</strong></td></tr><tr><td><strong>-ship</strong></td><td>a condition or skill</td><td><strong>friendship, leadership</strong></td></tr></tbody></table>"
            }
          ]
        },
        {
          "title": "Adjective and adverb suffixes",
          "blocks": [
            {
              "type": "table",
              "html": "<table><thead><tr><th>Suffix</th><th>Class</th><th>Examples</th></tr></thead><tbody><tr><td><strong>-ful</strong></td><td>adjective (full of)</td><td><strong>helpful, careful</strong></td></tr><tr><td><strong>-less</strong></td><td>adjective (without)</td><td><strong>hopeless, careless</strong></td></tr><tr><td><strong>-able / -ible</strong></td><td>adjective (can be)</td><td><strong>readable, possible</strong></td></tr><tr><td><strong>-ous</strong></td><td>adjective</td><td><strong>dangerous, famous</strong></td></tr><tr><td><strong>-al</strong></td><td>adjective</td><td><strong>national, musical</strong></td></tr><tr><td><strong>-ive</strong></td><td>adjective</td><td><strong>active, creative</strong></td></tr><tr><td><strong>-ly</strong></td><td>adverb</td><td><strong>quickly, carefully</strong></td></tr></tbody></table>"
            }
          ]
        },
        {
          "title": "Verb suffixes",
          "blocks": [
            {
              "type": "bullets",
              "items": [
                "**-ise / -ize**: modernise, organise, realise",
                "**-ify**: simplify, clarify",
                "**-en**: widen, shorten, strengthen"
              ]
            }
          ]
        },
        {
          "title": "Spelling changes",
          "blocks": [
            {
              "type": "bullets",
              "items": [
                "Drop final -e before a suffix that begins with a vowel: **hope → hoping**, but keep it before a consonant: **hope → hopeful**.",
                "Change -y to -i- before a suffix: **happy → happiness, easy → easily**.",
                "Double the final consonant after a short stressed vowel: **run → runner, big → bigger**."
              ]
            }
          ]
        },
        {
          "title": "Common mistakes",
          "blocks": [
            {
              "type": "bullets",
              "items": [
                "Wrong: **a hopefull person** Right: **hopeful**",
                "Wrong: **happyness** Right: **happiness**",
                "Wrong: **He drived carefuly.** Right: **carefully**"
              ]
            }
          ]
        }
      ]
    },
    "ro": {
      "title": "Sufixele",
      "summary": "Sufixul este un grup de litere adăugat la sfârșitul unui cuvânt pentru a forma cuvinte noi.",
      "status": "draft",
      "sections": [
        {
          "title": "Ce este",
          "blocks": [
            {
              "type": "paragraphs",
              "paragraphs": [
                "Un sufix este un grup de litere adăugat la sfârșitul unui cuvânt. El creează un cuvânt nou, cu un sens diferit. De multe ori, sufixul schimbă și partea de vorbire. Astfel, dintr-un substantiv putem obține un adjectiv sau un verb."
              ]
            },
            {
              "type": "bullets",
              "items": [
                "El este un **grădinar** priceput.",
                "Câinele vecinului este foarte **prietenos**.",
                "Toți oamenii admiră această **bunătate**."
              ]
            }
          ]
        },
        {
          "title": "Cum funcționează în română",
          "blocks": [
            {
              "type": "paragraphs",
              "paragraphs": [
                "Adăugăm sufixul după rădăcina cuvântului de bază. Uneori, sunetul final se modifică puțin pentru o pronunțare mai ușoară. Folosim sufixe specifice pentru a forma diminutive, nume de meserii, calități sau verbe. Sufixul oferă mereu o nuanță nouă sensului inițial."
              ]
            },
            {
              "type": "table",
              "html": "<table><thead><tr><th>Sufix</th><th>Cuvânt de bază</th><th>Cuvânt nou</th></tr></thead><tbody><tr><td><strong>-ar</strong></td><td><strong>cizmă</strong></td><td><strong>cizmar</strong></td></tr><tr><td><strong>-os</strong></td><td><strong>curaj</strong></td><td><strong>curajos</strong></td></tr><tr><td><strong>-iță</strong></td><td><strong>fată</strong></td><td><strong>fetiță</strong></td></tr><tr><td><strong>-ime</strong></td><td><strong>tânăr</strong></td><td><strong>tinerime</strong></td></tr><tr><td><strong>-iza</strong></td><td><strong>modern</strong></td><td><strong>a moderniza</strong></td></tr></tbody></table>"
            }
          ]
        }
      ]
    }
  }
}
