  "locales": {
    "en": {
      "title": "Suffixes",
      "summary": "A suffix is added to the end of a word and often changes its class.",
      "status": "draft",
      "sections": [
        {
          "title": "What it is",
          "blocks": [
            {
              "type": "paragraphs",
              "paragraphs": [
                "A suffix is added to the end of a word. It often changes the word class."
              ]
            },
            {
              "type": "bullets",
              "items": [
                "teach → teach**er**",
                "care → care**ful**",
                "happy → happi**ness**"
              ]
            }
          ]
        },
        {
          "title": "How it works in English",
          "blocks": [
            {
              "type": "paragraphs",
              "paragraphs": [
                "Suffixes make nouns (-er, -ness, -tion), adjectives (-ful, -less, -able) and adverbs (-ly). The spelling may change: y becomes i before a suffix."
              ]
            },
            {
              "type": "table",
              "html": "<table><thead><tr><th>Suffix</th><th>Makes</th><th>Example</th></tr></thead><tbody><tr><td><strong>-er, -or</strong></td><td>a person</td><td><strong>teacher, actor</strong></td></tr><tr><td><strong>-ness, -tion</strong></td><td>a noun</td><td><strong>kindness, action</strong></td></tr><tr><td><strong>-ful, -less</strong></td><td>an adjective</td><td><strong>useful, useless</strong></td></tr><tr><td><strong>-ly</strong></td><td>an adverb</td><td><strong>slowly</strong></td></tr></tbody></table>"
            }
          ]
        }
      ]
    }
  }
}
