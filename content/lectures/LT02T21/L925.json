    "en": {
      "title": "Idioms and fixed expressions",
      "summary": "An idiom is a fixed group of words whose meaning is not the sum of its parts.",
      "status": "draft",
      "sections": [
        {
          "title": "What it is",
          "blocks": [
            {
              "type": "paragraphs",
              "paragraphs": [
                "An idiom is a fixed group of words whose meaning is not the sum of its parts."
              ]
            },
            {
              "type": "bullets",
              "items": [
                "**break the ice**",
                "**it's raining cats and dogs**",
                "**a piece of cake**"
              ]
            }
          ]
        },
        {
          "title": "How it works in English",
          "blocks": [
            {
              "type": "paragraphs",
              "paragraphs": [
                "Idioms usually cannot be changed word by word. Learn them as units, with the verb that goes with them. Fixed expressions also include collocations such as make a decision and do the dishes."
              ]
            },
            {
              "type": "table",
              "html": "<table><thead><tr><th>Idiom</th><th>Meaning</th></tr></thead><tbody><tr><td><strong>break the ice</strong></td><td>start a conversation</td></tr><tr><td><strong>a piece of cake</strong></td><td>very easy</td></tr><tr><td><strong>under the weather</strong></td><td>slightly ill</td></tr></tbody></table>"
            }
          ]
        }
      ]
    }
  }
