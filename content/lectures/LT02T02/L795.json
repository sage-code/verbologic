  "locales": {
    "en": {
      "title": "Interjections and particles",
      "summary": "An interjection shows a sudden feeling; a particle is a small grammatical word.",
      "status": "draft",
      "sections": [
        {
          "title": "What it is",
          "blocks": [
            {
              "type": "paragraphs",
              "paragraphs": [
                "An interjection shows a sudden feeling and stands outside the grammar of the sentence. A particle is a small word that does a grammatical job but does not fit the other classes."
              ]
            },
            {
              "type": "bullets",
              "items": [
                "**Wow!** That is huge.",
                "**Ouch!** My foot!",
                "**Well**, I am not sure."
              ]
            }
          ]
        },
        {
          "title": "How it works in English",
          "blocks": [
            {
              "type": "paragraphs",
              "paragraphs": [
                "The **to** of an infinitive and the **not** of a negative are often called particles. An interjection is followed by an exclamation mark or a comma."
              ]
            },
            {
              "type": "table",
              "html": "<table><thead><tr><th>Word</th><th>Job</th></tr></thead><tbody><tr><td><strong>to</strong> in *to swim*</td><td>marks the infinitive</td></tr><tr><td><strong>not</strong></td><td>makes the verb negative</td></tr><tr><td><strong>oh, hey, hello</strong></td><td>interjections</td></tr></tbody></table>"
            }
          ]
        }
      ]
    }
  }
}
