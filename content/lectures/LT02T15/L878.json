    "en": "Obligation and necessity",
    "es": "Obligación y necesidad",
    "it": "Obbligo e necessità",
    "fr": "Obligation et nécessité",
    "de": "Pflicht und Notwendigkeit",
    "ru": "Долженствование и необходимость",
    "hu": "Kötelezettség és szükségszerűség",
    "pt": "Obrigação e necessidade",
