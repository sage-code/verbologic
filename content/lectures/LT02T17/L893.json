    "en": {
      "title": "Prepositions of time",
      "summary": "Prepositions of time tell when something happens.",
      "status": "draft",
      "sections": [
        {
          "title": "What it is",
          "blocks": [
            {
              "type": "paragraphs",
              "paragraphs": [
                "Prepositions of time tell when something happens."
              ]
            },
            {
              "type": "bullets",
              "items": [
                "at **nine o'clock**",
                "on **Sunday**",
                "in **July**"
              ]
            }
          ]
        },
        {
          "title": "How it works in English",
          "blocks": [
            {
              "type": "paragraphs",
              "paragraphs": [
                "Use at for clock times, on for days and dates, and in for months, seasons, years and parts of the day. Use for with a length of time and since with a starting point."
              ]
            },
            {
              "type": "table",
              "html": "<table><thead><tr><th>Preposition</th><th>Use</th><th>Example</th></tr></thead><tbody><tr><td><strong>at</strong></td><td>clock time</td><td><strong>at noon</strong></td></tr><tr><td><strong>on</strong></td><td>day, date</td><td><strong>on Friday</strong></td></tr><tr><td><strong>in</strong></td><td>month, year</td><td><strong>in 2020</strong></td></tr><tr><td><strong>for, since</strong></td><td>duration</td><td><strong>for a week, since May</strong></td></tr></tbody></table>"
            }
          ]
        }
      ]
    }
  }
