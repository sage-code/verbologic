    "en": {
      "title": "Prepositions of direction and movement",
      "summary": "Prepositions of direction tell where something moves.",
      "status": "draft",
      "sections": [
        {
          "title": "What it is",
          "blocks": [
            {
              "type": "paragraphs",
              "paragraphs": [
                "Prepositions of direction tell where something moves."
              ]
            },
            {
              "type": "bullets",
              "items": [
                "He walked **to** the door.",
                "She jumped **into** the lake.",
                "The train goes **through** a tunnel."
              ]
            }
          ]
        },
        {
          "title": "How it works in English",
          "blocks": [
            {
              "type": "paragraphs",
              "paragraphs": [
                "To shows the destination and from shows the starting point. Into and out of show entering and leaving. Across goes from one side to the other, and along follows a line."
              ]
            },
            {
              "type": "table",
              "html": "<table><thead><tr><th>Preposition</th><th>Example</th></tr></thead><tbody><tr><td><strong>to, from</strong></td><td><strong>from Paris to Rome</strong></td></tr><tr><td><strong>into, out of</strong></td><td><strong>into the car</strong></td></tr><tr><td><strong>across, along</strong></td><td><strong>across the bridge</strong></td></tr><tr><td><strong>up, down</strong></td><td><strong>up the stairs</strong></td></tr></tbody></table>"
            }
          ]
        }
      ]
    }
  }
