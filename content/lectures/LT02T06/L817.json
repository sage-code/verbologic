  "terms": {
    "en": "Subject pronouns",
    "es": "Los pronombres de sujeto",
    "it": "I pronomi soggetto",
    "fr": "Les pronoms sujets",
    "de": "Subjektpronomen",
    "ru": "Местоимения в роли подлежащего",
    "hu": "Alanyi névmások",
    "pt": "Os pronomes de sujeito",
    "ro": "Pronumele subiect"
  },
  "locales": {
    "en": {
      "title": "Subject pronouns",
      "summary": "Subject pronouns stand for the person or thing that does the action.",
      "status": "draft",
      "sections": [
        {
          "title": "What it is",
          "blocks": [
            {
              "type": "paragraphs",
              "paragraphs": [
                "Subject pronouns stand for the person or thing that does the action. English has I, you, he, she, it, we and they."
              ]
            },
            {
              "type": "bullets",
              "items": [
                "**I** work here.",
                "**She** reads a lot.",
                "**They** are late."
              ]
            }
          ]
        },
        {
          "title": "How it works in English",
          "blocks": [
            {
              "type": "paragraphs",
              "paragraphs": [
                "A subject pronoun is almost always required in English. The word you is the same for one person and for many."
              ]
            },
            {
              "type": "table",
              "html": "<table><thead><tr><th>Person</th><th>Singular</th><th>Plural</th></tr></thead><tbody><tr><td>first</td><td><strong>I</strong></td><td><strong>we</strong></td></tr><tr><td>second</td><td><strong>you</strong></td><td><strong>you</strong></td></tr><tr><td>third</td><td><strong>he, she, it</strong></td><td><strong>they</strong></td></tr></tbody></table>"
            }
          ]
        }
      ]
    },
    "ro": {
      "title": "Pronumele subiect",
      "summary": "Pronumele subiect arată cine face acțiunea, dar în limba română îl folosim rar.",
      "status": "draft",
      "sections": [
        {
          "title": "Ce este",
          "blocks": [
            {
              "type": "paragraphs",
              "paragraphs": [
                "Pronumele subiect arată cine face acțiunea verbului. Aceste cuvinte înlocuiesc numele unei persoane sau al unui lucru. În limba română, forma verbului arată deja cine face acțiunea. De aceea, folosim pronumele subiect mai ales pentru a sublinia persoana."
              ]
            },
            {
              "type": "bullets",
              "items": [
                "**Eu** lucrez aici în fiecare zi.",
                "**Ea** citește o carte nouă.",
                "**Ei** sosesc acum la gară."
              ]
            }
          ]
        },
        {
          "title": "Cum funcționează în română",
          "blocks": [
            {
              "type": "paragraphs",
              "paragraphs": [
                "Pronumele își schimbă forma după persoană și număr. La persoana a treia, avem forme pentru masculin și feminin. În vorbire, omitem des pronumele și folosim doar verbul."
              ]
            },
            {
              "type": "table",
              "html": "<table><thead><tr><th>Persoană</th><th>Singular</th><th>Plural</th></tr></thead><tbody><tr><td><strong>Persoana I</strong></td><td><strong>eu</strong></td><td><strong>noi</strong></td></tr><tr><td><strong>Persoana a II-a</strong></td><td><strong>tu</strong></td><td><strong>voi</strong></td></tr><tr><td><strong>Persoana a III-a</strong></td><td><strong>el, ea</strong></td><td><strong>ei, ele</strong></td></tr></tbody></table>"
            }
          ]
        }
      ]
    }
  }
}
