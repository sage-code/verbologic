  "terms": {
    "en": "Singular and plural",
    "es": "Singular y plural",
    "it": "Singolare e plurale",
    "fr": "Singulier et pluriel",
    "de": "Singular und Plural",
    "ru": "Единственное и множественное число",
    "hu": "Egyes és többes szám",
    "pt": "Singular e plural",
    "ro": "Singularul și pluralul"
  },
  "locales": {
    "en": {
      "title": "Singular and plural",
      "summary": "English nouns have two numbers, singular and plural, and most add -s.",
      "status": "draft",
      "sections": [
        {
          "title": "What it is",
          "blocks": [
            {
              "type": "paragraphs",
              "paragraphs": [
                "Number tells us whether a noun means one thing or more than one. English has two numbers: singular and plural."
              ]
            },
            {
              "type": "bullets",
              "items": [
                "one **book**, two **books**",
                "one **box**, two **boxes**",
                "one **baby**, two **babies**"
              ]
            }
          ]
        },
        {
          "title": "How it works in English",
          "blocks": [
            {
              "type": "paragraphs",
              "paragraphs": [
                "Most nouns add -s. Nouns ending in s, x, z, ch or sh add -es. Nouns ending in a consonant and y change y to ies."
              ]
            },
            {
              "type": "table",
              "html": "<table><thead><tr><th>Rule</th><th>Singular</th><th>Plural</th></tr></thead><tbody><tr><td>add -s</td><td><strong>cat</strong></td><td><strong>cats</strong></td></tr><tr><td>add -es</td><td><strong>bus</strong></td><td><strong>buses</strong></td></tr><tr><td>y becomes ies</td><td><strong>city</strong></td><td><strong>cities</strong></td></tr><tr><td>vowel and y: add -s</td><td><strong>day</strong></td><td><strong>days</strong></td></tr></tbody></table>"
            }
          ]
        }
      ]
    },
    "ro": {
      "title": "Singularul și pluralul",
      "summary": "Substantivele din limba română au două numere: singular pentru un lucru și plural pentru mai multe lucruri.",
      "status": "draft",
      "sections": [
        {
          "title": "Ce este",
          "blocks": [
            {
              "type": "paragraphs",
              "paragraphs": [
                "Numărul substantivului arată cantitatea. Singularul reprezintă un singur lucru sau o singură ființă. Pluralul reprezintă două sau mai multe lucruri sau ființe."
              ]
            },
            {
              "type": "bullets",
              "items": [
                "Aici este un **băiat**, iar acolo sunt doi **băieți**.",
                "Am o **carte** nouă și două **cărți** vechi.",
                "Cumpăr un **scaun** mare și trei **scaune** mici."
              ]
            }
          ]
        },
        {
          "title": "Cum funcționează în română",
          "blocks": [
            {
              "type": "paragraphs",
              "paragraphs": [
                "Forma de plural depinde de genul substantivului. Substantivele masculine primesc de obicei terminația -i. Substantivele feminine primesc cel mai des terminațiile -e sau -i. Substantivele neutre primesc des terminațiile -uri sau -e."
              ]
            },
            {
              "type": "table",
              "html": "<table><thead><tr><th>Gen și terminație</th><th>Singular</th><th>Plural</th></tr></thead><tbody><tr><td><strong>Masculin (-i)</strong></td><td><strong>băiat</strong></td><td><strong>băieți</strong></td></tr><tr><td><strong>Feminin (-e)</strong></td><td><strong>casă</strong></td><td><strong>case</strong></td></tr><tr><td><strong>Feminin (-i)</strong></td><td><strong>carte</strong></td><td><strong>cărți</strong></td></tr><tr><td><strong>Neutru (-uri)</strong></td><td><strong>tren</strong></td><td><strong>trenuri</strong></td></tr><tr><td><strong>Neutru (-e)</strong></td><td><strong>scaun</strong></td><td><strong>scaune</strong></td></tr></tbody></table>"
            }
          ]
        }
      ]
    }
  }
}
