  "terms": {
    "en": "Gender of nouns",
    "es": "El género de los sustantivos",
    "it": "Il genere dei nomi",
    "fr": "Le genre des noms",
    "de": "Das Genus der Substantive",
    "ru": "Род существительных",
    "hu": "A főnevek neme",
    "pt": "O gênero dos substantivos",
    "ro": "Genul substantivelor"
  },
  "locales": {
    "en": {
      "title": "Gender of nouns",
      "summary": "English nouns have no grammatical gender; only the pronouns show natural gender.",
      "status": "draft",
      "sections": [
        {
          "title": "What it is",
          "blocks": [
            {
              "type": "paragraphs",
              "paragraphs": [
                "Many languages give every noun a grammatical gender. English does not. Its nouns have no gender, and the pronouns he, she and it show natural gender."
              ]
            },
            {
              "type": "bullets",
              "items": [
                "a **boy** — **he**",
                "a **girl** — **she**",
                "a **table** — **it**"
              ]
            }
          ]
        },
        {
          "title": "How it works in English",
          "blocks": [
            {
              "type": "paragraphs",
              "paragraphs": [
                "A few nouns for people have separate male and female forms, such as actor and actress. Today many speakers prefer a single neutral word."
              ]
            },
            {
              "type": "table",
              "html": "<table><thead><tr><th>Male</th><th>Female</th><th>Neutral</th></tr></thead><tbody><tr><td><strong>waiter</strong></td><td><strong>waitress</strong></td><td><strong>server</strong></td></tr><tr><td><strong>actor</strong></td><td><strong>actress</strong></td><td><strong>actor</strong></td></tr><tr><td><strong>host</strong></td><td><strong>hostess</strong></td><td><strong>host</strong></td></tr></tbody></table>"
            }
          ]
        }
      ]
    },
    "ro": {
      "title": "Genul substantivelor",
      "summary": "În limba română, fiecare substantiv are un gen: masculin, feminin sau neutru.",
      "status": "draft",
      "sections": [
        {
          "title": "Ce este",
          "blocks": [
            {
              "type": "paragraphs",
              "paragraphs": [
                "Substantivul este cuvântul care denumește o ființă sau un lucru. În limba română, toate substantivele au un gen gramatical. Genurile sunt masculin, feminin și neutru."
              ]
            },
            {
              "type": "bullets",
              "items": [
                "Aici este un **băiat** înalt.",
                "Acolo este o **fată** veselă.",
                "Pe masă este un **măr** roșu."
              ]
            }
          ]
        },
        {
          "title": "Cum funcționează în română",
          "blocks": [
            {
              "type": "paragraphs",
              "paragraphs": [
                "Aflăm genul când numărăm substantivul la singular și la plural. La masculin numărăm cu: un, doi. La feminin numărăm cu: o, două. La neutru numărăm cu: un, două."
              ]
            },
            {
              "type": "table",
              "html": "<table><thead><tr><th>Gen</th><th>Singular</th><th>Plural</th></tr></thead><tbody><tr><td><strong>Masculin</strong></td><td><strong>un băiat</strong></td><td><strong>doi băieți</strong></td></tr><tr><td><strong>Masculin</strong></td><td><strong>un frate</strong></td><td><strong>doi frați</strong></td></tr><tr><td><strong>Feminin</strong></td><td><strong>o fată</strong></td><td><strong>două fete</strong></td></tr><tr><td><strong>Feminin</strong></td><td><strong>o carte</strong></td><td><strong>două cărți</strong></td></tr><tr><td><strong>Neutru</strong></td><td><strong>un scaun</strong></td><td><strong>două scaune</strong></td></tr><tr><td><strong>Neutru</strong></td><td><strong>un măr</strong></td><td><strong>două mere</strong></td></tr></tbody></table>"
            }
          ]
        }
      ]
    }
  }
}
