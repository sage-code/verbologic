  "locales": {
    "en": {
      "title": "Verb classes and conjugations",
      "summary": "English verbs are not sorted into conjugations; they differ in how they form the past.",
      "status": "draft",
      "sections": [
        {
          "title": "What it is",
          "blocks": [
            {
              "type": "paragraphs",
              "paragraphs": [
                "In some languages verbs fall into groups called conjugations, each with its own endings. English has no conjugations in this sense."
              ]
            },
            {
              "type": "bullets",
              "items": [
                "**love, loves, loved**",
                "**walk, walks, walked**",
                "**study, studies, studied**"
              ]
            }
          ]
        },
        {
          "title": "How it works in English",
          "blocks": [
            {
              "type": "paragraphs",
              "paragraphs": [
                "English verbs can be grouped by how they form the past: regular verbs with -ed, and irregular verbs that change a vowel or stay the same. Spelling rules add small changes, such as y becoming ie before -s."
              ]
            },
            {
              "type": "table",
              "html": "<table><thead><tr><th>Group</th><th>Example</th></tr></thead><tbody><tr><td>regular -ed</td><td><strong>play, played</strong></td></tr><tr><td>vowel change</td><td><strong>sing, sang, sung</strong></td></tr><tr><td>no change</td><td><strong>put, put, put</strong></td></tr><tr><td>spelling change</td><td><strong>carry, carried</strong></td></tr></tbody></table>"
            }
          ]
        }
      ]
    }
  }
}
