    "en": "Transitive and intransitive verbs",
    "es": "Verbos transitivos e intransitivos",
    "it": "Verbi transitivi e intransitivi",
    "fr": "Verbes transitifs et intransitifs",
    "de": "Transitive und intransitive Verben",
    "ru": "Переходные и непереходные глаголы",
    "hu": "Tárgyas és tárgyatlan igék",
