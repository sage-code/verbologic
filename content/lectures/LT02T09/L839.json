  "terms": {
    "en": "Stem and endings",
    "es": "Raíz y terminaciones",
    "it": "Radice e desinenze",
    "fr": "Radical et terminaisons",
    "de": "Stamm und Endungen",
    "ru": "Основа и окончания",
    "hu": "Tő és ragok",
    "pt": "Radical e terminações",
    "ro": "Tema și terminațiile"
  },
  "locales": {
    "en": {
      "title": "Stem and endings",
      "summary": "A verb has a stem that carries the meaning and endings that carry grammar.",
      "status": "draft",
      "sections": [
        {
          "title": "What it is",
          "blocks": [
            {
              "type": "paragraphs",
              "paragraphs": [
                "A verb has a stem, which carries the meaning, and it can take endings that carry grammar."
              ]
            },
            {
              "type": "bullets",
              "items": [
                "walk + **s** = walks",
                "walk + **ed** = walked",
                "walk + **ing** = walking"
              ]
            }
          ]
        },
        {
          "title": "How it works in English",
          "blocks": [
            {
              "type": "paragraphs",
              "paragraphs": [
                "English verbs have few endings: -s for the third person singular, -ed for the past and -ing for continuous forms. The base form is the same as the stem."
              ]
            },
            {
              "type": "table",
              "html": "<table><thead><tr><th>Ending</th><th>Meaning</th><th>Example</th></tr></thead><tbody><tr><td><strong>-s</strong></td><td>he, she, it, present</td><td><strong>walks</strong></td></tr><tr><td><strong>-ed</strong></td><td>past</td><td><strong>walked</strong></td></tr><tr><td><strong>-ing</strong></td><td>continuous</td><td><strong>walking</strong></td></tr></tbody></table>"
            }
          ]
        }
      ]
    },
    "ro": {
      "title": "Tema și terminațiile",
      "summary": "Verbul are o rădăcină fixă și terminații care se schimbă pentru fiecare persoană.",
      "status": "draft",
      "sections": [
        {
          "title": "Ce este",
          "blocks": [
            {
              "type": "paragraphs",
              "paragraphs": [
                "Un verb este format din două părți principale. Rădăcina sau tema conține înțelesul de bază al cuvântului. Terminația adăugată la sfârșit arată persoana și timpul acțiunii."
              ]
            },
            {
              "type": "bullets",
              "items": [
                "Noi **lucrăm** la birou.",
                "Voi **lucrați** în grădină.",
                "Ei **lucrează** împreună."
              ]
            }
          ]
        },
        {
          "title": "Cum funcționează în română",
          "blocks": [
            {
              "type": "paragraphs",
              "paragraphs": [
                "Păstrăm tema verbului și adăugăm terminații diferite. Fiecare persoană are propria terminație în limba română. Astfel, terminația ne arată clar cine face acțiunea."
              ]
            },
            {
              "type": "table",
              "html": "<table><thead><tr><th>Rădăcină</th><th>Terminație</th><th>Formă completă</th></tr></thead><tbody><tr><td><strong>lucr-</strong></td><td><strong>-ez</strong></td><td><strong>eu lucrez</strong></td></tr><tr><td><strong>lucr-</strong></td><td><strong>-ează</strong></td><td><strong>el lucrează</strong></td></tr><tr><td><strong>lucr-</strong></td><td><strong>-ăm</strong></td><td><strong>noi lucrăm</strong></td></tr><tr><td><strong>lucr-</strong></td><td><strong>-ați</strong></td><td><strong>voi lucrați</strong></td></tr></tbody></table>"
            }
          ]
        }
      ]
    }
  }
}
