  "terms": {
    "en": "Person and number",
    "es": "Persona y número",
    "it": "Persona e numero",
    "fr": "Personne et nombre",
    "de": "Person und Numerus",
    "ru": "Лицо и число",
    "hu": "Személy és szám",
    "pt": "Pessoa e número",
    "ro": "Persoana și numărul"
  },
  "locales": {
    "en": {
      "title": "Person and number",
      "summary": "Person and number show who does the action and how many.",
      "status": "draft",
      "sections": [
        {
          "title": "What it is",
          "blocks": [
            {
              "type": "paragraphs",
              "paragraphs": [
                "Person tells who is speaking, who is spoken to and who is spoken about. Number tells whether it is one or more than one."
              ]
            },
            {
              "type": "bullets",
              "items": [
                "**I** walk.",
                "**He** walks.",
                "**They** walk."
              ]
            }
          ]
        },
        {
          "title": "How it works in English",
          "blocks": [
            {
              "type": "paragraphs",
              "paragraphs": [
                "English verbs change only in the third person singular of the present: I walk, but she walks. The verb be has more forms: am, is, are, was and were."
              ]
            },
            {
              "type": "table",
              "html": "<table><thead><tr><th>Person</th><th>Singular</th><th>Plural</th></tr></thead><tbody><tr><td>first</td><td><strong>I walk</strong></td><td><strong>we walk</strong></td></tr><tr><td>second</td><td><strong>you walk</strong></td><td><strong>you walk</strong></td></tr><tr><td>third</td><td><strong>she walks</strong></td><td><strong>they walk</strong></td></tr></tbody></table>"
            }
          ]
        }
      ]
    },
    "ro": {
      "title": "Persoana și numărul",
      "summary": "Persoana și numărul arată cine face acțiunea și dacă aceasta este realizată de o persoană sau de mai multe.",
      "status": "draft",
      "sections": [
        {
          "title": "Ce este",
          "blocks": [
            {
              "type": "paragraphs",
              "paragraphs": [
                "Persoana arată cine face acțiunea verbului. Numărul arată dacă acțiunea este făcută de o singură persoană sau de mai multe. Avem persoana întâi, a doua și a treia, la singular și la plural."
              ]
            },
            {
              "type": "bullets",
              "items": [
                "Eu **merg** la școală pe jos.",
                "Tu **mergi** foarte repede astăzi.",
                "Noi **mergem** împreună la magazin."
              ]
            }
          ]
        },
        {
          "title": "Cum funcționează în română",
          "blocks": [
            {
              "type": "paragraphs",
              "paragraphs": [
                "În limba română, verbul își schimbă forma în funcție de persoană și număr. Terminația arată cine face acțiunea. Din acest motiv, pronumele personal este de obicei omis."
              ]
            },
            {
              "type": "table",
              "html": "<table><thead><tr><th>Persoana</th><th>Singular</th><th>Plural</th></tr></thead><tbody><tr><td><strong>Persoana I (eu / noi)</strong></td><td><strong>cânt</strong></td><td><strong>cântăm</strong></td></tr><tr><td><strong>Persoana a II-a (tu / voi)</strong></td><td><strong>cânți</strong></td><td><strong>cântați</strong></td></tr><tr><td><strong>Persoana a III-a (el, ea / ei, ele)</strong></td><td><strong>cântă</strong></td><td><strong>cântă</strong></td></tr></tbody></table>"
            }
          ]
        }
      ]
    }
  }
}
