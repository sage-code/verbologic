    "en": "The comparative",
    "es": "El comparativo",
    "it": "Il comparativo",
    "fr": "Le comparatif",
    "de": "Der Komparativ",
    "ru": "Сравнительная степень",
    "hu": "A középfok",
    "pt": "O comparativo",
