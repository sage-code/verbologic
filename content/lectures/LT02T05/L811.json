  "terms": {
    "en": "Agreement with the noun",
    "es": "La concordancia con el sustantivo",
    "it": "L'accordo con il nome",
    "fr": "L'accord avec le nom",
    "de": "Übereinstimmung mit dem Substantiv",
    "ru": "Согласование с существительным",
    "hu": "Egyeztetés a főnévvel",
    "pt": "A concordância com o substantivo",
    "ro": "Acordul cu substantivul"
  },
  "locales": {
    "en": {
      "title": "Agreement with the noun",
      "summary": "English adjectives do not change to agree with their noun.",
      "status": "draft",
      "sections": [
        {
          "title": "What it is",
          "blocks": [
            {
              "type": "paragraphs",
              "paragraphs": [
                "In many languages an adjective changes to agree with its noun. In English it never does."
              ]
            },
            {
              "type": "bullets",
              "items": [
                "a **small** boy",
                "a **small** girl",
                "two **small** children"
              ]
            }
          ]
        },
        {
          "title": "How it works in English",
          "blocks": [
            {
              "type": "paragraphs",
              "paragraphs": [
                "An English adjective has the same form for singular and plural and for male and female. Only the demonstratives this and that change for number."
              ]
            },
            {
              "type": "table",
              "html": "<table><thead><tr><th>Singular</th><th>Plural</th></tr></thead><tbody><tr><td><strong>a new car</strong></td><td><strong>new cars</strong></td></tr><tr><td><strong>this red apple</strong></td><td><strong>these red apples</strong></td></tr></tbody></table>"
            }
          ]
        }
      ]
    },
    "ro": {
      "title": "Acordul cu substantivul",
      "summary": "În limba română, adjectivul își schimbă forma după genul și numărul substantivului pe care îl descrie.",
      "status": "draft",
      "sections": [
        {
          "title": "Ce este",
          "blocks": [
            {
              "type": "paragraphs",
              "paragraphs": [
                "Adjectivul este un cuvânt care descrie un substantiv. În limba română, adjectivul se acordă mereu cu substantivul. El își schimbă terminația după gen și număr."
              ]
            },
            {
              "type": "bullets",
              "items": [
                "Un băiat **frumos** se plimbă.",
                "O fată **frumoasă** se plimbă.",
                "Doi băieți **frumoși** se plimbă."
              ]
            }
          ]
        },
        {
          "title": "Cum funcționează în română",
          "blocks": [
            {
              "type": "paragraphs",
              "paragraphs": [
                "Adjectivul se așază de obicei după substantiv. Forma lui se schimbă la masculin, feminin și neutru. La plural, terminația adjectivului se schimbă din nou."
              ]
            },
            {
              "type": "table",
              "html": "<table><thead><tr><th>Gen</th><th>Singular</th><th>Plural</th></tr></thead><tbody><tr><td><strong>Masculin</strong></td><td><strong>băiat bun</strong></td><td><strong>băieți buni</strong></td></tr><tr><td><strong>Feminin</strong></td><td><strong>fată bună</strong></td><td><strong>fete bune</strong></td></tr><tr><td><strong>Neutru</strong></td><td><strong>scaun bun</strong></td><td><strong>scaune bune</strong></td></tr></tbody></table>"
            }
          ]
        }
      ]
    }
  }
}
