  "terms": {
    "en": "The superlative",
    "es": "El superlativo",
    "it": "Il superlativo",
    "fr": "Le superlatif",
    "de": "Der Superlativ",
    "ru": "Превосходная степень",
    "hu": "A felsőfok",
    "pt": "O superlativo",
    "ro": "Superlativul"
  },
  "locales": {
    "en": {
      "title": "The superlative",
      "summary": "The superlative says that one thing is first in a group.",
      "status": "draft",
      "sections": [
        {
          "title": "What it is",
          "blocks": [
            {
              "type": "paragraphs",
              "paragraphs": [
                "The superlative says that one thing is first in a group: the highest, the best, the most."
              ]
            },
            {
              "type": "bullets",
              "items": [
                "Everest is **the highest** mountain.",
                "She is **the cleverest** student.",
                "This is **the most useful** tool."
              ]
            }
          ]
        },
        {
          "title": "How it works in English",
          "blocks": [
            {
              "type": "paragraphs",
              "paragraphs": [
                "Short adjectives add -est and long adjectives use most. Always put the before a superlative, and use in or of to name the group."
              ]
            },
            {
              "type": "table",
              "html": "<table><thead><tr><th>Rule</th><th>Adjective</th><th>Superlative</th></tr></thead><tbody><tr><td>add -est</td><td><strong>old</strong></td><td><strong>the oldest</strong></td></tr><tr><td>double the consonant</td><td><strong>hot</strong></td><td><strong>the hottest</strong></td></tr><tr><td>use most</td><td><strong>expensive</strong></td><td><strong>the most expensive</strong></td></tr></tbody></table>"
            }
          ]
        }
      ]
    },
    "ro": {
      "title": "Superlativul",
      "summary": "Superlativul arată că o ființă sau un lucru are o însușire la cel mai înalt grad.",
      "status": "draft",
      "sections": [
        {
          "title": "Ce este",
          "blocks": [
            {
              "type": "paragraphs",
              "paragraphs": [
                "Superlativul arată că un element se află pe primul loc într-un grup. El exprimă gradul maxim al unei calități atunci când comparăm un element cu toate celelalte."
              ]
            },
            {
              "type": "bullets",
              "items": [
                "Everestul este **cel mai înalt** munte.",
                "Ana este **cea mai deșteaptă** elevă.",
                "Acesta este **cel mai util** obiect."
              ]
            }
          ]
        },
        {
          "title": "Cum funcționează în română",
          "blocks": [
            {
              "type": "paragraphs",
              "paragraphs": [
                "În limba română folosim formele „cel mai”, „cea mai”, „cei mai” sau „cele mai”. Alegem forma potrivită în funcție de genul și numărul substantivului, urmată de adjectiv."
              ]
            },
            {
              "type": "table",
              "html": "<table><thead><tr><th>Gen și număr</th><th>Adjectiv</th><th>Superlativ</th></tr></thead><tbody><tr><td><strong>Masculin singular</strong></td><td><strong>bun</strong></td><td><strong>cel mai bun</strong></td></tr><tr><td><strong>Feminin singular</strong></td><td><strong>bună</strong></td><td><strong>cea mai bună</strong></td></tr><tr><td><strong>Masculin plural</strong></td><td><strong>buni</strong></td><td><strong>cei mai buni</strong></td></tr><tr><td><strong>Feminin plural</strong></td><td><strong>bune</strong></td><td><strong>cele mai bune</strong></td></tr></tbody></table>"
            }
          ]
        }
      ]
    }
  }
}
