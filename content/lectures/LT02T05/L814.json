  },
  "locales": {
    "en": {
      "title": "The superlative",
      "summary": "The superlative says that one thing is first in a group.",
      "status": "draft",
      "sections": [
        {
          "title": "What it is",
          "blocks": [
            {
              "type": "paragraphs",
              "paragraphs": [
                "The superlative says that one thing is first in a group: the highest, the best, the most."
              ]
            },
            {
              "type": "bullets",
              "items": [
                "Everest is **the highest** mountain.",
                "She is **the cleverest** student.",
                "This is **the most useful** tool."
              ]
            }
          ]
        },
        {
          "title": "How it works in English",
          "blocks": [
            {
              "type": "paragraphs",
              "paragraphs": [
                "Short adjectives add -est and long adjectives use most. Always put the before a superlative, and use in or of to name the group."
              ]
            },
            {
              "type": "table",
              "html": "<table><thead><tr><th>Rule</th><th>Adjective</th><th>Superlative</th></tr></thead><tbody><tr><td>add -est</td><td><strong>old</strong></td><td><strong>the oldest</strong></td></tr><tr><td>double the consonant</td><td><strong>hot</strong></td><td><strong>the hottest</strong></td></tr><tr><td>use most</td><td><strong>expensive</strong></td><td><strong>the most expensive</strong></td></tr></tbody></table>"
            }
          ]
        }
      ]
    }
  }
}
