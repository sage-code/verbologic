  "terms": {
    "en": "Adjectives made from other words",
    "es": "Adjetivos formados a partir de otras palabras",
    "it": "Aggettivi formati da altre parole",
    "fr": "Adjectifs formés à partir d'autres mots",
    "de": "Aus anderen Wörtern gebildete Adjektive",
    "ru": "Прилагательные, образованные от других слов",
    "hu": "Más szavakból képzett melléknevek",
    "pt": "Adjetivos formados a partir de outras palavras",
    "ro": "Adjective formate din alte cuvinte"
  },
  "locales": {
    "en": {
      "title": "Adjectives made from other words",
      "summary": "Many adjectives are built from nouns and verbs with an ending.",
      "status": "draft",
      "sections": [
        {
          "title": "What it is",
          "blocks": [
            {
              "type": "paragraphs",
              "paragraphs": [
                "Many adjectives are made from nouns or verbs by adding an ending."
              ]
            },
            {
              "type": "bullets",
              "items": [
                "**rain** → **rainy**",
                "**care** → **careful**",
                "**read** → **readable**"
              ]
            }
          ]
        },
        {
          "title": "How it works in English",
          "blocks": [
            {
              "type": "paragraphs",
              "paragraphs": [
                "Common endings are -y, -ful, -less, -able, -ous and -ish. The -ing and -ed forms of verbs also work as adjectives, as in a boring film and a broken window."
              ]
            },
            {
              "type": "table",
              "html": "<table><thead><tr><th>Ending</th><th>Example</th></tr></thead><tbody><tr><td>-y</td><td><strong>sunny</strong></td></tr><tr><td>-ful, -less</td><td><strong>helpful, helpless</strong></td></tr><tr><td>-able</td><td><strong>comfortable</strong></td></tr><tr><td>-ing, -ed</td><td><strong>boring, bored</strong></td></tr></tbody></table>"
            }
          ]
        }
      ]
    },
    "ro": {
      "title": "Adjective formate din alte cuvinte",
      "summary": "În limba română, multe adjective se formează din substantive sau verbe prin adăugarea unor sufixe specifice.",
      "status": "draft",
      "sections": [
        {
          "title": "Ce este",
          "blocks": [
            {
              "type": "paragraphs",
              "paragraphs": [
                "În limba română, putem crea adjective din alte cuvinte. Multe adjective se formează din substantive sau din verbe. Adăugăm la sfârșitul cuvântului grupuri speciale de litere, numite sufixe."
              ]
            },
            {
              "type": "bullets",
              "items": [
                "Astăzi avem o vreme **călduroasă**.",
                "Maria este o colegă **prietenoasă**.",
                "Andrei este un băiat **muncitor**."
              ]
            }
          ]
        },
        {
          "title": "Cum funcționează în română",
          "blocks": [
            {
              "type": "paragraphs",
              "paragraphs": [
                "Sufixele se adaugă la sfârșitul unui substantiv sau al unui verb. Cele mai comune sufixe sunt -os, -esc, -ic și -tor. De asemenea, participiul unui verb poate funcționa direct ca adjectiv. Noul adjectiv se acordă în gen și număr cu substantivul."
              ]
            },
            {
              "type": "table",
              "html": "<table><thead><tr><th>Cuvânt de bază</th><th>Sufix</th><th>Adjectiv</th></tr></thead><tbody><tr><td><strong>prieten (substantiv)</strong></td><td><strong>-esc</strong></td><td><strong>prietenesc</strong></td></tr><tr><td><strong>noroc (substantiv)</strong></td><td><strong>-os</strong></td><td><strong>norocos</strong></td></tr><tr><td><strong>istorie (substantiv)</strong></td><td><strong>-ic</strong></td><td><strong>istoric</strong></td></tr><tr><td><strong>a munci (verb)</strong></td><td><strong>-tor</strong></td><td><strong>muncitor</strong></td></tr><tr><td><strong>a strica (verb)</strong></td><td><strong>-at</strong></td><td><strong>stricat</strong></td></tr></tbody></table>"
            }
          ]
        }
      ]
    }
  }
}
