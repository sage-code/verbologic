    "en": {
      "title": "Irregular comparison",
      "summary": "A few common adjectives have irregular comparatives and superlatives.",
      "status": "draft",
      "sections": [
        {
          "title": "What it is",
          "blocks": [
            {
              "type": "paragraphs",
              "paragraphs": [
                "A few very common adjectives and adverbs have irregular comparative and superlative forms."
              ]
            },
            {
              "type": "bullets",
              "items": [
                "good, **better**, **the best**",
                "bad, **worse**, **the worst**",
                "far, **farther**, **the farthest**"
              ]
            }
          ]
        },
        {
          "title": "How it works in English",
          "blocks": [
            {
              "type": "paragraphs",
              "paragraphs": [
                "These forms must be learned one by one. Much, many and little also change completely."
              ]
            },
            {
              "type": "table",
              "html": "<table><thead><tr><th>Adjective</th><th>Comparative</th><th>Superlative</th></tr></thead><tbody><tr><td><strong>good, well</strong></td><td><strong>better</strong></td><td><strong>best</strong></td></tr><tr><td><strong>bad</strong></td><td><strong>worse</strong></td><td><strong>worst</strong></td></tr><tr><td><strong>much, many</strong></td><td><strong>more</strong></td><td><strong>most</strong></td></tr><tr><td><strong>little</strong></td><td><strong>less</strong></td><td><strong>least</strong></td></tr></tbody></table>"
            }
          ]
        }
      ]
    }
  }
