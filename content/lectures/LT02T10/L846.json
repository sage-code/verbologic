  "entity_id": "LT02T10:L846",
  "order": 1,
  "minutes": 1,
  "terms": {
    "en": "The verb to have",
    "es": "El verbo tener",
    "it": "Il verbo avere",
    "fr": "Le verbe avoir",
    "de": "Das Verb haben",
    "ru": "Глагол «иметь»",
    "hu": "A „birtokolni” ige",
    "pt": "O verbo ter",
    "ro": "Verbul „a avea”"
  },
  "locales": {
    "en": {
      "title": "The verb to have",
      "summary": "Have shows possession and relationship, and it is also an auxiliary.",
      "status": "draft",
      "sections": [
        {
          "title": "What it is",
          "blocks": [
            {
              "type": "paragraphs",
              "paragraphs": [
                "Have shows possession, relationship and experience. It is also an auxiliary verb."
              ]
            },
            {
              "type": "bullets",
              "items": [
                "I **have** a sister.",
                "She **has** blue eyes.",
                "We **have** a meeting."
              ]
            }
          ]
        },
        {
          "title": "How it works in English",
          "blocks": [
            {
              "type": "paragraphs",
              "paragraphs": [
                "The present is have, but has for he, she and it. In British English have got is also common: I've got a car. For questions and negatives with the main verb, use do: Do you have time?"
              ]
            },
            {
              "type": "table",
              "html": "<table><thead><tr><th>Subject</th><th>Present</th><th>Negative</th></tr></thead><tbody><tr><td><strong>I, you, we, they</strong></td><td><strong>have</strong></td><td><strong>don't have</strong></td></tr><tr><td><strong>he, she, it</strong></td><td><strong>has</strong></td><td><strong>doesn't have</strong></td></tr><tr><td><strong>have got</strong></td><td><strong>I've got</strong></td><td><strong>I haven't got</strong></td></tr></tbody></table>"
            }
          ]
        }
      ]
    },
    "ro": {
      "title": "Verbul „a avea”",
      "summary": "Verbul „a avea” exprimă posesia și are forme diferite pentru fiecare persoană la timpul prezent.",
      "status": "draft",
      "sections": [
        {
          "title": "Ce este",
          "blocks": [
            {
              "type": "paragraphs",
              "paragraphs": [
                "Verbul „a avea” arată posesia sau o relație de familie. Folosim acest verb și pentru a spune vârsta. Pronumele personal nu este obligatoriu."
              ]
            },
            {
              "type": "bullets",
              "items": [
                "Eu **am** o soră.",
                "Ea **are** o mașină nouă.",
                "Noi **avem** mult timp liber."
              ]
            }
          ]
        },
        {
          "title": "Cum funcționează în română",
          "blocks": [
            {
              "type": "paragraphs",
              "paragraphs": [
                "Verbul „a avea” își schimbă forma pentru fiecare persoană. Pentru negație, punem cuvântul „nu” în fața verbului. Întrebarea se formează doar prin intonația vocii."
              ]
            },
            {
              "type": "table",
              "html": "<table><thead><tr><th>Persoană</th><th>Afirmativ</th><th>Negativ</th></tr></thead><tbody><tr><td><strong>eu</strong></td><td><strong>am</strong></td><td><strong>nu am</strong></td></tr><tr><td><strong>tu</strong></td><td><strong>ai</strong></td><td><strong>nu ai</strong></td></tr><tr><td><strong>el / ea</strong></td><td><strong>are</strong></td><td><strong>nu are</strong></td></tr><tr><td><strong>noi</strong></td><td><strong>avem</strong></td><td><strong>nu avem</strong></td></tr><tr><td><strong>voi</strong></td><td><strong>aveți</strong></td><td><strong>nu aveți</strong></td></tr><tr><td><strong>ei / ele</strong></td><td><strong>au</strong></td><td><strong>nu au</strong></td></tr></tbody></table>"
            }
          ]
        }
      ]
    }
  }
}
