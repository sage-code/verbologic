  "terms": {
    "en": "Actions in progress",
    "es": "Acciones en curso",
    "it": "Azioni in corso",
    "fr": "Actions en cours",
    "de": "Handlungen im Verlauf",
    "ru": "Действия в процессе",
    "hu": "Folyamatban lévő cselekvések",
    "pt": "Ações em andamento",
    "ro": "Acțiuni în desfășurare"
  },
  "locales": {
    "en": {
      "title": "Actions in progress",
      "summary": "The present continuous describes what is happening now.",
      "status": "draft",
      "sections": [
        {
          "title": "What it is",
          "blocks": [
            {
              "type": "paragraphs",
              "paragraphs": [
                "The present continuous describes an action that is happening now, or around now."
              ]
            },
            {
              "type": "bullets",
              "items": [
                "I **am reading** now.",
                "They **are playing** outside.",
                "It **is raining**."
              ]
            }
          ]
        },
        {
          "title": "How it works in English",
          "blocks": [
            {
              "type": "paragraphs",
              "paragraphs": [
                "Form it with be and the -ing form of the verb. Verbs of state, such as know, like and want, are not normally used in the continuous."
              ]
            },
            {
              "type": "table",
              "html": "<table><thead><tr><th>Form</th><th>Example</th></tr></thead><tbody><tr><td>affirmative</td><td><strong>She is working.</strong></td></tr><tr><td>negative</td><td><strong>She isn't working.</strong></td></tr><tr><td>question</td><td><strong>Is she working?</strong></td></tr></tbody></table>"
            }
          ]
        }
      ]
    },
    "ro": {
      "title": "Acțiuni în desfășurare",
      "summary": "Limba română nu are un timp continuu separat, ci folosește timpul prezent pentru acțiuni în desfășurare.",
      "status": "draft",
      "sections": [
        {
          "title": "Ce este",
          "blocks": [
            {
              "type": "paragraphs",
              "paragraphs": [
                "Unele acțiuni se întâmplă chiar acum, în acest moment. Limba română nu are o formă continuă specială pentru ele. Folosim timpul prezent pentru a exprima aceste acțiuni. Adesea adăugăm cuvântul „acum” pentru a clarifica momentul."
              ]
            },
            {
              "type": "bullets",
              "items": [
                "Eu **citesc** o carte acum.",
                "Copiii **se joacă** afară.",
                "Afară **plouă** în acest moment."
              ]
            }
          ]
        },
        {
          "title": "Cum funcționează în română",
          "blocks": [
            {
              "type": "paragraphs",
              "paragraphs": [
                "Folosești forma obișnuită a verbului la timpul prezent. Pronumele personal nu este obligatoriu în propoziție. Terminația verbului arată cine face acțiunea. Poți adăuga cuvântul „acum” pentru a sublinia momentul."
              ]
            },
            {
              "type": "table",
              "html": "<table><thead><tr><th>Persoană</th><th>Verb la prezent</th><th>Acțiune în desfășurare</th></tr></thead><tbody><tr><td><strong>Eu</strong></td><td><strong>citesc</strong></td><td><strong>Eu citesc acum.</strong></td></tr><tr><td><strong>Tu</strong></td><td><strong>lucrezi</strong></td><td><strong>Tu lucrezi acum.</strong></td></tr><tr><td><strong>El / Ea</strong></td><td><strong>scrie</strong></td><td><strong>Ea scrie un mesaj.</strong></td></tr><tr><td><strong>Noi</strong></td><td><strong>mâncăm</strong></td><td><strong>Noi mâncăm prânzul.</strong></td></tr><tr><td><strong>Voi</strong></td><td><strong>ascultați</strong></td><td><strong>Voi ascultați muzică.</strong></td></tr><tr><td><strong>Ei / Ele</strong></td><td><strong>aleargă</strong></td><td><strong>Ei aleargă în parc.</strong></td></tr></tbody></table>"
            }
          ]
        }
      ]
    }
  }
}
