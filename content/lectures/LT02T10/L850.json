  "locales": {
    "en": {
      "title": "Habits, facts and timetables",
      "summary": "The simple present also covers timetables and regular habits.",
      "status": "draft",
      "sections": [
        {
          "title": "What it is",
          "blocks": [
            {
              "type": "paragraphs",
              "paragraphs": [
                "The simple present is used for habits, general facts and fixed timetables."
              ]
            },
            {
              "type": "bullets",
              "items": [
                "I **get up** at seven.",
                "Water **boils** at 100 degrees.",
                "The train **leaves** at nine."
              ]
            }
          ]
        },
        {
          "title": "How it works in English",
          "blocks": [
            {
              "type": "paragraphs",
              "paragraphs": [
                "Adverbs of frequency, such as always, usually, often, sometimes and never, go with habits. The simple present is also used for scheduled events in the near future."
              ]
            },
            {
              "type": "table",
              "html": "<table><thead><tr><th>Use</th><th>Example</th></tr></thead><tbody><tr><td>habit</td><td><strong>She often walks to work.</strong></td></tr><tr><td>fact</td><td><strong>Cats eat meat.</strong></td></tr><tr><td>timetable</td><td><strong>The film starts at eight.</strong></td></tr></tbody></table>"
            }
          ]
        }
      ]
    }
  }
}
