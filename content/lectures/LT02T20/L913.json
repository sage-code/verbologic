    "en": {
      "title": "Basic word order",
      "summary": "English has a fixed basic order: subject, verb, object.",
      "status": "draft",
      "sections": [
        {
          "title": "What it is",
          "blocks": [
            {
              "type": "paragraphs",
              "paragraphs": [
                "English has a fixed basic word order: subject, verb, object."
              ]
            },
            {
              "type": "bullets",
              "items": [
                "**The cat** chased **the mouse**.",
                "**She** reads **books**.",
                "**We** saw **a film**."
              ]
            }
          ]
        },
        {
          "title": "How it works in English",
          "blocks": [
            {
              "type": "paragraphs",
              "paragraphs": [
                "Because English has almost no case endings, word order tells you who does what. Changing the order changes the meaning."
              ]
            },
            {
              "type": "table",
              "html": "<table><thead><tr><th>Order</th><th>Example</th></tr></thead><tbody><tr><td>subject, verb, object</td><td><strong>Tom loves Anna.</strong></td></tr><tr><td>swapped</td><td><strong>Anna loves Tom.</strong></td></tr><tr><td>with an adverbial</td><td><strong>Tom loves Anna very much.</strong></td></tr></tbody></table>"
            }
          ]
        }
      ]
    }
  }
}
