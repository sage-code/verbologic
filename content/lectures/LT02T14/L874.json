    "en": "Impersonal constructions",
    "es": "Construcciones impersonales",
    "it": "Costruzioni impersonali",
    "fr": "Constructions impersonnelles",
    "de": "Unpersönliche Konstruktionen",
    "ru": "Безличные конструкции",
    "hu": "Személytelen szerkezetek",
    "pt": "Construções impessoais",
