  "terms": {
    "en": "Adverbs of frequency",
    "es": "Adverbios de frecuencia",
    "it": "Avverbi di frequenza",
    "fr": "Adverbes de fréquence",
    "de": "Häufigkeitsadverbien",
    "ru": "Наречия частоты",
    "hu": "Gyakoriságot kifejező határozók",
    "pt": "Advérbios de frequência",
    "ro": "Adverbe de frecvență"
  },
  "locales": {
    "en": {
      "title": "Adverbs of frequency",
      "summary": "Adverbs of frequency tell how often something happens.",
      "status": "draft",
      "sections": [
        {
          "title": "What it is",
          "blocks": [
            {
              "type": "paragraphs",
              "paragraphs": [
                "Adverbs of frequency tell how often something happens: always, usually, often, sometimes, rarely, never."
              ]
            },
            {
              "type": "bullets",
              "items": [
                "I **always** drink tea.",
                "He **never** eats meat.",
                "We **sometimes** go out."
              ]
            }
          ]
        },
        {
          "title": "How it works in English",
          "blocks": [
            {
              "type": "paragraphs",
              "paragraphs": [
                "They go before the main verb but after be. Sometimes, usually and often can also begin a sentence. Never already means not ever, so do not add not."
              ]
            },
            {
              "type": "table",
              "html": "<table><thead><tr><th>Position</th><th>Example</th></tr></thead><tbody><tr><td>before the main verb</td><td><strong>She often walks.</strong></td></tr><tr><td>after be</td><td><strong>He is always late.</strong></td></tr><tr><td>with an auxiliary</td><td><strong>I have never been there.</strong></td></tr></tbody></table>"
            }
          ]
        }
      ]
    },
    "ro": {
      "title": "Adverbe de frecvență",
      "summary": "Adverbele de frecvență arată cât de des facem o acțiune în viața de zi cu zi.",
      "status": "draft",
      "sections": [
        {
          "title": "Ce este",
          "blocks": [
            {
              "type": "paragraphs",
              "paragraphs": [
                "Adverbele de frecvență arată cât de des facem o acțiune. Ele determină un verb. Exemple comune sunt: mereu, de obicei, uneori, rar și niciodată."
              ]
            },
            {
              "type": "bullets",
              "items": [
                "Eu beau **mereu** ceai dimineața.",
                "El nu mănâncă **niciodată** carne.",
                "Noi ieșim **uneori** în parc."
              ]
            }
          ]
        },
        {
          "title": "Cum funcționează în română",
          "blocks": [
            {
              "type": "paragraphs",
              "paragraphs": [
                "În limba română, aceste adverbe stau de obicei după verb. Ele pot sta și la începutul propoziției. Cuvântul „niciodată” cere mereu negația „nu” înainte de verb."
              ]
            },
            {
              "type": "table",
              "html": "<table><thead><tr><th>Adverb</th><th>Frecvență</th><th>Exemplu</th></tr></thead><tbody><tr><td><strong>mereu</strong></td><td><strong>100%</strong></td><td><strong>Citesc **mereu** seara.</strong></td></tr><tr><td><strong>de obicei</strong></td><td><strong>80%</strong></td><td><strong>**De obicei** mă trezesc devreme.</strong></td></tr><tr><td><strong>des</strong></td><td><strong>70%</strong></td><td><strong>Mergem **des** la teatru.</strong></td></tr><tr><td><strong>uneori</strong></td><td><strong>50%</strong></td><td><strong>**Uneori** gătesc paste.</strong></td></tr><tr><td><strong>rar</strong></td><td><strong>20%</strong></td><td><strong>El călătorește **rar** singur.</strong></td></tr><tr><td><strong>niciodată</strong></td><td><strong>0%</strong></td><td><strong>Nu întârzii **niciodată** la serviciu.</strong></td></tr></tbody></table>"
            }
          ]
        }
      ]
    }
  }
}
