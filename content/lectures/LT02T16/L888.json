  "terms": {
    "en": "Adverbs of degree",
    "es": "Adverbios de grado",
    "it": "Avverbi di grado",
    "fr": "Adverbes de degré",
    "de": "Gradadverbien",
    "ru": "Наречия меры и степени",
    "hu": "Fokhatározók",
    "pt": "Advérbios de grau",
    "ro": "Adverbe de grad"
  },
  "locales": {
    "en": {
      "title": "Adverbs of degree",
      "summary": "Adverbs of degree tell how much or how strongly.",
      "status": "draft",
      "sections": [
        {
          "title": "What it is",
          "blocks": [
            {
              "type": "paragraphs",
              "paragraphs": [
                "Adverbs of degree tell how much or how strongly: very, quite, too, enough, almost."
              ]
            },
            {
              "type": "bullets",
              "items": [
                "It is **very** cold.",
                "She is **quite** tall.",
                "He is **too** tired."
              ]
            }
          ]
        },
        {
          "title": "How it works in English",
          "blocks": [
            {
              "type": "paragraphs",
              "paragraphs": [
                "Put an adverb of degree before the adjective or adverb it modifies, except enough, which follows it. Too means more than is good, while very is only strong."
              ]
            },
            {
              "type": "table",
              "html": "<table><thead><tr><th>Adverb</th><th>Meaning</th><th>Example</th></tr></thead><tbody><tr><td><strong>very</strong></td><td>strong</td><td><strong>very easy</strong></td></tr><tr><td><strong>too</strong></td><td>more than needed</td><td><strong>too heavy</strong></td></tr><tr><td><strong>enough</strong></td><td>sufficient</td><td><strong>old enough</strong></td></tr></tbody></table>"
            }
          ]
        }
      ]
    },
    "ro": {
      "title": "Adverbe de grad",
      "summary": "Adverbele de grad arată măsura sau intensitatea și stau de obicei înaintea cuvântului pe care îl determină.",
      "status": "draft",
      "sections": [
        {
          "title": "Ce este",
          "blocks": [
            {
              "type": "paragraphs",
              "paragraphs": [
                "Adverbele de grad arată cât de mult se întâmplă ceva. Ele descriu intensitatea unei acțiuni sau a unei însușiri. Cele mai folosite sunt: foarte, prea, destul de și aproape."
              ]
            },
            {
              "type": "bullets",
              "items": [
                "Afară este **foarte** frig.",
                "Ea este **destul de** înaltă.",
                "El este **prea** obosit."
              ]
            }
          ]
        },
        {
          "title": "Cum funcționează în română",
          "blocks": [
            {
              "type": "paragraphs",
              "paragraphs": [
                "Adverbul de grad stă de obicei înaintea cuvântului pe care îl descrie. Aceste adverbe nu își schimbă forma după gen sau număr. Forma lor rămâne mereu la fel."
              ]
            },
            {
              "type": "table",
              "html": "<table><thead><tr><th>Adverb de grad</th><th>Sens</th><th>Exemplu</th></tr></thead><tbody><tr><td><strong>foarte</strong></td><td><strong>mult sau intens</strong></td><td><strong>Ești **foarte** bun.</strong></td></tr><tr><td><strong>prea</strong></td><td><strong>excesiv de mult</strong></td><td><strong>Supa este **prea** caldă.</strong></td></tr><tr><td><strong>destul de</strong></td><td><strong>suficient de mult</strong></td><td><strong>Filmul este **destul de** lung.</strong></td></tr><tr><td><strong>aproape</strong></td><td><strong>nu chiar complet</strong></td><td><strong>Sunt **aproape** gata.</strong></td></tr><tr><td><strong>puțin</strong></td><td><strong>în cantitate mică</strong></td><td><strong>Sunt **puțin** ocupat.</strong></td></tr></tbody></table>"
            }
          ]
        }
      ]
    }
  }
}
