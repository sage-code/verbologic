  "terms": {
    "en": "Adverbs of manner",
    "es": "Adverbios de modo",
    "it": "Avverbi di modo",
    "fr": "Adverbes de manière",
    "de": "Adverbien der Art und Weise",
    "ru": "Наречия образа действия",
    "hu": "Módhatározók",
    "pt": "Advérbios de modo",
    "ro": "Adverbe de mod"
  },
  "locales": {
    "en": {
      "title": "Adverbs of manner",
      "summary": "Adverbs of manner tell how an action is done.",
      "status": "draft",
      "sections": [
        {
          "title": "What it is",
          "blocks": [
            {
              "type": "paragraphs",
              "paragraphs": [
                "Adverbs of manner tell how an action is done."
              ]
            },
            {
              "type": "bullets",
              "items": [
                "She sings **beautifully**.",
                "He drives **carefully**.",
                "They worked **hard**."
              ]
            }
          ]
        },
        {
          "title": "How it works in English",
          "blocks": [
            {
              "type": "paragraphs",
              "paragraphs": [
                "Many adverbs of manner are made by adding -ly to an adjective. Some have the same form as the adjective, such as fast and hard, and the adverb of good is well."
              ]
            },
            {
              "type": "table",
              "html": "<table><thead><tr><th>Adjective</th><th>Adverb</th></tr></thead><tbody><tr><td><strong>quick</strong></td><td><strong>quickly</strong></td></tr><tr><td><strong>happy</strong></td><td><strong>happily</strong></td></tr><tr><td><strong>fast</strong></td><td><strong>fast</strong></td></tr><tr><td><strong>good</strong></td><td><strong>well</strong></td></tr></tbody></table>"
            }
          ]
        }
      ]
    },
    "ro": {
      "title": "Adverbe de mod",
      "summary": "Adverbele de mod arată cum se face o acțiune și au adesea aceeași formă ca adjectivele masculine la singular.",
      "status": "draft",
      "sections": [
        {
          "title": "Ce este",
          "blocks": [
            {
              "type": "paragraphs",
              "paragraphs": [
                "Adverbul de mod arată cum se petrece o acțiune. Acest cuvânt răspunde la întrebarea „cum?”. Adverbul determină de obicei un verb și nu își schimbă forma după gen sau număr."
              ]
            },
            {
              "type": "bullets",
              "items": [
                "Ea cântă **frumos**.",
                "El conduce **atent**.",
                "Copiii aleargă **repede**."
              ]
            }
          ]
        },
        {
          "title": "Cum funcționează în română",
          "blocks": [
            {
              "type": "paragraphs",
              "paragraphs": [
                "În limba română, multe adverbe de mod au aceeași formă cu adjectivul la masculin singular. De exemplu, spunem „băiat frumos” și „el cântă frumos”. Există și adverbe cu formă proprie, cum este „bine” pentru adjectivul „bun”. Spre deosebire de adjectiv, adverbul nu se acordă cu substantivul."
              ]
            },
            {
              "type": "table",
              "html": "<table><thead><tr><th>Adjectiv (masculin)</th><th>Adverb de mod</th><th>Exemplu</th></tr></thead><tbody><tr><td><strong>frumos</strong></td><td><strong>frumos</strong></td><td><strong>Ea scrie frumos.</strong></td></tr><tr><td><strong>rapid</strong></td><td><strong>rapid</strong></td><td><strong>Trenul merge rapid.</strong></td></tr><tr><td><strong>ușor</strong></td><td><strong>ușor</strong></td><td><strong>Vântul bate ușor.</strong></td></tr><tr><td><strong>clar</strong></td><td><strong>clar</strong></td><td><strong>Profesorul explică clar.</strong></td></tr><tr><td><strong>bun</strong></td><td><strong>bine</strong></td><td><strong>Tu vorbești bine.</strong></td></tr></tbody></table>"
            }
          ]
        }
      ]
    }
  }
}
