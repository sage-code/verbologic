  "terms": {
    "en": "Adverbs of place",
    "es": "Adverbios de lugar",
    "it": "Avverbi di luogo",
    "fr": "Adverbes de lieu",
    "de": "Ortsadverbien",
    "ru": "Наречия места",
    "hu": "Helyhatározók",
    "pt": "Advérbios de lugar",
    "ro": "Adverbe de loc"
  },
  "locales": {
    "en": {
      "title": "Adverbs of place",
      "summary": "Adverbs of place tell where something happens.",
      "status": "draft",
      "sections": [
        {
          "title": "What it is",
          "blocks": [
            {
              "type": "paragraphs",
              "paragraphs": [
                "Adverbs of place tell where something happens: here, there, upstairs, nearby."
              ]
            },
            {
              "type": "bullets",
              "items": [
                "Come **here**.",
                "The children are **upstairs**.",
                "I looked **everywhere**."
              ]
            }
          ]
        },
        {
          "title": "How it works in English",
          "blocks": [
            {
              "type": "paragraphs",
              "paragraphs": [
                "Adverbs of place usually follow the verb or its object. Here and there often begin a sentence for emphasis: Here comes the bus."
              ]
            },
            {
              "type": "table",
              "html": "<table><thead><tr><th>Adverb</th><th>Example</th></tr></thead><tbody><tr><td><strong>here, there</strong></td><td><strong>Put it here.</strong></td></tr><tr><td><strong>inside, outside</strong></td><td><strong>Wait outside.</strong></td></tr><tr><td><strong>somewhere, nowhere</strong></td><td><strong>It must be somewhere.</strong></td></tr></tbody></table>"
            }
          ]
        }
      ]
    },
    "ro": {
      "title": "Adverbe de loc",
      "summary": "Adverbele de loc arată unde se petrece o acțiune și răspund la întrebarea „unde?”.",
      "status": "draft",
      "sections": [
        {
          "title": "Ce este",
          "blocks": [
            {
              "type": "paragraphs",
              "paragraphs": [
                "Adverbele de loc arată unde se întâmplă o acțiune. Ele răspund la întrebarea „unde?”. Folosim aceste cuvinte foarte des în conversațiile zilnice."
              ]
            },
            {
              "type": "bullets",
              "items": [
                "Vino **aici**, te rog!",
                "Copiii se joacă **afară**.",
                "Am căutat cheia **pretutindeni**."
              ]
            }
          ]
        },
        {
          "title": "Cum funcționează în română",
          "blocks": [
            {
              "type": "paragraphs",
              "paragraphs": [
                "În limba română, adverbul de loc stă de obicei după verb. Uneori îl putem pune la începutul propoziției pentru accentuare. Forma adverbului nu se schimbă niciodată."
              ]
            },
            {
              "type": "table",
              "html": "<table><thead><tr><th>Adverb</th><th>Exemplu</th></tr></thead><tbody><tr><td><strong>aici</strong></td><td><strong>Trenul oprește **aici**.</strong></td></tr><tr><td><strong>acolo</strong></td><td><strong>Prietenul meu locuiește **acolo**.</strong></td></tr><tr><td><strong>aproape</strong></td><td><strong>Școala este **aproape**.</strong></td></tr><tr><td><strong>departe</strong></td><td><strong>Noi mergem **departe**.</strong></td></tr><tr><td><strong>sus</strong></td><td><strong>Cartea se află **sus**.</strong></td></tr></tbody></table>"
            }
          ]
        }
      ]
    }
  }
}
